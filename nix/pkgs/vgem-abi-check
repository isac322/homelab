#!/usr/bin/env bash
# shellcheck disable=SC2154 # series/own_module come from the sourced conf
# vgem-abi-check <kernelver>
#
# Invoked by dkms.conf's MAKE[0] right after `make modules`. The script lives
# in the DKMS source/build directory (usr/src/vgem-<version>), which after the
# build also contains the built vgem.ko. vgem ships no private subsystem
# headers, so the only ABI it can break is the public DRM API the kernel
# exports: the check fails the DKMS build unless every undefined symbol of the
# built module resolves in the target kernel's Module.symvers, with matching
# genksyms CRCs when the kernel was built with CONFIG_MODVERSIONS.
set -euo pipefail

fail() {
  printf 'vgem-abi-check: %s\n' "$1" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "usage: vgem-abi-check <kernelver>"
kernel=$1

# All inputs live next to this script, regardless of how DKMS invoked it.
cd "$(dirname "$0")"

conf=./vgem-abi-check.conf
[ -f "$conf" ] || fail "vgem-abi-check.conf is missing next to $0"
# shellcheck source=/dev/null # generated by nix/pkgs/vgem-dkms.nix
. "$conf"
for var in series own_module; do
  if [ -z "${!var:-}" ]; then
    fail "vgem-abi-check.conf does not set '$var'"
  fi
done

# (a) This package only tracks one upstream stable series; a kernel from a
# different series needs a newly selected package.
if [[ $kernel != "$series".* ]]; then
  fail "kernel $kernel is not a $series.x kernel; run 'nix run .#vgem-dkms -- select <host>' to re-pin this node"
fi

kbuild=/lib/modules/$kernel/build
[ -d "$kbuild" ] || fail "kernel build tree $kbuild does not exist (are the headers for $kernel installed?)"

# (b) vgem needs the DRM core. BUILD_EXCLUSIVE_CONFIG already skips kernels
# without it; reaching this point means the module compiled, so only an
# unreadable .config can leave this unset.
if [ -f "$kbuild/.config" ]; then
  if ! grep -q '^CONFIG_DRM=[ym]' "$kbuild/.config"; then
    fail "kernel $kernel lacks CONFIG_DRM; vgem cannot work there"
  fi
  # A kernel that already provides vgem must not be shadowed: the in-tree
  # module wins over updates/dkms ordering ambiguity, so fail instead of
  # installing a second copy.
  if grep -q '^CONFIG_DRM_VGEM=[ym]' "$kbuild/.config"; then
    fail "kernel $kernel already sets CONFIG_DRM_VGEM; this package is obsolete there"
  fi
fi

module=$own_module.ko
[ -f "$module" ] || fail "expected built module $module is missing"

imports=$(
  nm -u "$module" || fail "nm -u $module failed"
)
imports=$(printf '%s\n' "$imports" | awk '{print $NF}' | sort -u)
[ -n "$imports" ] || fail "nm -u $module reported no imported symbols"

symvers=$kbuild/Module.symvers
[ -f "$symvers" ] || fail "$symvers is missing; cannot prove imports resolve on kernel $kernel"

modprobe=
for cand in /usr/sbin/modprobe /sbin/modprobe modprobe; do
  if command -v "$cand" > /dev/null 2>&1; then
    modprobe=$cand
    break
  fi
done

checked="exported-symbol names"
if grep -q '^CONFIG_MODVERSIONS=y' "$kbuild/.config" 2>/dev/null; then
  # (c) CRC path: modprobe --dump-modversions prints the CRC the built module
  # recorded for every imported symbol; compare each with the kernel's
  # Module.symvers. A mismatch means the shipped source disagrees with the
  # kernel about a signature the module calls, so the load would fail anyway.
  [ -n "$modprobe" ] || fail "kernel $kernel uses CONFIG_MODVERSIONS but modprobe is not in PATH"
  ours=$($modprobe --dump-modversions "$module") ||
    fail "modprobe --dump-modversions $module failed"
  missing=
  unexported=
  mismatched=
  for sym in $imports; do
    our_crc=$(printf '%s\n' "$ours" | awk -v s="$sym" '{for (i=1;i<=NF;i++) if ($i==s) {for (j=1;j<=NF;j++) if ($j ~ /^0x/) print $j; break}}' | head -n1)
    kcrc=$(awk -v s="$sym" '$2 == s {print $1; exit}' "$symvers")
    prov=$(awk -v s="$sym" '$2 == s {print $(NF-1); exit}' "$symvers")
    if [ -z "$our_crc" ]; then
      missing="$missing $sym"
      continue
    fi
    if [ -z "$kcrc" ]; then
      unexported="$unexported $sym"
      continue
    fi
    if [ "$our_crc" != "$kcrc" ]; then
      mismatched="$mismatched
    $sym (module ${our_crc} vs kernel ${kcrc}, provided by ${prov:-?})"
    fi
  done
  [ -z "$missing" ] || fail "no modversions CRC recorded for import(s):$missing"
  [ -z "$unexported" ] || fail "kernel $kernel does not export imported symbol(s):$unexported"
  [ -z "$mismatched" ] || fail "ABI mismatch for kernel $kernel; differing symbol CRCs:$mismatched"
  checked="Module.symvers CRCs"
else
  # (d) Membership path: without MODVERSIONS the kernel records no CRCs, so the
  # only remaining check is that every import is actually exported.
  unexported=
  for sym in $imports; do
    awk -v s="$sym" '$2 == s {found=1; exit} END {exit !found}' "$symvers" ||
      unexported="$unexported $sym"
  done
  [ -z "$unexported" ] || fail "kernel $kernel does not export imported symbol(s):$unexported"
fi

printf 'vgem-abi-check: ok for kernel %s (%s)\n' "$kernel" "$checked"
