#!/usr/bin/env bash
# shellcheck disable=SC2154 # series/modules/own_sources come from the sourced conf
# nvme-tcp-abi-check <kernelver>
#
# Invoked by dkms.conf's MAKE[0] right after `make modules`. The script lives
# in the DKMS source/build directory (usr/src/<name>-<version>), which after
# the build also contains the built <module>.ko and *.o files. It verifies
# that the private NVMe headers shipped in this package describe the same ABI
# the target kernel was built with; any check that cannot prove that exits 1
# and fails the DKMS build.
#
# Two proofs are tried in order:
#   1. MODVERSIONS: rebuild every tree source that EXPORT_SYMBOLs one of our
#      imports and compare the CRC genksyms records as #SYMVER lines in the
#      emitted .<file>.o.cmd with the kernel's Module.symvers CRC.
#   2. BTF: encode our objects' DWARF into BTF (pahole -J) and compare every
#      private struct/union/enum declared in the tree's headers against the
#      kernel's vmlinux BTF.
# Imports defined nowhere in the tree are public kernel API: both sides see
# the same public headers by construction, so they need no check.
set -euo pipefail

fail() {
  printf 'nvme-tcp-abi-check: %s\n' "$1" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "usage: nvme-tcp-abi-check <kernelver>"
kernel=$1

# All inputs live next to this script, regardless of how DKMS invoked it.
cd "$(dirname "$0")"

conf=./nvme-tcp-abi-check.conf
[ -f "$conf" ] || fail "nvme-tcp-abi-check.conf is missing next to $0"
# shellcheck source=/dev/null # generated by nix/pkgs/nvme-tcp-dkms.nix
. "$conf"
for var in series modules own_sources; do
  if [ -z "${!var:-}" ]; then
    fail "nvme-tcp-abi-check.conf does not set '$var'"
  fi
done

# (a) This package only tracks one upstream stable series; a kernel from a
# different series needs a newly selected package.
if [[ $kernel != "$series".* ]]; then
  fail "kernel $kernel is not a $series.x kernel; run 'nix run .#nvme-tcp-dkms -- select <host>' to re-pin this node"
fi

kbuild=/lib/modules/$kernel/build
[ -d "$kbuild" ] || fail "kernel build tree $kbuild does not exist (are the headers for $kernel installed?)"

# (b) Which proofs the kernel configuration supports.
modversions=
debug_btf=
if [ -f "$kbuild/.config" ]; then
  if grep -q '^CONFIG_MODVERSIONS=y' "$kbuild/.config"; then modversions=1; fi
  if grep -q '^CONFIG_DEBUG_INFO_BTF=y' "$kbuild/.config"; then debug_btf=1; fi
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/nvme-abi.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

# (c) Symbols the built modules import that a tree source other than our own
# transport files re-exports: those are the private NVMe core functions whose
# ABI our headers must match. providers maps symbol -> defining tree file.
imports=$(
  for module in $modules; do
    [ -f "$module.ko" ] || fail "expected built module $module.ko is missing"
    nm -u "$module.ko" || fail "nm -u $module.ko failed"
  done | awk '{print $NF}' | sort -u
)

providers=$scratch/providers
: > "$providers"
relevant=
for sym in $imports; do
  deffile=
  for cand in $(grep -lE 'EXPORT_SYMBOL(_GPL|_NS|_NS_GPL)?\('"$sym"'[,)]' -- *.c 2>/dev/null || true); do
    [ -e "$cand" ] || continue
    case " $own_sources " in
      *" $cand "*) ;; # provided by our own transport source
      *)
        deffile=$cand
        break
        ;;
    esac
  done
  if [ -n "$deffile" ]; then
    relevant="$relevant $sym"
    printf '%s %s\n' "$sym" "$deffile" >> "$providers"
  fi
done

# extract_enum: render `NAME = VALUE,` enumerator lines as `NAME VALUE` pairs.
extract_enum() {
  awk '{
    line = $0
    sub(/^[[:space:]]+/, "", line)
    if (line !~ /^[A-Za-z0-9_]+[[:space:]]*=[[:space:]]*-?[0-9]+,$/) next
    split(line, a, "=")
    name = a[1]; gsub(/[[:space:]]/, "", name)
    val = a[2]; gsub(/[[:space:],]/, "", val)
    print name, val
  }'
}

shared=
checked=
if [ -n "$modversions" ] && [ -f "$kbuild/Module.symvers" ]; then
  # (d) CRC path: genksyms writes the CRC it computes for a compiled file's
  # symbols into that file's .<file>.o.cmd as `#SYMVER <sym> <crc>` lines.
  # Rebuild each provider against our headers and compare with Module.symvers.
  if [ -n "$relevant" ]; then
    defining=$(awk '{print $2}' "$providers" | sort -u)
    cp -- *.c "$scratch/" 2>/dev/null || true
    for hdr in *.h; do
      if [ -e "$hdr" ]; then cp -- "$hdr" "$scratch/"; fi
    done
    {
      printf 'obj-m += nvmeabiprobe.o\n'
      printf 'nvmeabiprobe-y :='
      for f in $defining; do printf ' %s' "${f%.c}.o"; done
      printf '\n'
      # shellcheck disable=SC2016 # $(src) is a make variable
      printf 'ccflags-y += -I$(src)\n'
    } > "$scratch/Makefile"
    for f in $defining; do
      if ! make -s -C "$kbuild" M="$scratch" "${f%.c}.o" > "$scratch/make.log" 2>&1; then
        printf 'nvme-tcp-abi-check: probe build of %s against kernel %s failed:\n' "$f" "$kernel" >&2
        tail -n 15 "$scratch/make.log" >&2
        exit 1
      fi
    done
    symvers=$scratch/symvers
    : > "$symvers"
    for f in $defining; do
      cmdfile=$scratch/.${f%.c}.o.cmd
      [ -f "$cmdfile" ] || fail "probe build emitted no $cmdfile"
      awk '$1 ~ /^#SYMVER/ {print $(NF-1), $NF}' "$cmdfile" >> "$symvers"
    done
    missing=
    unexported=
    mismatched=
    for sym in $relevant; do
      ours=$(awk -v s="$sym" '$1 == s {print $2; exit}' "$symvers")
      kcrc=$(awk -v s="$sym" '$2 == s {print $1; exit}' "$kbuild/Module.symvers")
      if [ -z "$ours" ]; then
        missing="$missing $sym"
        continue
      fi
      if [ -z "$kcrc" ]; then
        unexported="$unexported $sym"
        continue
      fi
      if [ "$ours" != "$kcrc" ]; then
        prov=$(awk -v s="$sym" '$2 == s {print $(NF-1); exit}' "$kbuild/Module.symvers")
        mismatched="$mismatched
    $sym (headers ${ours} vs kernel ${kcrc}, provided by ${prov:-?})"
      fi
    done
    [ -z "$missing" ] || fail "no genksyms CRC recorded for tree-exported import(s):$missing"
    [ -z "$unexported" ] || fail "kernel $kernel does not export imported symbol(s):$unexported"
    [ -z "$mismatched" ] || fail "NVMe ABI mismatch for kernel $kernel; differing symbol CRCs:$mismatched"
  fi
  checked="Module.symvers CRCs"
elif [ -n "$debug_btf" ] && [ -f "$kbuild/vmlinux" ] && command -v pahole > /dev/null 2>&1; then
  # (e) BTF path. Every relevant import must be provided by vmlinux itself: a
  # loadable-module provider's types are not in vmlinux BTF and cannot be
  # verified this way.
  nonvmlinux=
  for sym in $relevant; do
    prov=
    if [ -f "$kbuild/Module.symvers" ]; then
      prov=$(awk -v s="$sym" '$2 == s {print $(NF-1); exit}' "$kbuild/Module.symvers")
    fi
    if [ "$prov" != vmlinux ]; then
      nonvmlinux="$nonvmlinux $sym(${prov:-not-exported})"
    fi
  done
  [ -z "$nonvmlinux" ] ||
    fail "cannot verify against vmlinux BTF: import(s) provided by loadable modules, whose types are not in vmlinux:$nonvmlinux"

  # Type names private to the NVMe subsystem declared in the tree's headers.
  private_types=$(
    grep -hoE '^(struct|union|enum) [A-Za-z0-9_]+ \{' -- *.h 2>/dev/null |
      awk '{print $2}' | sort -u || true
  )

  # Encode our own objects' DWARF into BTF; DWARF-rendered and BTF-rendered
  # pahole output are not comparable, so both sides must come from BTF.
  own_objs=$(for src in $own_sources; do printf '%s.o\n' "${src%.c}"; done | sort -u)
  for obj in $own_objs; do
    [ -f "$obj" ] || fail "expected built object $obj is missing"
    cp -- "$obj" "$scratch/"
    pahole -J "$scratch/$obj" > /dev/null 2>&1 ||
      fail "pahole -J failed on $obj (cannot encode BTF from its DWARF)"
  done

  bad=
  for name in $private_types; do
    kbtf=$scratch/kernel.btf
    obtf=$scratch/ours.btf
    pahole -F btf -C "$name" "$kbuild/vmlinux" > "$kbtf" 2>/dev/null || true
    [ -s "$kbtf" ] || continue # type not present in the kernel image
    : > "$obtf"
    for obj in $own_objs; do
      if pahole -F btf -C "$name" "$scratch/$obj" > "$obtf" 2>/dev/null && [ -s "$obtf" ]; then
        break # union over our objects: first non-empty wins
      fi
    done
    [ -s "$obtf" ] || continue # our objects do not use this type
    shared=1
    first=$(head -n 1 "$obtf")
    if [[ $first == enum\ * ]]; then
      # Our enumerators must all exist with equal values; the kernel may add
      # enumerators we do not declare.
      kern_enum=$(extract_enum < "$kbtf")
      ebad=
      while read -r ename evalue; do
        [ -n "$ename" ] || continue
        kval=$(printf '%s\n' "$kern_enum" | awk -v n="$ename" '$1 == n {print $2; exit}')
        if [ "$kval" != "$evalue" ]; then
          ebad="$ebad ${ename}=${evalue} (kernel: ${kval:-missing})"
        fi
      done <<< "$(extract_enum < "$obtf")"
      if [ -n "$ebad" ]; then
        bad="$bad
    enum $name:$ebad"
      fi
    elif ! cmp -s "$obtf" "$kbtf"; then
      bad="$bad
    $name:
$(diff -u --label "ours ($name)" --label "kernel $kernel" "$obtf" "$kbtf" | head -n 14 || true)"
    fi
  done
  if [ -n "$bad" ]; then
    printf 'nvme-tcp-abi-check: NVMe ABI mismatch for kernel %s; private type(s) differ:%s\n' "$kernel" "$bad" >&2
    exit 1
  fi
  checked="vmlinux BTF types"
else
  # (f) No way to prove the ABI: fail the build loudly.
  reason=
  if [ -z "$modversions" ]; then
    reason="CONFIG_MODVERSIONS is not set"
  elif [ ! -f "$kbuild/Module.symvers" ]; then
    reason="$kbuild/Module.symvers is missing"
  fi
  if [ -z "$debug_btf" ]; then
    reason="${reason:+$reason; }CONFIG_DEBUG_INFO_BTF is not set"
  elif [ ! -f "$kbuild/vmlinux" ]; then
    reason="${reason:+$reason; }$kbuild/vmlinux is missing"
  elif ! command -v pahole > /dev/null 2>&1; then
    reason="${reason:+$reason; }pahole is not installed"
  fi
  fail "cannot prove the NVMe ABI for kernel $kernel: $reason"
fi

# (g)
if [ -z "$relevant" ] && [ -z "$shared" ]; then
  printf 'nvme-tcp-abi-check: ok for kernel %s (%s): nothing tree-shared found; all imports are public kernel API\n' "$kernel" "$checked"
else
  printf 'nvme-tcp-abi-check: ok for kernel %s (%s)\n' "$kernel" "$checked"
fi
