#!/usr/bin/env bash
# Select and install one node's vgem DKMS package.
#
#   select <host> [--baseline <upstream-version>]
#     Test-build the newest release in the node's kernel stable series,
#     newest first, against the node's real kernel headers and
#     Module.symvers in a scratch directory, applying the same
#     platform-device patch the package applies when the source registers
#     on the faux bus, and record the first release that compiles and links
#     in nix/lib/vgem-dkms.json. Nothing is installed. Commit the resulting
#     declaration.
#   install <host>
#     Build the declared package with Nix and install it with the node's
#     package manager. The node must run a kernel of the declared stable
#     series, not necessarily the exact release `select` validated against:
#     DKMS builds for every headers-installed kernel of the series and the
#     in-package ABI check rejects kernels whose DRM exports differ or which
#     already provide vgem. The module is loaded by
#     /etc/modules-load.d/vgem.conf on the next boot or by an explicit
#     modprobe.
set -euo pipefail
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
declarations="$root/nix/lib/vgem-dkms.json"
patch_file="$root/nix/pkgs/vgem-platform-device.patch"
cache=${XDG_CACHE_HOME:-$HOME/.cache}/homelab/vgem-dkms
stable_git=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
vgem_dir=drivers/gpu/drm/vgem

usage() {
  cat >&2 <<'EOF'
Usage: vgem-dkms select <host> [--baseline <upstream-version>]
       vgem-dkms install <host>
EOF
  exit 2
}

nix_cmd() { nix --extra-experimental-features 'nix-command flakes' "$@"; }
host_field() { nix_cmd eval --raw "$root#topology.nodes.$1.$2"; }
remote() {
  local host=$1
  shift
  ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$(host_field "$host" sshTarget)" "$@"
}

# Retries cover git.kernel.org's transient 5xx responses.
fetch() {
  local url=$1 destination=$2 attempt status
  for attempt in 1 2 3 4 5 6 7 8; do
    status=$(curl --silent --show-error --location --connect-timeout 15 \
      -o "$destination" -w '%{http_code}' "$url" || echo 000)
    case "$status" in
      200) return 0 ;;
      404) return 1 ;;
    esac
    sleep $((attempt * 5))
  done
  echo "fetching $url failed with HTTP $status" >&2
  return 1
}

tarball_name() { printf 'linux-%s.tar.xz\n' "$1"; }
sri() { nix_cmd hash convert --hash-algo sha256 --to sri "$1"; }

# Reproduce the package's source preparation on a scratch tree so the remote
# test-build compiles exactly what the DKMS package ships.
prepare_tree() {
  local tree=$1
  rm -f "$tree/Makefile" "$tree/Kconfig"
  if grep -q 'faux_device_create' "$tree/vgem_drv.c"; then
    patch -d "$tree" -p1 --no-backup-if-mismatch < "$patch_file" >/dev/null || {
      echo "platform-device patch does not apply to this vgem_drv.c" >&2
      return 1
    }
    ! grep -q 'faux_device' "$tree/vgem_drv.c" || {
      echo "platform-device patch left faux_device references" >&2
      return 1
    }
  fi
}

select_source() {
  local host=$1 baseline=${2:-} files kernel headers series major sums work
  local baseline_hex candidate log file selected='' rejected=()
  mapfile -t files < <(nix_cmd eval --json "$root#vgemDkms.sourceFiles" | jq -r '.[]')
  kernel=$(remote "$host" 'uname -r')
  # The package depends on the exact vendor headers package it was selected against.
  # shellcheck disable=SC2016 # expanded on the node
  headers=$(remote "$host" '
    makefile=$(readlink -f "/lib/modules/$(uname -r)/build")/Makefile
    if command -v pacman >/dev/null; then pacman -Qqo "$makefile"; else dpkg -S "$makefile" | cut -d: -f1; fi
  ')
  [[ "$headers" =~ ^[A-Za-z0-9.+_-]+$ ]] || {
    echo "$host kernel headers are not owned by a single package: $headers" >&2
    return 1
  }
  if [[ -z "$baseline" ]]; then
    baseline=$(grep -oE '^[0-9]+\.[0-9]+(\.[0-9]+)?' <<< "$kernel" || true)
  fi
  baseline=${baseline%.0}
  [[ "$baseline" =~ ^([0-9]+)\.([0-9]+)(\.([0-9]+))?$ ]] || {
    echo "cannot derive an upstream release from $kernel; pass --baseline" >&2
    return 1
  }
  major=${BASH_REMATCH[1]}
  series="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
  local baseline_sublevel=${BASH_REMATCH[4]:-0}

  mkdir -p "$cache"
  sums="$cache/v${major}.x-sha256sums.asc"
  fetch "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/sha256sums.asc" "$sums"
  sum_of() { awk -v name="$(tarball_name "$1")" '$2 == name { print $1 }' "$sums"; }
  baseline_hex=$(sum_of "$baseline")
  [[ -n "$baseline_hex" ]] || {
    echo "linux-$baseline is not a released kernel.org tarball" >&2
    return 1
  }

  archive="$cache/$(tarball_name "$baseline")"
  if ! printf '%s  %s\n' "$baseline_hex" "$archive" | sha256sum --check --status 2>/dev/null; then
    fetch "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/$(tarball_name "$baseline")" "$archive"
    printf '%s  %s\n' "$baseline_hex" "$archive" | sha256sum --check --status
  fi

  work=$(mktemp -d "${TMPDIR:-/tmp}/vgem-select.XXXXXX")
  trap 'rm -rf "$work"' RETURN
  mkdir -p "$work/baseline"
  tar -xJf "$archive" --strip-components=5 -C "$work/baseline" \
    "linux-${baseline}/${vgem_dir}"
  {
    printf 'obj-m += vgem.o\n'
    printf 'vgem-y := vgem_drv.o vgem_fence.o\n'
    # shellcheck disable=SC2016 # $(src) is a make variable
    printf 'ccflags-y += -I$(src)\n'
  } > "$work/Makefile"

  # Newer releases of the same series, newest first, then the baseline itself.
  mapfile -t candidates < <(
    awk -v series="$series" -v floor="$baseline_sublevel" '
      match($2, /^linux-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.xz$/) {
        version = substr($2, 7, length($2) - 13)
        n = split(version, part, ".")
        if (part[1] "." part[2] != series) next
        sublevel = n == 3 ? part[3] : 0
        if (sublevel + 0 > floor + 0) print sublevel "\t" version
      }' "$sums" | sort -rn -k1,1 | cut -f2
  )
  candidates+=("$baseline")

  for candidate in "${candidates[@]}"; do
    rm -rf "$work/tree"
    cp -R "$work/baseline" "$work/tree"
    if [[ "$candidate" != "$baseline" ]]; then
      for file in "${files[@]}"; do
        fetch "$stable_git/plain/${vgem_dir}/${file}?h=v${candidate}" "$work/tree/$file" || {
          echo "v$candidate has no ${vgem_dir}/${file}" >&2
          continue 2
        }
      done
    fi
    prepare_tree "$work/tree" || {
      rejected+=("v$candidate: source preparation failed")
      continue
    }
    cp "$work/Makefile" "$work/tree/Makefile"
    log="$work/build.log"
    # shellcheck disable=SC2016 # expanded on the node
    if tar -C "$work/tree" -cf - . | remote "$host" '
      set -e
      d=$(mktemp -d /var/tmp/vgem-select.XXXXXX)
      trap "rm -rf \"$d\"" EXIT
      tar -xf - -C "$d"
      make -s -C "/lib/modules/$(uname -r)/build" M="$d" modules 2>&1
    ' > "$log" 2>&1; then
      selected=$candidate
      break
    fi
    rejected+=("v$candidate: $(grep -m1 -E 'error|ERROR' "$log" || tail -n1 "$log")")
  done
  [[ -n "$selected" ]] || {
    printf '%s\n' "${rejected[@]}" >&2
    echo "even the baseline linux-$baseline vgem does not build on $host" >&2
    return 1
  }

  local selected_hex
  selected_hex=$(sum_of "$selected")
  [[ -n "$selected_hex" ]] || {
    echo "v$selected built but has no kernel.org tarball release; keep the baseline" >&2
    return 1
  }
  jq --arg host "$host" --arg kernel "$kernel" --arg headers "$headers" \
    --arg version "$selected" --arg hash "$(sri "$selected_hex")" \
    '.[$host] += {
      kernelRelease: $kernel,
      headersPackage: $headers,
      source: {version: $version, hash: $hash}
    }' "$declarations" > "$work/declarations.json"
  mv "$work/declarations.json" "$declarations"

  printf '%s\n' "${rejected[@]}"
  printf '%s: kernel %s, vgem source v%s (%s)\n' \
    "$host" "$kernel" "$selected" "${files[*]}"
}

install_package() {
  local host=$1 decl kernel series package version dkms_name format core_config out file installed
  decl=$(nix_cmd eval --json "$root#vgemDkms.hosts.$host")
  series=$(jq -r .series <<< "$decl")
  package=$(jq -r .packageName <<< "$decl")
  version=$(jq -r .version <<< "$decl")
  dkms_name=$(jq -r .dkmsName <<< "$decl")
  format=$(jq -r .packageFormat <<< "$decl")
  core_config=$(jq -r .coreConfig <<< "$decl")
  kernel=$(remote "$host" 'uname -r')
  [[ "$kernel" == "$series".* ]] || {
    echo "$host runs $kernel, outside the declared $series series; run select first" >&2
    return 1
  }
  case "$format" in
    deb) installed=$(remote "$host" "dpkg-query -W -f='\${Version}' $package 2>/dev/null || true") ;;
    pacman) installed=$(remote "$host" "pacman -Q $package 2>/dev/null | cut -d' ' -f2 || true") ;;
  esac
  if [[ "$installed" == "$(jq -r .packageVersion <<< "$decl")" ]]; then
    echo "$package $installed is already installed on $host" >&2
  else
    out=$(nix_cmd build --no-link --print-out-paths "$root#vgem-dkms-$host")
    file=$(< "$out/package-file")
    remote "$host" "set -eu
      d=\$(mktemp -d /var/tmp/vgem-dkms.XXXXXX)
      trap 'rm -rf \"\$d\"' EXIT
      chmod 0755 \"\$d\"
      cat > \"\$d/$file\"
      case $format in
        deb) sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades --no-install-recommends \"\$d/$file\" ;;
        pacman) sudo -n pacman -U --noconfirm \"\$d/$file\" ;;
      esac
    " < "$out/$file"
    echo "installed $file on $host" >&2
  fi
  # Package hooks build only some kernels (Debian: the running and the newest
  # one), so build every headers-installed kernel here: the next boot kernel is
  # covered and ABI check failures surface now, as the activation assertion
  # requires.
  remote "$host" "set -u
    failed=
    for dir in /lib/modules/*; do
      [ -e \"\$dir/build\" ] || continue
      k=\${dir##*/}
      # Excluded by BUILD_EXCLUSIVE_CONFIG: no DRM core, so vgem cannot work there.
      [ \"\$k\" = '$kernel' ] || grep -qE '^$core_config=(y|m)\$' \"\$dir/build/.config\" 2>/dev/null || continue
      sudo -n dkms status -m $dkms_name -v $version -k \"\$k\" | grep -q ': installed' && continue
      sudo -n dkms install -m $dkms_name -v $version -k \"\$k\" || {
        failed=\"\$failed \$k\"
        sudo -n tail -n 40 /var/lib/dkms/$dkms_name/$version/build/make.log >&2 || true
      }
    done
    sudo -n dkms status -m $dkms_name -v $version
    [ -z \"\$failed\" ] || {
      echo '$dkms_name $version failed to build for:'\"\$failed\" >&2
      exit 1
    }
  "
  echo "vgem loads on $host after a reboot via /etc/modules-load.d/vgem.conf or an explicit 'sudo modprobe vgem'"
}

(( $# >= 2 )) || usage
command=$1
host=$2
shift 2
case "$command" in
  select)
    baseline=
    while (( $# )); do
      case "$1" in
        --baseline) baseline=${2:?}; shift 2 ;;
        *) usage ;;
      esac
    done
    select_source "$host" "$baseline"
    ;;
  install)
    (( $# == 0 )) || usage
    install_package "$host"
    ;;
  *) usage ;;
esac
