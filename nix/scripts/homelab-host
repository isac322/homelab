#!/usr/bin/env bash
set -euo pipefail
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
state=${HOMELAB_STATE_DIR:-"$root/.host-state"}
mkdir -p "$state/baselines" "$state/receipts" "$state/recovery"
chmod 0700 "$state" "$state/baselines" "$state/receipts" "$state/recovery"

usage() {
  cat <<'EOF'
Usage: homelab-host <command> [arguments]
  inventory
  bootstrap-host <host>
  baseline <host>              Read-only alias for adopt-host baseline
  onboard-k3s-node <host> --token-source <existing-host>
  reconcile <host>             Idempotently converge an active Nix-owned host
  prepare <host>
  activate <host>
  reboot-verify <host>
  commit <host>
  restore-host <host>
  rollback <host> <system-manager-generation>
  deploy <host>                 Alias for prepare; activation remains explicit
  verify-host <host> [--baseline <file>]
  reconcile-distro-packages <host> [--purge]
  check-bootstrap
  bootstrap-k3s <backbone>
  bootstrap-argocd <backbone>
  issue-kubeconfig <identity>
EOF
}

nix_eval() { nix --extra-experimental-features 'nix-command flakes' eval "$@"; }
system_manager_source=github:numtide/system-manager/48d47346e0c6ad05b6c869ea92649c47723d1cfc
host_field() { nix_eval --raw "$root#topology.nodes.$1.$2"; }
remote() { local host=$1; shift; ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$(host_field "$host" sshTarget)" "$@"; }
receipt() { printf '%s/receipts/%s.json' "$state" "$1"; }
current_revision() { git rev-parse HEAD 2>/dev/null || printf unknown; }
committed_flake() {
  local attribute=$1 repository revision
  git diff --quiet && git diff --cached --quiet || {
    echo "host rollout requires a clean committed worktree" >&2
    return 1
  }
  revision=$(current_revision)
  repository=$(git remote get-url origin)
  case "$repository" in
    git@github.com:*) repository="https://github.com/${repository#git@github.com:}" ;;
    https://github.com/*) ;;
    *)
      echo "unsupported origin URL for remote Nix build: $repository" >&2
      return 1
      ;;
  esac
  printf 'git+%s?rev=%s#%s\n' "$repository" "$revision" "$attribute"
}
remote_system_manager() {
  local host=$1 command argument
  shift
  printf -v command '%q --extra-experimental-features %q --accept-flake-config run %q --' \
    /nix/var/nix/profiles/default/bin/nix 'nix-command flakes' "$system_manager_source"
  for argument in "$@"; do
    printf -v command '%s %q' "$command" "$argument"
  done
  remote "$host" "$command"
}
register_system() {
  local host=$1 attribute=$2 flake
  flake=$(committed_flake "$attribute")
  remote_system_manager "$host" register --flake "$flake" --sudo >&2
  remote "$host" 'sudo -n readlink -f /nix/var/nix/profiles/system-manager-profiles/system-manager'
}
activate_registered_system() {
  remote "$1" 'sudo -n /nix/var/nix/profiles/system-manager-profiles/system-manager/bin/activate'
}
assert_iptables_nft_backend() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    for command in iptables iptables-save iptables-restore; do
      path=$(command -v "$command") || {
        echo "$command is required" >&2
        exit 1
      }
      version=$("$path" --version)
      case "$version" in
        *"(nf_tables)") ;;
        *)
          echo "$command must use the nf_tables backend; found: $version" >&2
          exit 1
          ;;
      esac
    done
  '\'''
}
reconcile_distro_packages() {
  local host=$1 purge=${2:-no} backend present absent purge_enabled command
  backend=$(host_field "$host" packageBackend)
  present=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.present" | jq -r 'join(" ")')
  absent=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.absent" | jq -r 'join(" ")')
  purge_enabled=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.purgeAbsent")
  if [ "$purge" = yes ] && [ "$purge_enabled" != true ]; then purge=no; fi
  printf -v command 'sudo -n env BACKEND=%q PURGE=%q PRESENT=%q ABSENT=%q sh -s' \
    "$backend" "$purge" "$present" "$absent"
  remote "$host" "$command" <<'REMOTE_PACKAGE_RECONCILE'
set -eu
case "$BACKEND" in
  pacman)
    missing=
    for package in $PRESENT; do
      /usr/bin/pacman -Q "$package" >/dev/null 2>&1 || missing="$missing $package"
    done
    if [ -n "$missing" ]; then /usr/bin/pacman --noconfirm --needed -S $missing; fi
    if [ "$PURGE" = yes ]; then
      installed=
      for package in $ABSENT; do
        /usr/bin/pacman -Q "$package" >/dev/null 2>&1 && installed="$installed $package" || true
      done
      if [ -n "$installed" ]; then /usr/bin/pacman --noconfirm -Rns $installed; fi
    fi
    ;;
  apt)
    export DEBIAN_FRONTEND=noninteractive
    missing=
    for package in $PRESENT; do
      status=$(/usr/bin/dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)
      [ "$status" = "install ok installed" ] || missing="$missing $package"
    done
    if [ -n "$missing" ]; then
      policy=/usr/sbin/policy-rc.d
      policy_backup=
      restore_policy() {
        rm -f "$policy"
        if [ -n "$policy_backup" ]; then
          mv "$policy_backup/policy-rc.d" "$policy"
          rmdir "$policy_backup"
        fi
      }
      if [ -e "$policy" ] || [ -L "$policy" ]; then
        policy_backup=$(mktemp -d /run/homelab-policy-rc.d.XXXXXX)
        cp -a "$policy" "$policy_backup/policy-rc.d"
      fi
      printf '#!/bin/sh\nexit 101\n' > "$policy"
      chmod 0755 "$policy"
      trap restore_policy EXIT HUP INT TERM
      /usr/bin/apt-get update
      /usr/bin/apt-get install -y --no-install-recommends $missing
      restore_policy
      trap - EXIT HUP INT TERM
    fi
    if [ "$PURGE" = yes ]; then
      installed=
      for package in $ABSENT; do
        status=$(/usr/bin/dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)
        [ "$status" != "install ok installed" ] || installed="$installed $package"
      done
      if [ -n "$installed" ]; then /usr/bin/apt-get purge -y $installed; fi
    fi
    ;;
  *) echo "unsupported package backend: $BACKEND" >&2; exit 2 ;;
esac
REMOTE_PACKAGE_RECONCILE
}
apply_native_runtime() {
  local host=$1 default_interface lan_address zram interfaces backend firewall_service ssh_service role command
  assert_iptables_nft_backend "$host"
  default_interface=$(host_field "$host" defaultInterface 2>/dev/null || true)
  lan_address=$(host_field "$host" lanAddress 2>/dev/null || true)
  zram=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.zram")
  interfaces=$(nix_eval --json "$root#topology.nodes.$host.wireguard" | jq -r 'join(" ")')
  backend=$(host_field "$host" packageBackend)
  role=$(host_field "$host" k3sRole 2>/dev/null || true)
  if [ "$backend" = pacman ]; then
    firewall_service=iptables.service
    ssh_service=sshd.service
  else
    firewall_service=netfilter-persistent.service
    ssh_service=ssh.service
  fi
  printf -v command \
    'sudo -n env HOST_NAME=%q DEFAULT_INTERFACE=%q STATIC_LAN=%q ZRAM=%q WG_INTERFACES=%q FIREWALL_SERVICE=%q SSH_SERVICE=%q ROLE=%q sh -s' \
    "$host" "$default_interface" "$([ -n "$lan_address" ] && [ "$lan_address" != null ] && printf true || printf false)" \
    "$zram" "$interfaces" "$firewall_service" "$ssh_service" "$role"
  remote "$host" "$command" <<'REMOTE_NATIVE_RUNTIME'
set -eu
systemctl daemon-reload
systemctl enable systemd-networkd.service systemd-resolved.service "$FIREWALL_SERVICE"
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl enable homelab-k3s.service
fi
hostnamectl set-hostname "$HOST_NAME"
if command -v locale-gen >/dev/null 2>&1; then locale-gen; fi
localectl set-locale LANG=ko_KR.UTF-8
timedatectl set-timezone Asia/Seoul
systemd-tmpfiles --create --prefix=/etc/resolv.conf
systemctl restart systemd-resolved.service
sshd -t
systemctl reload "$SSH_SERVICE"
sysctl --system
if test -f /etc/tmpfiles.d/60-homelab-runtime-tuning.conf; then
  systemd-tmpfiles --create /etc/tmpfiles.d/60-homelab-runtime-tuning.conf
fi
for unit in zram-swap.service ksm.service thp-madvise.service; do
  systemctl disable --now "$unit" >/dev/null 2>&1 || true
done
if test "$ZRAM" = true; then
  systemctl stop dev-zram0.swap systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
  systemctl daemon-reload
  systemctl start dev-zram0.swap
fi
systemctl restart systemd-networkd.service
networkctl reload
if test "$STATIC_LAN" = true; then networkctl reconfigure "$DEFAULT_INTERFACE"; fi
for interface in $WG_INTERFACES; do
  networkctl reconfigure "$interface"
  ip link show "$interface" >/dev/null
done
while iptables -C INPUT -j HOMELAB_INPUT 2>/dev/null; do iptables -D INPUT -j HOMELAB_INPUT; done
while iptables -C FORWARD -j HOMELAB_FORWARD 2>/dev/null; do iptables -D FORWARD -j HOMELAB_FORWARD; done
iptables-restore --noflush --wait < /etc/homelab/firewall.rules
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT
input_position=$(iptables -S INPUT | awk '/-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { position = NR } END { print position ? position : 1 }')
forward_position=$(iptables -S FORWARD | awk '/-j CILIUM_FORWARD$/ { position = NR } END { print position ? position : 1 }')
iptables -I INPUT "$input_position" -j HOMELAB_INPUT
iptables -I FORWARD "$forward_position" -j HOMELAB_FORWARD
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl restart homelab-k3s.service
fi
REMOTE_NATIVE_RUNTIME
}
capture_runtime_firewall() {
  local host=$1 recovery=$2
  assert_iptables_nft_backend "$host"
  remote "$host" 'sudo -n iptables-save' > "$recovery/firewall-runtime.rules"
  chmod 0600 "$recovery/firewall-runtime.rules"
}
capture_managed_recovery() {
  local host=$1 recovery
  recovery="$state/recovery/$host-reconcile-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -m 0700 "$recovery"
  remote "$host" 'sudo -n tar -C / -cf - etc' > "$recovery/etc-state.tar"
  chmod 0600 "$recovery/etc-state.tar"
  printf '%s\n' "$recovery"
}
restore_previous_secrets() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    base=/var/lib/homelab-secrets
    test -L "$base/previous" || exit 0
    abandoned=$(readlink "$base/active" 2>/dev/null || true)
    restore=$(readlink "$base/previous")
    name=${restore#generations/}
    case "$name" in ""|.|..|*/*) exit 1 ;; esac
    test "$restore" = "generations/$name"
    test -d "$base/$restore"
    rm -f "$base/active.new"
    ln -s "$restore" "$base/active.new"
    mv -Tf "$base/active.new" "$base/active"
    if test -n "$abandoned" && test "$abandoned" != "$restore"; then
      name=${abandoned#generations/}
      case "$name" in ""|.|..|*/*) exit 1 ;; esac
      test "$abandoned" = "generations/$name"
      rm -rf -- "$base/$abandoned"
    fi
    rm -f "$base/previous"
  '\'''
}
cleanup_legacy_files() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    for unit in k3s.service k3s-agent.service zram-swap.service ksm.service thp-madvise.service; do
      systemctl disable --now "$unit" >/dev/null 2>&1 || true
      fragment=$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null || true)
      case "$fragment" in /etc/systemd/system/*) rm -f "$fragment" ;; esac
      rm -f "/etc/systemd/system/multi-user.target.wants/$unit"
      rm -f "/etc/systemd/system/$unit.env"
    done
    systemctl daemon-reload
  '\'''
}
verify_legacy_cleanup() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    test -x /usr/local/bin/k3s
    for unit in k3s.service k3s-agent.service zram-swap.service ksm.service thp-madvise.service; do
      test -z "$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null || true)"
      test ! -e "/etc/systemd/system/$unit.env"
    done
  '\'''
}
require_receipt_phase() {
  local host=$1 phase=$2 file generation active store_path active_store
  file=$(receipt "$host")
  test "$(jq -r .phase "$file" 2>/dev/null)" = "$phase"
  test "$(jq -r .revision "$file")" = "$(current_revision)" || {
    echo "$host receipt belongs to a different Git revision; rerun prepare" >&2
    exit 1
  }
  generation=$(jq -r '.secretGeneration // empty' "$file")
  if [ -n "$generation" ]; then
    active=$(remote "$host" 'sudo -n readlink /var/lib/homelab-secrets/active')
    test "$active" = "generations/$generation" || {
      echo "$host active secret generation changed after prepare" >&2
      exit 1
    }
  fi
  store_path=$(jq -r '.storePath // empty' "$file")
  if [ -n "$store_path" ]; then
    active_store=$(remote "$host" 'sudo -n readlink -f /nix/var/nix/profiles/system-manager-profiles/system-manager')
    test "$active_store" = "$store_path" || {
      echo "$host system-manager generation changed after prepare" >&2
      exit 1
    }
  fi
}
current_k3s() {
  local raw version
  raw=$(remote "$1" 'sudo -n sh -ceu '\''
    if test -x /usr/local/bin/k3s; then
      exec /usr/local/bin/k3s --version
    fi
    state=$(systemctl is-active homelab-k3s.service 2>/dev/null || true)
    if test "$state" = active; then
      pid=$(systemctl show homelab-k3s.service -p MainPID --value)
      test -n "$pid" && test "$pid" != 0
      executable=$(readlink "/proc/$pid/exe")
      exec "$executable" --version
    fi
    if test -d /var/lib/rancher/k3s; then
      echo "K3s state exists but no running binary can be identified" >&2
      exit 1
    fi
    printf "absent\n"
  '\''')
  if [ "$raw" = absent ]; then
    printf 'absent\n'
    return
  fi
  version=$(printf '%s\n' "$raw" | sed -n 's/^k3s version v\([^ ]*\).*/\1/p')
  test -n "$version" || {
    echo "unable to parse the running K3s version on $1" >&2
    return 1
  }
  printf '%s\n' "$version"
}
write_receipt() {
  local host=$1 phase=$2 previous=${3:-null} legacy=${4:-} recovery=${5:-} secret_generation=${6:-} store_path=${7:-}
  jq -n --arg host "$host" --arg phase "$phase" --arg revision "$(current_revision)" --arg previous "$previous" --arg legacy "$legacy" --arg recovery "$recovery" --arg secretGeneration "$secret_generation" --arg storePath "$store_path" --arg time "$(date -u +%FT%TZ)" '{host:$host,phase:$phase,revision:$revision,previousGeneration:$previous,legacyK3sUnit:$legacy,recoveryDirectory:$recovery,secretGeneration:$secretGeneration,storePath:$storePath,time:$time}' > "$(receipt "$host").new"
  mv -f "$(receipt "$host").new" "$(receipt "$host")"
  chmod 0600 "$(receipt "$host")"
}
rollback_armed_host() {
  local host=$1
  "$root/nix/scripts/k3s-handoff" restore "$host"
  "$root/nix/scripts/k3s-handoff" accept "$host"
}

case "${1:-}" in
  inventory) nix_eval --json "$root#topology.nodes" | jq . ;;
  bootstrap-host)
    host=${2:?host required}; target=$(host_field "$host" sshTarget)
    ssh -tt -o StrictHostKeyChecking=accept-new "$target" "sh -ceu '
      user=\$(id -un)
      if test \"\$(id -u)\" -eq 0; then
        SUDO=
      else
        sudo -v
        SUDO=sudo
        tmp=\$(mktemp /tmp/homelab-admin.XXXXXX)
        trap \"rm -f -- \$tmp\" EXIT HUP INT TERM
        printf \"%s ALL=(ALL) NOPASSWD: ALL\\n\" \"\$user\" > \"\$tmp\"
        chmod 0440 \"\$tmp\"
        sudo visudo -cf \"\$tmp\"
        sudo install -m 0440 \"\$tmp\" /etc/sudoers.d/homelab-admin
        rm -f \"\$tmp\"
        trap - EXIT HUP INT TERM
      fi
      . /etc/os-release
      case \"\$ID\" in
        arch)
          \$SUDO pacman --noconfirm --needed -S age curl sudo xz
          ;;
        debian|ubuntu|raspbian)
          \$SUDO apt-get update
          \$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends age ca-certificates curl sudo xz-utils
          ;;
        *)
          echo \"unsupported bootstrap distribution: \$ID\" >&2
          exit 1
          ;;
      esac
      if ! command -v nix >/dev/null 2>&1 && ! test -x /nix/var/nix/profiles/default/bin/nix; then
        curl --proto \"=https\" --tlsv1.2 -fsSL https://nixos.org/nix/install | sh -s -- --daemon --yes
      fi
      test -x /nix/var/nix/profiles/default/bin/nix || command -v nix >/dev/null
      command -v age-keygen >/dev/null
      sudo -n true
    '"
    ;;
  baseline)
    test "$#" -eq 2 || { usage >&2; exit 2; }
    "$root/nix/scripts/adopt-host" baseline "$2"
    ;;
  reconcile)
    host=${2:?host required}
    test "$(host_field "$host" lifecycle)" = active || {
      echo "$host must have lifecycle=active before reconciliation" >&2
      exit 1
    }
    legacy_unit=$(remote "$host" 'for unit in k3s.service k3s-agent.service; do test "$(systemctl is-active "$unit" 2>/dev/null || true)" = active && { printf "%s" "$unit"; exit; }; done; true')
    test -z "$legacy_unit" || {
      echo "$host still uses $legacy_unit; use the separate adopt-host migration workflow" >&2
      exit 1
    }
    "$root/nix/scripts/k3s-handoff" preflight "$host" ""
    recovery=$(capture_managed_recovery "$host")
    reconcile_distro_packages "$host" no
    assert_iptables_nft_backend "$host"
    previous=$(remote "$host" 'sudo -n nix-env --profile /nix/var/nix/profiles/system-manager-profiles/system-manager --list-generations 2>/dev/null | awk "/\(current\)/ {print \$1}"')
    test -n "$previous" || {
      echo "$host has no active system-manager generation; use the provisioning or adoption workflow" >&2
      exit 1
    }
    store_path=$(register_system "$host" "$host")
    stage_result=$("$root/nix/scripts/wireguard-secrets" stage-secrets "$host")
    secret_generation=${stage_result#* }
    test -n "$secret_generation" && test "$secret_generation" != "$stage_result"
    capture_runtime_firewall "$host" "$recovery"
    "$root/nix/scripts/k3s-handoff" arm "$host" "$recovery" "$previous" ""
    if ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host "$host"; then
      if rollback_armed_host "$host"; then
        write_receipt "$host" rolled-back "$previous" "" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    "$root/nix/scripts/k3s-handoff" accept "$host"
    write_receipt "$host" reconciled "$previous" "" "$recovery" "$secret_generation" "$store_path"
    rm -rf "$recovery"
    printf 'reconciled %s at %s\n' "$host" "$(current_revision)"
    ;;
  prepare|deploy)
    host=${2:?host required}
    legacy_unit=$(remote "$host" 'for unit in k3s.service k3s-agent.service; do test "$(systemctl is-active "$unit" 2>/dev/null || true)" = active && { printf "%s" "$unit"; exit; }; done; true')
    "$root/nix/scripts/k3s-handoff" preflight "$host" "$legacy_unit"
    recovery=$("$root/nix/scripts/adopt-host" "$host")
    reconcile_distro_packages "$host" no
    assert_iptables_nft_backend "$host"
    previous=$(remote "$host" 'sudo -n nix-env --profile /nix/var/nix/profiles/system-manager-profiles/system-manager --list-generations 2>/dev/null | awk "/\(current\)/ {print \$1}"')
    store_path=$(register_system "$host" "$host")
    stage_result=$("$root/nix/scripts/wireguard-secrets" stage-secrets "$host")
    secret_generation=${stage_result#* }
    test -n "$secret_generation" && test "$secret_generation" != "$stage_result"
    write_receipt "$host" prepared "$previous" "$legacy_unit" "$recovery" "$secret_generation" "$store_path"
    printf 'prepared %s; run activate explicitly\n' "$host"
    ;;
  activate)
    host=${2:?host required}; require_receipt_phase "$host" prepared
    assert_iptables_nft_backend "$host"
    legacy=$(jq -r '.legacyK3sUnit // empty' "$(receipt "$host")")
    recovery=$(jq -r '.recoveryDirectory // empty' "$(receipt "$host")")
    previous=$(jq -r '.previousGeneration // empty' "$(receipt "$host")")
    secret_generation=$(jq -r '.secretGeneration // empty' "$(receipt "$host")")
    store_path=$(jq -r '.storePath // empty' "$(receipt "$host")")
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    capture_runtime_firewall "$host" "$recovery"
    "$root/nix/scripts/k3s-handoff" arm "$host" "$recovery" "$previous" "$legacy"
    if [ "$role" = server ] && remote "$host" 'sudo -n test -d /var/lib/rancher/k3s/server/db'; then
      if ! remote "$host" 'sudo -n sh -eu' > "$recovery/k3s-cold-state.tar" <<'REMOTE_K3S_COLD_BACKUP'
if test "$(systemctl is-active homelab-k3s.service 2>/dev/null || true)" = active; then
  systemctl stop homelab-k3s.service
fi
test "$(systemctl is-active homelab-k3s.service 2>/dev/null || true)" != active
test "$(systemctl is-active k3s.service 2>/dev/null || true)" != active
tar -C /var/lib/rancher/k3s -cf - server/db server/cred server/token
REMOTE_K3S_COLD_BACKUP
      then
        if rollback_armed_host "$host"; then
          write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
        fi
        exit 1
      fi
      chmod 0600 "$recovery/k3s-cold-state.tar"
    fi
    if ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host "$host"; then
      if rollback_armed_host "$host"; then
        write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
      else
        echo "$host automatic rollback failed; inspect nix run .#k3s-handoff -- status $host" >&2
      fi
      exit 1
    fi
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      if rollback_armed_host "$host"; then
        write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    write_receipt "$host" activated "$previous" "$legacy" "$recovery" "$secret_generation" "$store_path"
    printf 'activated %s; reboot before the 15-minute rollback timer expires\n' "$host"
    ;;
  reboot-verify)
    host=${2:?host required}; require_receipt_phase "$host" activated
    receipt_file=$(receipt "$host")
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    store_path=$(jq -r '.storePath // empty' "$receipt_file")
    if ! "$0" verify-host "$host" || ! "$root/nix/scripts/k3s-handoff" disarm "$host"; then
      if rollback_armed_host "$host"; then
        write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    write_receipt "$host" reboot-verified "$previous" "$legacy" "$recovery" "$secret_generation" "$store_path"
    ;;
  commit)
    host=${2:?host required}; require_receipt_phase "$host" reboot-verified
    receipt_file=$(receipt "$host")
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    committed_store_path=$(register_system "$host" "$host-commit")
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      echo "$host commit rollback timer could not be armed; host state was not changed" >&2
      exit 1
    fi
    if ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host "$host" \
      || ! reconcile_distro_packages "$host" yes \
      || ! cleanup_legacy_files "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host "$host" \
      || ! verify_legacy_cleanup "$host"; then
      if rollback_armed_host "$host"; then
        write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
      else
        echo "$host rollback failed; recovery remains armed" >&2
      fi
      exit 1
    fi
    if ! "$root/nix/scripts/k3s-handoff" accept "$host"; then
      echo "$host is committed but rollback artifact cleanup failed; rerun commit" >&2
      exit 1
    fi
    write_receipt "$host" committed "$previous" "$legacy" "$recovery" "$secret_generation" "$committed_store_path"
    ;;
  onboard-k3s-node)
    host=${2:?host required}; test "${3:-}" = --token-source; source_host=${4:?token source required}
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    test -n "$role" && test "$role" != null
    remote "$host" 'test -x /usr/local/bin/k3s && test ! -d /var/lib/rancher/k3s && test "$(systemctl is-active k3s.service k3s-agent.service homelab-k3s.service 2>/dev/null | grep -c "^active$" || true)" -eq 0'
    "$root/nix/scripts/wireguard-secrets" copy-k3s-token --from "$source_host" --to "$host" --write
    "$0" prepare "$host"
    ;;
  reconcile-distro-packages)
    case "${3:-}" in
      "") purge=no ;;
      --purge) purge=yes ;;
      *) usage; exit 2 ;;
    esac
    reconcile_distro_packages "${2:?host required}" "$purge"
    ;;
  verify-host|verify)
    host=${2:?host required}; shift 2
    baseline=
    if [ "${1:-}" = --baseline ]; then baseline=${2:?baseline file required}; shift 2; fi
    test "$#" -eq 0
    assert_iptables_nft_backend "$host"
    if [ -n "$baseline" ]; then
      test -s "$baseline"
      current_baseline=$("$root/nix/scripts/adopt-host" baseline "$host")
      for key in os arch wireguard-public; do
        test "$(sed -n "s/^$key=//p" "$baseline")" = "$(sed -n "s/^$key=//p" "$current_baseline")" || {
          echo "$host baseline changed: $key" >&2
          rm -f "$current_baseline"
          exit 1
        }
      done
      rm -f "$current_baseline"
    fi
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    iscsi_client=$(nix_eval --json "$root#topology.nodes.$host.iscsiClient")
    iscsi_server=$(nix_eval --json "$root#topology.nodes.$host.iscsiServer")
    zram=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.zram")
    lan_address=$(host_field "$host" lanAddress 2>/dev/null || true)
    gateway_address=$(host_field "$host" gatewayAddress 2>/dev/null || true)
    default_interface=$(host_field "$host" defaultInterface 2>/dev/null || true)
    backend=$(host_field "$host" packageBackend)
    ssh_target=$(host_field "$host" sshTarget)
    admin_user=${ssh_target%@*}
    samba_clients=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.firewall.sambaClients" | jq -r 'join(" ")')
    netbios=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.firewall.netbios")
    local_network=$(nix_eval --raw "$root#systemConfigs.$host.config.homelab.firewall.localNetwork")
    if [ "$backend" = pacman ]; then
      firewall_rules=/etc/iptables/iptables.rules
      firewall_service=iptables.service
      ssh_service=sshd.service
    else
      firewall_rules=/etc/iptables/rules.v4
      firewall_service=netfilter-persistent.service
      ssh_service=ssh.service
    fi
    democratic_csi_key_sha=
    if [ "$iscsi_server" = true ]; then
      democratic_csi_key_sha=$(sha256sum "$root/ssh_pub_keys/democratic-csi.pub" | awk '{print $1}')
    fi
    printf -v verify_command \
      'env HOST_NAME=%q ROLE=%q ISCSI_CLIENT=%q ISCSI_SERVER=%q ZRAM=%q DEMOCRATIC_CSI_KEY_SHA=%q LAN_ADDRESS=%q GATEWAY_ADDRESS=%q DEFAULT_INTERFACE=%q FIREWALL_RULES=%q FIREWALL_SERVICE=%q SSH_SERVICE=%q ADMIN_USER=%q SAMBA_CLIENTS=%q NETBIOS=%q LOCAL_NETWORK=%q sh -s' \
      "$host" "$role" "$iscsi_client" "$iscsi_server" "$zram" "$democratic_csi_key_sha" \
      "$lan_address" "$gateway_address" "$default_interface" "$firewall_rules" "$firewall_service" "$ssh_service" \
      "$admin_user" "$samba_clients" "$netbios" "$local_network"
    remote "$host" "$verify_command" <<'REMOTE_VERIFY'
set -eu
test "$(hostname)" = "$HOST_NAME"
systemctl is-active systemd-networkd systemd-resolved "$SSH_SERVICE"
systemctl is-enabled systemd-networkd systemd-resolved "$FIREWALL_SERVICE"
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl is-enabled homelab-k3s.service
fi
test "$(timedatectl show -p Timezone --value)" = Asia/Seoul
grep -qx "LANG=ko_KR.UTF-8" /etc/locale.conf
locale -a | grep -qi '^ko_KR\.utf8$'
grep -qx "DNSSEC=yes" /etc/systemd/resolved.conf
grep -qx "DNSOverTLS=yes" /etc/systemd/resolved.conf
grep -qx "MulticastDNS=yes" /etc/systemd/resolved.conf
grep -qx "LLMNR=no" /etc/systemd/resolved.conf
test "$(readlink /etc/resolv.conf)" = /run/systemd/resolve/stub-resolv.conf
test "$(getent passwd root | cut -d: -f7)" = /bin/bash
sshd_bin=$(command -v sshd || printf /usr/sbin/sshd)
sudo -n "$sshd_bin" -T | grep -Eqi '^authorizedkeysfile .*\.ssh/authorized_keys.*/etc/ssh/authorized_keys\.d/%u'
if test "$ADMIN_USER" != root; then
  grep -Fx "$ADMIN_USER ALL=(ALL) NOPASSWD: ALL" /etc/sudoers.d/homelab-admin
  visudo_bin=$(command -v visudo || printf /usr/sbin/visudo)
  sudo -n "$visudo_bin" -cf /etc/sudoers.d/homelab-admin
fi
test -s "$FIREWALL_RULES"
for unit in homelab-host-settings.service homelab-wireguard.service homelab-firewall.service homelab-runtime-tuning.service homelab-k3s-legacy-cleanup.service homelab-legacy-tuning-cleanup.service; do
  ! systemctl cat "$unit" >/dev/null 2>&1
done
if test -n "$LAN_ADDRESS" && test "$LAN_ADDRESS" != null; then
  ip -o -4 address show dev "$DEFAULT_INTERFACE" | awk '{print $4}' | grep -Fx "$LAN_ADDRESS/24"
  ip -4 route show default | grep -F "via $GATEWAY_ADDRESS dev $DEFAULT_INTERFACE"
  grep -qx "MulticastDNS=yes" /etc/systemd/network/10-homelab-lan.network
  grep -qx "LLMNR=no" /etc/systemd/network/10-homelab-lan.network
fi
test "$(sudo -n iptables -S INPUT | grep -c -- "-j HOMELAB_INPUT")" -eq 1
test "$(sudo -n iptables -S FORWARD | grep -c -- "-j HOMELAB_FORWARD")" -eq 1
test "$(sudo -n iptables -S INPUT | sed -n "1p")" = "-P INPUT DROP"
test "$(sudo -n iptables -S FORWARD | sed -n "1p")" = "-P FORWARD DROP"
test "$(sudo -n iptables -S OUTPUT | sed -n "1p")" = "-P OUTPUT ACCEPT"
for source in $SAMBA_CLIENTS; do
  sudo -n iptables -C HOMELAB_TCP -s "$source" -p tcp --dport 445 -j ACCEPT
done
if test "$NETBIOS" = true; then
  sudo -n iptables -C HOMELAB_UDP -s "$LOCAL_NETWORK" -p udp --dport 137:138 -j ACCEPT
fi
if test "$ROLE" = server || test "$ROLE" = agent; then
  test "$(sysctl -n net.ipv4.ip_forward)" = 1
  test -x /usr/local/bin/k3s
  systemctl is-active homelab-k3s.service
  sudo -n test -s /run/credentials/homelab-k3s.service/k3s-token
  sudo -n iptables -S INPUT | awk '
    /-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { native = NR }
    /-j HOMELAB_INPUT$/ { homelab = NR }
    END { exit !(native && homelab > native) }
  '
  sudo -n iptables -S FORWARD | awk '
    /-j CILIUM_FORWARD$/ { native = NR }
    /-j HOMELAB_FORWARD$/ { homelab = NR }
    END { exit !(native && homelab > native) }
  '
else
  test "$(sudo -n iptables -S INPUT | sed -n "2p")" = "-A INPUT -j HOMELAB_INPUT"
  test "$(sudo -n iptables -S FORWARD | sed -n "2p")" = "-A FORWARD -j HOMELAB_FORWARD"
fi
if test "$ZRAM" = true; then
  systemctl is-active dev-zram0.swap
  swapon --show=NAME --noheadings | grep -qx /dev/zram0
fi
if test "$ISCSI_CLIENT" = true; then
  systemctl is-active iscsid.service open-iscsi.service
fi
if test "$ISCSI_SERVER" = true; then
  test "$(id -u democratic-csi)" -eq 1001
  test "$(id -g democratic-csi)" -eq 1001
  test "$(sha256sum /etc/ssh/authorized_keys.d/democratic-csi | awk '{print $1}')" = "$DEMOCRATIC_CSI_KEY_SHA"
  sudo -n -u democratic-csi sudo -n true
fi
if test "$ROLE" = server; then
  pid=$(systemctl show homelab-k3s.service -p MainPID --value)
  test "$pid" -gt 1
  sudo -n /usr/local/bin/k3s etcd-snapshot ls >/dev/null
fi
REMOTE_VERIFY
    while IFS= read -r interface; do
      expected_public=$(nix_eval --raw "$root#topology.$interface.nodes.$host.publicKey")
      expected_address=$(nix_eval --raw "$root#topology.$interface.nodes.$host.address")
      remote "$host" "sudo -n sh -ceu 'test -s \"/run/credentials/systemd-networkd.service/$interface-private\"; test \"\$(wg show \"$interface\" public-key)\" = \"$expected_public\"; ip -o -4 address show dev \"$interface\" | awk \"{print \\\$4}\" | grep -Fx \"$expected_address\"'"
      while IFS= read -r peer; do
        peer_public=$(nix_eval --raw "$root#topology.$interface.nodes.$peer.publicKey")
        remote "$host" "sudo -n sh -ceu 'test \"\$(wg show \"$interface\" latest-handshakes | awk -v key=\"$peer_public\" \"\\\$1 == key { print \\\$2 }\")\" -gt 0'"
      done < <(nix_eval --json "$root#topology.requiredLinks" | jq -r --arg host "$host" --arg interface "$interface" '.[] | select(.network == $interface and .managed and (.aName == $host or .bName == $host)) | if .aName == $host then .bName else .aName end')
    done < <(nix_eval --json "$root#topology.nodes.$host.wireguard" | jq -r '.[]')
    if [ "$role" = server ] || [ "$role" = agent ]; then
      context=${BACKBONE_CONTEXT:-homelab-backbone}
      test "$(kubectl --context "$context" get node "$host" -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}')" = True
    fi
    ;;
  restore-host)
    host=${2:?host required}; receipt_file=$(receipt "$host")
    phase=$(jq -r '.phase // empty' "$receipt_file" 2>/dev/null)
    case "$phase" in activated|reboot-verified) ;; *) echo "$host has no armed activation to restore" >&2; exit 1 ;; esac
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    rollback_armed_host "$host"
    write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation"
    ;;
  rollback)
    host=${2:?host required}; generation=${3:?generation required}
    restore_previous_secrets "$host"
    remote "$host" "sudo -n sh -ceu '
      nix-env --profile /nix/var/nix/profiles/system-manager-profiles/system-manager --switch-generation \"$generation\"
      /nix/var/nix/profiles/system-manager-profiles/system-manager/bin/activate
    '"
    apply_native_runtime "$host"
    "$0" verify-host "$host"
    ;;
  check-bootstrap)
    kubectl --context "${BACKBONE_CONTEXT:-homelab-backbone}" get --raw=/readyz >/dev/null
    printf 'bootstrap: existing clusters are ready; Rancher system-upgrade-controller retains K3s upgrade ownership\n'
    ;;
  bootstrap-k3s)
    cluster=${2:?cluster required}; test "$cluster" = backbone
    context=${BOOTSTRAP_CONTEXT:-homelab-backbone}; values="$root/values/cilium/backbone.yaml"
    if kubectl --context "$context" get --raw=/readyz >/dev/null 2>&1; then
      helm --kube-context "$context" diff upgrade cilium cilium --repo https://helm.cilium.io --version 1.20.0 --namespace kube-system --values "$values" >/dev/null
      printf 'existing cluster: Cilium dry-run diff completed; release ownership unchanged\n'
    else
      test "${ALLOW_NEW_CLUSTER_BOOTSTRAP:-}" = yes
      helm --kube-context "$context" upgrade --install cilium cilium --repo https://helm.cilium.io --version 1.20.0 --namespace kube-system --create-namespace --atomic --wait --values "$values"
      kubectl --context "$context" -n kube-system rollout status ds/cilium --timeout=10m
      kubectl --context "$context" -n kube-system rollout status ds/cilium-envoy --timeout=10m
      kubectl --context "$context" -n kube-system rollout status deploy/cilium-operator --timeout=10m
    fi
    ;;
  bootstrap-argocd)
    cluster=${2:-backbone}; test "$cluster" = backbone; context=${BACKBONE_CONTEXT:-homelab-backbone}
    test "${ALLOW_NEW_CLUSTER_BOOTSTRAP:-}" = yes
    grep -q '^  clusterCredentials:' "$root/values/argo-cd/backbone.yaml"
    sops --decrypt "$root/nix/secrets/kubernetes/backbone-bootstrap.sops.yaml" | kubectl --context "$context" apply --server-side -f -
    helm --kube-context "$context" upgrade --install argocd argo-cd --repo https://argoproj.github.io/argo-helm --version 10.1.4 --namespace argocd --create-namespace --atomic --wait --values "$root/values/argo-cd/backbone.yaml"
    helm --kube-context "$context" upgrade --install argocd-apps argocd-apps --repo https://argoproj.github.io/argo-helm --version 2.0.5 --namespace argocd --atomic --wait --values "$root/values/argocd-apps/backbone.yaml"
    ;;
  issue-kubeconfig) HOMELAB_REPO_ROOT="$root" "$root/nix/scripts/issue-kubeconfig" "${2:?identity required}" ;;
  *) usage; exit 2 ;;
esac
