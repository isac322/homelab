#!/usr/bin/env bash
set -euo pipefail
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
state=${HOMELAB_STATE_DIR:-"$root/.host-state"}
mkdir -p "$state/baselines" "$state/receipts" "$state/recovery"
chmod 0700 "$state" "$state/baselines" "$state/receipts" "$state/recovery"

usage() {
  cat <<'EOF'
Usage: homelab-host <command> [arguments]
  inventory
  bootstrap-host <host>
  baseline <host>              Capture the current adoption baseline
  storage-impact <host>        Read-only democratic-csi consumer inventory
  onboard-k3s-node <host> --token-source <existing-host>
  reconcile <host>             Idempotently converge an active Nix-owned host
  prepare <host>
  activate <host>
  reboot <host>
  reboot-verify <host>
  commit <host>
  restore-host <host>
  rollback <host> <system-manager-generation>
  deploy <host>                 Alias for prepare; activation remains explicit
  verify-host <host> [--baseline <file>]
  verify-legacy-cleanup <host>
  reconcile-distro-packages <host> [--purge]
  check-bootstrap
  bootstrap-k3s <backbone>
  bootstrap-argocd <backbone>
  issue-kubeconfig <identity>
EOF
}

nix_eval() { nix --extra-experimental-features 'nix-command flakes' eval "$@"; }
system_manager_source=github:numtide/system-manager/48d47346e0c6ad05b6c869ea92649c47723d1cfc
host_field() { nix_eval --raw "$root#topology.nodes.$1.$2"; }
remote() { local host=$1; shift; ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$(host_field "$host" sshTarget)" "$@"; }
preserve_nas_state() {
  local host=$1 value
  value=$(nix_eval --json "$root#topology.nodes.$host.preserveNasState") || {
    echo "$host preserveNasState could not be evaluated" >&2
    return 1
  }
  case "$value" in
    true|false) printf '%s\n' "$value" ;;
    *) echo "$host preserveNasState is not boolean: $value" >&2; return 1 ;;
  esac
}
storage_recovery_required() {
  local host=$1 preserve iscsi_client
  preserve=$(preserve_nas_state "$host") || return 1
  iscsi_client=$(nix_eval --json "$root#topology.nodes.$host.iscsiClient") || {
    echo "$host iscsiClient could not be evaluated" >&2
    return 1
  }
  case "$iscsi_client" in
    true|false) ;;
    *) echo "$host iscsiClient is not boolean: $iscsi_client" >&2; return 1 ;;
  esac
  if [ "$preserve" = true ] || [ "$iscsi_client" = true ]; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}
manage_firewall_rules() { nix_eval --json "$root#systemConfigs.$1.config.homelab.firewall.manageRules"; }
receipt_nas_baseline() { jq -r '.nasBaseline // empty' "$(receipt "$1")"; }

assert_preservation_plan_safe() {
  local host=$1 config_attribute=${2:-$1} names name preserve
  preserve=$(preserve_nas_state "$host") || return 1
  [ "$preserve" = true ] || return 0
  [ "$(nix_eval --json "$root#systemConfigs.$config_attribute.config.homelab.firewall.manageRules")" = false ] || {
    echo "$host preservation requires $config_attribute homelab.firewall.manageRules=false" >&2
    return 1
  }
  names=$(nix_eval --json "$root#systemConfigs.$config_attribute.config.environment.etc" --apply builtins.attrNames | jq -r '.[]')
  while IFS= read -r name; do
    case "$name" in
      systemd/system/netfilter-persistent.service.d/50-homelab-order.conf)
        continue
        ;;
      zfs|zfs/*|default/zfs|rtslib-fb-target|rtslib-fb-target/*|target|target/*|samba|samba/*|default/samba|\
      exports|exports.d|exports.d/*|nfs.conf|idmapd.conf|default/nfs-common|default/nfs-kernel-server|\
      ssh/authorized_keys.d/democratic-csi|sudoers.d/democratic-csi|iptables/rules.v4|iptables/iptables.rules|homelab/firewall.rules|\
      crontab|cron.d|cron.d/*|cron.daily|cron.daily/*|cron.hourly|cron.hourly/*|cron.monthly|cron.monthly/*|cron.weekly|cron.weekly/*|\
      systemd/system/*zfs*|systemd/system/target.service*|systemd/system/targetclid.service*|systemd/system/rtslib-fb-targetctl.service*|\
      systemd/system/smbd.service*|systemd/system/nmbd.service*|systemd/system/samba.service*|systemd/system/nfs-server.service*|\
      systemd/system/nfs-kernel-server.service*|systemd/system/cron.service*|systemd/system/crond.service*|\
      systemd/system/iptables.service*|systemd/system/netfilter-persistent.service*)
        echo "$host Nix generation would own preserved NAS path /etc/$name" >&2
        return 1
        ;;
    esac
  done <<< "$names"
  for attribute in users.users users.groups; do
    names=$(nix_eval --json "$root#systemConfigs.$config_attribute.config.$attribute" --apply builtins.attrNames | jq -r '.[]')
    if grep -Fxq democratic-csi <<< "$names"; then
      echo "$host Nix generation would own the preserved democratic-csi identity through $attribute" >&2
      return 1
    fi
  done
  names=$(nix_eval --json "$root#systemConfigs.$config_attribute.config.systemd.services" --apply builtins.attrNames | jq -r '.[]')
  while IFS= read -r name; do
    case "$name" in
      *zfs*|*rtslib*|*targetcli*|target|smbd|nmbd|samba|nfs-server|nfs-kernel-server|cron|crond)
        echo "$host Nix generation would own preserved NAS service $name" >&2
        return 1
        ;;
    esac
  done <<< "$names"
}

normalize_nas_manifest() {
  local input=$1 output=$2 work nonpath paths
  work="${output}.normalize.$$"
  rm -rf "$work"
  mkdir -m 0700 "$work"
  nonpath="$work/nonpath"
  paths="$work/paths"
  : > "$nonpath"
  : > "$paths"
  chmod 0600 "$nonpath" "$paths"
  if ! awk -v nonpath="$nonpath" -v paths="$paths" '
    function fail(message) {
      print "NAS manifest normalization failed: " message > "/dev/stderr"
      failed = 1
      exit 2
    }
    /^path=/ {
      records[++record_count] = $0
      prefix = "path=/sys/kernel/config/target/core/"
      if (index($0, prefix) == 1 && $0 ~ /\|type=directory\|/) {
        remainder = substr($0, length(prefix) + 1)
        if (remainder ~ /^iblock_[0-9]+\//) {
          split(remainder, components, "/")
          hba = components[1]
          object = components[2]
          sub(/\|.*/, "", object)
          if (objects[hba] != "" && objects[hba] != object)
            fail(hba " contains multiple storage objects")
          objects[hba] = object
        }
      }
      next
    }
    { print >> nonpath }
    END {
      if (failed)
        exit 2
      for (record_index = 1; record_index <= record_count; record_index++) {
        line = records[record_index]
        if (match(line, /\/core\/iblock_[0-9]+(\/|\|)/)) {
          matched = substr(line, RSTART, RLENGTH)
          hba = matched
          sub(/^\/core\//, "", hba)
          sub(/[\/|]$/, "", hba)
          if (objects[hba] != "") {
            separator = substr(matched, length(matched), 1)
            replacement = "/core/iblock[" objects[hba] "]" separator
            line = substr(line, 1, RSTART - 1) replacement substr(line, RSTART + RLENGTH)
          }
        }
        if (line ~ /^path=\/sys\/kernel\/config\/target\/core\/alua\/lu_gps\/default_lu_gp\/members\|/ ||
            line ~ /^path=\/sys\/kernel\/config\/target\/core\/iblock\[[^]]+\]\/hba_info\|/ ||
            line ~ /^path=\/sys\/kernel\/config\/target\/core\/iblock\[[^]]+\]\/[^\/|]+\/info\|/ ||
            (line ~ /^path=\/sys\/kernel\/config\/target\/iscsi\// &&
             line ~ /\/tpgt_[0-9]+\/lun\/lun_[0-9]+\/[^\/|]+\|type=symbolic link\|/))
          sub(/\|sha256=[^|]*$/, "|sha256=<runtime-index>", line)
        print line >> paths
      }
    }
  ' "$input"; then
    rm -rf "$work"
    return 1
  fi
  if ! LC_ALL=C sort "$paths" >> "$nonpath" || ! mv -f "$nonpath" "$output"; then
    rm -rf "$work"
    return 1
  fi
  rm -rf "$work"
}


verify_nas_baseline() {
  local host=$1 baseline=$2 wait=${3:-no} manifest script checksum tmp baseline_normalized current_normalized attempt=1 limit=1 preserve
  preserve=$(preserve_nas_state "$host") || return 1
  [ "$preserve" = true ] || return 0
  [ -n "$baseline" ] || {
    echo "$host preservation receipt has no NAS baseline" >&2
    return 1
  }
  if [ -d "$baseline" ]; then
    manifest="$baseline/manifest.txt"
    script="$baseline/manifest-remote"
    checksum="$baseline/manifest.sha256"
  else
    echo "$host NAS baseline is not an inventory directory: $baseline" >&2
    return 1
  fi
  test -s "$manifest" && test -s "$script" && test -s "$checksum" || {
    echo "$host NAS baseline is incomplete: $baseline" >&2
    return 1
  }
  (
    cd "$baseline"
    sha256sum -c manifest.sha256 >/dev/null
  ) || {
    echo "$host stored NAS baseline checksum is invalid" >&2
    return 1
  }
  if [ "$wait" = yes ]; then limit=60; fi
  tmp=$(mktemp "$state/baselines/.$host-live.XXXXXX")
  baseline_normalized="$tmp.baseline"
  current_normalized="$tmp.current"
  if ! normalize_nas_manifest "$manifest" "$baseline_normalized"; then
    echo "$host stored NAS baseline could not be normalized" >&2
    rm -f "$tmp" "$baseline_normalized" "$current_normalized"
    return 1
  fi
  while [ "$attempt" -le "$limit" ]; do
    if remote "$host" 'sudo -n bash -s' < "$script" > "$tmp" \
      && normalize_nas_manifest "$tmp" "$current_normalized" \
      && cmp -s "$baseline_normalized" "$current_normalized"; then
      rm -f "$tmp" "$baseline_normalized" "$current_normalized"
      return 0
    fi
    if [ "$attempt" -lt "$limit" ]; then sleep 2; fi
    attempt=$((attempt + 1))
  done
  echo "$host external NAS state differs from $baseline" >&2
  printf 'baseline-sha256=%s current-sha256=%s\n' \
    "$(sha256sum "$manifest" | awk '{print $1}')" \
    "$(sha256sum "$tmp" | awk '{print $1}')" >&2
  rm -f "$tmp" "$baseline_normalized" "$current_normalized"
  return 1
}

verify_receipt_nas_baseline() {
  local host=$1 wait=${2:-no} baseline preserve
  preserve=$(preserve_nas_state "$host") || return 1
  [ "$preserve" = true ] || return 0
  baseline=$(receipt_nas_baseline "$host")
  verify_nas_baseline "$host" "$baseline" "$wait"
}
receipt() { printf '%s/receipts/%s.json' "$state" "$1"; }
current_revision() { git rev-parse HEAD 2>/dev/null || printf unknown; }
committed_flake() {
  local attribute=$1 repository revision
  git diff --quiet && git diff --cached --quiet || {
    echo "host rollout requires a clean committed worktree" >&2
    return 1
  }
  revision=$(current_revision)
  repository=$(git remote get-url origin)
  case "$repository" in
    git@github.com:*) repository="https://github.com/${repository#git@github.com:}" ;;
    https://github.com/*) ;;
    *)
      echo "unsupported origin URL for remote Nix build: $repository" >&2
      return 1
      ;;
  esac
  printf 'git+%s?rev=%s#%s\n' "$repository" "$revision" "$attribute"
}
remote_system_manager() {
  local host=$1 command argument
  shift
  printf -v command '%q --extra-experimental-features %q --accept-flake-config run %q --' \
    /nix/var/nix/profiles/default/bin/nix 'nix-command flakes' "$system_manager_source"
  for argument in "$@"; do
    printf -v command '%s %q' "$command" "$argument"
  done
  remote "$host" "$command"
}
current_remote_generation() {
  remote "$1" 'sudo -n sh -ceu '\''
    profile=/nix/var/nix/profiles/system-manager-profiles/system-manager
    nix_env=/nix/var/nix/profiles/default/bin/nix-env
    test -x "$nix_env"
    test -e "$profile" || exit 0
    generations=$("$nix_env" --profile "$profile" --list-generations)
    printf "%s\n" "$generations" | awk "/\(current\)/ {print \$1}"
  '\'''
}
register_system() {
  local host=$1 attribute=$2 flake
  flake=$(committed_flake "$attribute")
  if ! remote_system_manager "$host" register --flake "$flake" --sudo >&2; then
    echo "failed to register system-manager generation for $host from $flake" >&2
    return 1
  fi
  remote "$host" 'sudo -n readlink -f /nix/var/nix/profiles/system-manager-profiles/system-manager'
}
activate_registered_system() {
  local host=$1 rc=0
  remote "$host" 'sudo -n /nix/var/nix/profiles/system-manager-profiles/system-manager/bin/activate' || rc=$?
  if ! remote "$host" 'sudo -n rm -f /run/homelab-k3s-firewall-reconcile.defer'; then
    test "$rc" -ne 0 || return 1
  fi
  return "$rc"
}
assert_iptables_nft_backend() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    for command in iptables iptables-save iptables-restore; do
      path=$(command -v "$command") || {
        echo "$command is required" >&2
        exit 1
      }
      version=$("$path" --version)
      case "$version" in
        *"(nf_tables)") ;;
        *)
          echo "$command must use the nf_tables backend; found: $version" >&2
          exit 1
          ;;
      esac
    done
  '\'''
}
reconcile_distro_packages() {
  local host=$1 purge=${2:-no} backend present absent purge_enabled preserve command
  backend=$(host_field "$host" packageBackend)
  present=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.present" | jq -r 'join(" ")')
  absent=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.absent" | jq -r 'join(" ")')
  purge_enabled=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.distroPackages.purgeAbsent")
  preserve=$(preserve_nas_state "$host") || return 1
  if [ "$purge" = yes ] && [ "$purge_enabled" != true ]; then purge=no; fi
  printf -v command 'sudo -n env BACKEND=%q PURGE=%q PRESENT=%q ABSENT=%q PRESERVE_NAS_STATE=%q sh -s' \
    "$backend" "$purge" "$present" "$absent" "$preserve"
  remote "$host" "$command" <<'REMOTE_PACKAGE_RECONCILE'
set -eu
if test "$PRESERVE_NAS_STATE" = true; then
  for package in $PRESENT; do
    case "$package" in ""|*[!A-Za-z0-9+._:-]*) exit 1 ;; esac
    case "$BACKEND" in
      pacman) /usr/bin/pacman -Q "$package" >/dev/null 2>&1 ;;
      apt) test "$(/usr/bin/dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" = "install ok installed" ;;
      *) exit 2 ;;
    esac || {
      echo "$package must be installed outside Nix before preserving this NAS host" >&2
      exit 1
    }
  done
  exit 0
fi
case "$BACKEND" in
  pacman)
    missing=
    for package in $PRESENT; do
      /usr/bin/pacman -Q "$package" >/dev/null 2>&1 || missing="$missing $package"
    done
    if [ -n "$missing" ]; then /usr/bin/pacman --noconfirm --needed -S $missing; fi
    if [ "$PURGE" = yes ]; then
      installed=
      for package in $ABSENT; do
        /usr/bin/pacman -Q "$package" >/dev/null 2>&1 && installed="$installed $package" || true
      done
      if [ -n "$installed" ]; then /usr/bin/pacman --noconfirm -Rns $installed; fi
    fi
    ;;
  apt)
    export DEBIAN_FRONTEND=noninteractive
    missing=
    for package in $PRESENT; do
      status=$(/usr/bin/dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)
      [ "$status" = "install ok installed" ] || missing="$missing $package"
    done
    if [ -n "$missing" ]; then
      policy=/usr/sbin/policy-rc.d
      policy_backup=
      restore_policy() {
        rm -f "$policy"
        if [ -n "$policy_backup" ]; then
          mv "$policy_backup/policy-rc.d" "$policy"
          rmdir "$policy_backup"
        fi
      }
      if [ -e "$policy" ] || [ -L "$policy" ]; then
        policy_backup=$(mktemp -d /run/homelab-policy-rc.d.XXXXXX)
        cp -a "$policy" "$policy_backup/policy-rc.d"
      fi
      printf '#!/bin/sh\nexit 101\n' > "$policy"
      chmod 0755 "$policy"
      trap restore_policy EXIT HUP INT TERM
      /usr/bin/apt-get update
      /usr/bin/apt-get install -y --no-install-recommends $missing
      restore_policy
      trap - EXIT HUP INT TERM
    fi
    if [ "$PURGE" = yes ]; then
      installed=
      for package in $ABSENT; do
        status=$(/usr/bin/dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)
        [ "$status" != "install ok installed" ] || installed="$installed $package"
      done
      if [ -n "$installed" ]; then /usr/bin/apt-get purge -y $installed; fi
    fi
    ;;
  *) echo "unsupported package backend: $BACKEND" >&2; exit 2 ;;
esac
REMOTE_PACKAGE_RECONCILE
}
prepare_native_runtime_handoff() {
  local host=$1 role command
  role=$(host_field "$host" k3sRole 2>/dev/null || true)
  printf -v command 'sudo -n env ROLE=%q sh -s' "$role"
  remote "$host" "$command" <<'REMOTE_NATIVE_HANDOFF'
set -eu
if test "$ROLE" = server || test "$ROLE" = agent; then
  install -m 0600 /dev/null /run/homelab-k3s-firewall-reconcile.defer
fi
legacy_zram=false
for unit in zram-swap.service ksm.service thp-madvise.service; do
  fragment=$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null || true)
  case "$fragment" in
    /etc/systemd/system/*)
      systemctl disable --now "$unit"
      if test "$unit" = zram-swap.service; then legacy_zram=true; fi
      ;;
  esac
done
if test "$legacy_zram" = true; then
  systemctl stop dev-zram0.swap systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
  if swapon --show=NAME --noheadings | grep -qx /dev/zram0; then swapoff /dev/zram0; fi
  if test -e /sys/block/zram0/disksize && test "$(cat /sys/block/zram0/disksize)" != 0; then
    echo 1 > /sys/block/zram0/reset
  fi
  systemctl reset-failed dev-zram0.swap systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
  ! swapon --show=NAME --noheadings | grep -qx /dev/zram0
  test ! -e /sys/block/zram0/disksize || test "$(cat /sys/block/zram0/disksize)" = 0
fi
REMOTE_NATIVE_HANDOFF
}

sync_wireguard_runtime() {
  local host=$1 interface=$2 command
  printf -v command 'sudo -n sh -s -- %q' "$interface"
  remote "$host" "$command" < "$root/nix/scripts/sync-wireguard-runtime"
}

verify_wireguard_runtime() {
  local host=$1 interface=$2 command
  printf -v command 'sudo -n sh -s -- --check %q' "$interface"
  remote "$host" "$command" < "$root/nix/scripts/sync-wireguard-runtime"
}

apply_native_runtime() {
  local host=$1 default_interface lan_address zram interfaces interface backend firewall_service ssh_service role manage_rules iscsi_client iscsi_login_service command
  assert_iptables_nft_backend "$host"
  default_interface=$(host_field "$host" defaultInterface 2>/dev/null || true)
  lan_address=$(host_field "$host" lanAddress 2>/dev/null || true)
  zram=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.zram")
  interfaces=$(nix_eval --json "$root#topology.nodes.$host.wireguard" | jq -r 'join(" ")')
  backend=$(host_field "$host" packageBackend)
  role=$(host_field "$host" k3sRole 2>/dev/null || true)
  manage_rules=$(manage_firewall_rules "$host")
  iscsi_client=$(nix_eval --json "$root#topology.nodes.$host.iscsiClient")
  if [ "$backend" = pacman ]; then
    firewall_service=iptables.service
    ssh_service=sshd.service
    iscsi_login_service=iscsi.service
  else
    firewall_service=netfilter-persistent.service
    ssh_service=ssh.service
    iscsi_login_service=open-iscsi.service
  fi
  printf -v command \
    'sudo -n env HOST_NAME=%q DEFAULT_INTERFACE=%q STATIC_LAN=%q ZRAM=%q WG_INTERFACES=%q FIREWALL_SERVICE=%q SSH_SERVICE=%q ROLE=%q MANAGE_FIREWALL_RULES=%q ISCSI_CLIENT=%q ISCSI_LOGIN_SERVICE=%q sh -s' \
    "$host" "$default_interface" "$([ -n "$lan_address" ] && [ "$lan_address" != null ] && printf true || printf false)" \
    "$zram" "$interfaces" "$firewall_service" "$ssh_service" "$role" "$manage_rules" "$iscsi_client" "$iscsi_login_service"
  remote "$host" "$command" <<'REMOTE_NATIVE_RUNTIME'
set -eu
systemctl daemon-reload
systemctl enable systemd-networkd.service systemd-resolved.service systemd-timesyncd.service
if test "$MANAGE_FIREWALL_RULES" = true; then systemctl enable "$FIREWALL_SERVICE"; fi
if test "$ISCSI_CLIENT" = true; then
  systemctl enable iscsid.service "$ISCSI_LOGIN_SERVICE"
  systemctl start iscsid.service "$ISCSI_LOGIN_SERVICE"
fi
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl enable homelab-k3s.service
fi
hostnamectl set-hostname "$HOST_NAME"
if command -v locale-gen >/dev/null 2>&1; then locale-gen; fi
systemd-tmpfiles --create --prefix=/etc
systemctl restart systemd-resolved.service
for path in /etc /etc/ssh /etc/ssh/authorized_keys.d; do
  test "$(stat -c '%a %u %g' "$path")" = "755 0 0"
done
sshd -t
systemctl reload "$SSH_SERVICE"
sysctl --system
if test -f /etc/tmpfiles.d/60-homelab-runtime-tuning.conf; then
  systemd-tmpfiles --create /etc/tmpfiles.d/60-homelab-runtime-tuning.conf
fi
for unit in zram-swap.service ksm.service thp-madvise.service; do
  systemctl disable --now "$unit" >/dev/null 2>&1 || true
done
if test "$ZRAM" = true; then
  systemctl start dev-zram0.swap
else
  systemctl stop dev-zram0.swap systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
fi
systemctl restart systemd-networkd.service
networkctl reload
if test "$STATIC_LAN" = true; then networkctl reconfigure "$DEFAULT_INTERFACE"; fi
for interface in $WG_INTERFACES; do
  networkctl reconfigure "$interface"
  ip link show "$interface" >/dev/null
done
systemctl restart systemd-timesyncd.service
attempt=0
while test "$(timedatectl show -p NTPSynchronized --value)" != yes; do
  attempt=$((attempt + 1))
  if test "$attempt" -ge 45; then
    echo "system clock did not synchronize within 90 seconds" >&2
    exit 1
  fi
  sleep 2
done
if test "$MANAGE_FIREWALL_RULES" = true; then
  place_jump() {
    chain=$1 target=$2 position=$3 keep=$3
    iptables --wait -I "$chain" "$position" -j "$target"
    for index in $(iptables -S "$chain" | awk -v target="$target" 'NR > 1 && $(NF - 1) == "-j" && $NF == target { print NR - 1 }' | sort -rn); do
      if test "$index" -eq "$keep"; then continue; fi
      iptables --wait -D "$chain" "$index"
      if test "$index" -lt "$keep"; then keep=$((keep - 1)); fi
    done
  }
  firewall_ordered() {
    iptables -S INPUT | awk '
      /-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { native = NR }
      /-j HOMELAB_INPUT$/ { homelab = NR; count++ }
      END { exit !(native && homelab > native && count == 1) }
    ' \
      && iptables -S FORWARD | awk '
        /-j CILIUM_FORWARD$/ { native = NR }
        /-j HOMELAB_FORWARD$/ { homelab = NR; count++ }
        END { exit !(native && homelab > native && count == 1) }
      '
  }
  iptables-restore --noflush --wait < /etc/homelab/firewall.rules
  iptables -P INPUT DROP
  iptables -P FORWARD DROP
  iptables -P OUTPUT ACCEPT
  input_position=$(iptables -S INPUT | awk '/-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { position = NR } END { print position ? position : 1 }')
  forward_position=$(iptables -S FORWARD | awk '/-j CILIUM_FORWARD$/ { position = NR } END { print position ? position : 1 }')
  place_jump INPUT HOMELAB_INPUT "$input_position"
  place_jump FORWARD HOMELAB_FORWARD "$forward_position"
fi
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl restart homelab-k3s.service
  if test "$ROLE" = server; then
    attempt=0
    until /usr/bin/timeout 5 /usr/local/bin/k3s kubectl get --raw=/readyz >/dev/null 2>&1; do
      attempt=$((attempt + 1))
      if test "$attempt" -ge 60; then
        echo "K3s API did not become ready within 180 seconds" >&2
        exit 1
      fi
      sleep 3
    done
  fi
  if test "$MANAGE_FIREWALL_RULES" = true; then
    attempt=0
    until iptables -S INPUT | grep -Eq -- '-j (CILIUM_INPUT|KUBE-FIREWALL)$' \
      && iptables -S FORWARD | grep -q -- '-j CILIUM_FORWARD$'; do
      attempt=$((attempt + 1))
      if test "$attempt" -ge 60; then
        echo "Cilium feeder chains did not become ready within 180 seconds" >&2
        exit 1
      fi
      sleep 3
    done
    stable=0
    attempt=0
    while test "$stable" -lt 3; do
      if firewall_ordered; then
        stable=$((stable + 1))
      else
        stable=0
        input_position=$(iptables -S INPUT | awk '/-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { position = NR } END { print position }')
        forward_position=$(iptables -S FORWARD | awk '/-j CILIUM_FORWARD$/ { position = NR } END { print position }')
        place_jump INPUT HOMELAB_INPUT "$input_position"
        place_jump FORWARD HOMELAB_FORWARD "$forward_position"
      fi
      attempt=$((attempt + 1))
      if test "$attempt" -ge 60; then
        echo "Cilium and HOMELAB firewall ordering did not stabilize within 120 seconds" >&2
        exit 1
      fi
      sleep 2
    done
  fi
fi
REMOTE_NATIVE_RUNTIME
  for interface in $interfaces; do
    sync_wireguard_runtime "$host" "$interface"
  done
}
capture_runtime_firewall() {
  local host=$1 recovery=$2
  assert_iptables_nft_backend "$host"
  remote "$host" 'sudo -n iptables-save' > "$recovery/firewall-runtime.rules"
  chmod 0600 "$recovery/firewall-runtime.rules"
}
node_iscsi_sessions() {
  local node=$1
  remote "$node" 'sh -seu' <<'REMOTE_ISCSI_SESSIONS'
for path in /sys/class/iscsi_session/session*/targetname; do
  test -f "$path" || continue
  cat "$path"
done | sort -u
REMOTE_ISCSI_SESSIONS
}


storage_impact_json() {
  local host=$1 context directory inventory next node session_lines sessions session_nodes required
  required=$(storage_recovery_required "$host") || return 1
  [ "$required" = true ] || {
    echo "$host has no preserved NAS or iSCSI client recovery scope" >&2
    return 1
  }
  context=${BACKBONE_CONTEXT:-homelab-backbone}
  directory=$(mktemp -d "$state/.storage-impact.XXXXXX")
  inventory="$directory/inventory.json"
  if ! kubectl --context "$context" get pv -o json > "$directory/pvs.json" \
    || ! kubectl --context "$context" get pvc --all-namespaces -o json > "$directory/pvcs.json" \
    || ! kubectl --context "$context" get pods --all-namespaces -o json > "$directory/pods.json" \
    || ! kubectl --context "$context" get volumeattachments.storage.k8s.io -o json > "$directory/volumeattachments.json"; then
    rm -rf "$directory"
    return 1
  fi
  jq -n \
    --slurpfile pvInput "$directory/pvs.json" \
    --slurpfile pvcInput "$directory/pvcs.json" \
    --slurpfile podInput "$directory/pods.json" \
    --slurpfile attachmentInput "$directory/volumeattachments.json" '
      ($pvInput[0].items
        | map(select(((.spec.csi.driver // "") | startswith("org.democratic-csi."))))
        | sort_by(.metadata.name)) as $selectedPvs
      | ($selectedPvs | map(.metadata.name)) as $pvNames
      | ($pvcInput[0].items
        | map(select(.spec.volumeName as $volume | $pvNames | index($volume)))
        | sort_by(.metadata.namespace, .metadata.name)) as $selectedPvcs
      | ($selectedPvcs | map(.metadata.namespace + "/" + .metadata.name)) as $pvcKeys
      | ($selectedPvs
        | map({
            key: .metadata.name,
            value: {
              target: ([
                ((.spec.csi.volumeAttributes // {}) | to_entries[])
                | select((.key | ascii_downcase) | test("iqn|target"))
                | .value
              ] | sort | .[0] // (
                if ((.spec.csi.volumeHandle // "") | startswith("iqn."))
                then .spec.csi.volumeHandle
                else ""
                end
              )),
              portal: ([
                ((.spec.csi.volumeAttributes // {}) | to_entries[])
                | select((.key | ascii_downcase) | test("portal"))
                | .value
              ] | sort | .[0] // "")
            }
          })
        | from_entries) as $pvStorage
      | {
          pvs: ($selectedPvs | map({
            name: .metadata.name,
            uid: .metadata.uid,
            driver: .spec.csi.driver,
            volumeHandle: (.spec.csi.volumeHandle // ""),
            target: $pvStorage[.metadata.name].target,
            portal: $pvStorage[.metadata.name].portal,
            capacity: (.spec.capacity.storage // ""),
            claimNamespace: (.spec.claimRef.namespace // ""),
            claimName: (.spec.claimRef.name // ""),
            claimUid: (.spec.claimRef.uid // "")
          })),
          pvcs: ($selectedPvcs | map({
            namespace: .metadata.namespace,
            name: .metadata.name,
            uid: .metadata.uid,
            volumeName: .spec.volumeName,
            storageClassName: (.spec.storageClassName // "")
          })),
          pods: ($podInput[0].items
            | map(. as $pod
              | ([.spec.volumes[]?
                  | select(.persistentVolumeClaim != null)
                  | ($pod.metadata.namespace + "/" + .persistentVolumeClaim.claimName)]
                | map(select(. as $claim | $pvcKeys | index($claim)))
                | sort) as $claims
              | select(($claims | length) > 0)
              | {
                  namespace: .metadata.namespace,
                  name: .metadata.name,
                  uid: .metadata.uid,
                  nodeName: (.spec.nodeName // ""),
                  phase: (.status.phase // ""),
                  ready: (any(.status.conditions[]?; .type == "Ready" and .status == "True")),
                  claims: $claims
                })
            | sort_by(.namespace, .name)),
          volumeAttachments: ($attachmentInput[0].items
            | map(. as $attachment
              | select(.spec.source.persistentVolumeName as $volume | $pvNames | index($volume))
              | {
                  name: .metadata.name,
                  uid: .metadata.uid,
                  attacher: .spec.attacher,
                  pvName: .spec.source.persistentVolumeName,
                  nodeName: .spec.nodeName,
                  attached: (.status.attached // false),
                  target: ([
                    (.status.attachmentMetadata // {})
                    | to_entries[]
                    | select((.key | ascii_downcase) | test("iqn|target"))
                    | .value
                  ] | sort | .[0] // $pvStorage[$attachment.spec.source.persistentVolumeName].target),
                  portal: ([
                    (.status.attachmentMetadata // {})
                    | to_entries[]
                    | select((.key | ascii_downcase) | test("portal"))
                    | .value
                  ] | sort | .[0] // $pvStorage[$attachment.spec.source.persistentVolumeName].portal)
                })
            | sort_by(.pvName, .nodeName, .name)),
          sessions: []
        }
    ' > "$inventory"
  if ! session_nodes=$(
    {
      jq -r '[.volumeAttachments[].nodeName, .pods[].nodeName] | map(select(length > 0)) | unique[]' "$inventory"
      nix_eval --json "$root#topology.nodes" | jq -r 'to_entries[] | select(.value.iscsiClient == true) | .key'
    } | sort -u
  ); then
    rm -rf "$directory"
    return 1
  fi
  while IFS= read -r node; do
    [ -n "$node" ] || continue
    session_lines=$(node_iscsi_sessions "$node") || {
      rm -rf "$directory"
      return 1
    }
    sessions=$(printf '%s\n' "$session_lines" | jq -Rsc 'split("\n") | map(select(length > 0)) | sort')
    next="$inventory.new"
    jq --arg node "$node" --argjson targets "$sessions" \
      '.sessions += [{nodeName:$node,targets:$targets}] | .sessions |= sort_by(.nodeName)' \
      "$inventory" > "$next"
    mv -f "$next" "$inventory"
  done <<< "$session_nodes"
  cat "$inventory"
  rm -rf "$directory"
}

capture_storage_impact() {
  local host=$1 output=$2 directory name
  storage_impact_json "$host" > "$output"
  if ! jq -e '
    all(.pods[];
      .phase == "Succeeded"
      or .phase == "Failed"
      or (.phase == "Running" and .ready == true))
  ' "$output" >/dev/null; then
    rm -f "$output"
    echo "$host has unready democratic-csi storage consumers; recover them before prepare" >&2
    return 1
  fi
  directory=$(dirname "$output")
  name=$(basename "$output")
  (
    cd "$directory"
    sha256sum "$name" > "$name.sha256"
  )
  chmod 0600 "$output" "$output.sha256"
}

verify_storage_inventory_integrity() {
  local host=$1 inventory=$2 directory name
  test -s "$inventory" && test -s "$inventory.sha256" || {
    echo "$host captured democratic-csi inventory or checksum is missing" >&2
    return 1
  }
  directory=$(dirname "$inventory")
  name=$(basename "$inventory")
  (
    cd "$directory"
    sha256sum -c "$name.sha256" >/dev/null
  ) || {
    echo "$host captured democratic-csi inventory checksum is invalid" >&2
    return 1
  }
}

verify_storage_recovery() {
  local host=$1 inventory=$2 wait=${3:-no} current deadline=0 remaining capture_timeout required
  required=$(storage_recovery_required "$host") || return 1
  [ "$required" = true ] || return 0
  verify_storage_inventory_integrity "$host" "$inventory" || return 1
  if [ "$wait" = yes ]; then deadline=$((SECONDS + 600)); fi
  current=$(mktemp "$state/.storage-recovery.XXXXXX")
  while :; do
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      rm -f "$current"
      return 1
    fi
    capture_timeout=90
    if [ "$wait" = yes ]; then
      remaining=$((deadline - SECONDS))
      [ "$remaining" -gt 0 ] || break
      if [ "$remaining" -lt "$capture_timeout" ]; then capture_timeout=$remaining; fi
    fi
    if timeout --foreground --kill-after=10s "${capture_timeout}s" "$0" storage-impact "$host" > "$current" \
      && jq -e -n --slurpfile captured "$inventory" --slurpfile live "$current" '
        def pvBindings:
          map({name,uid,driver,volumeHandle,target,portal,claimNamespace,claimName,claimUid});
        def pvcBindings:
          map({namespace,name,uid,volumeName});
        ($captured[0].pods
          | map(select(.phase != "Succeeded" and .phase != "Failed") | .claims[])
          | unique) as $expectedClaims
        | ($live[0].pods
          | map(select(any(.claims[]; . as $claim | $expectedClaims | index($claim))))) as $consumers
        | ($captured[0].pvcs
          | map(select((.namespace + "/" + .name) as $claim | $expectedClaims | index($claim))
            | .volumeName)
          | unique) as $expectedPvs
        | ($live[0].volumeAttachments
          | map(select(.attached == true)
            | select(.pvName as $volume | $expectedPvs | index($volume)))) as $attachments
        | ($captured[0].pvs | map(.name)) as $capturedPvNames
        | ($captured[0].pvcs | map(.namespace + "/" + .name)) as $capturedPvcNames
        | ($captured[0].pvs | pvBindings)
          == ($live[0].pvs
            | map(select(.name as $name | $capturedPvNames | index($name)))
            | pvBindings)
          and ($captured[0].pvcs | pvcBindings)
          == ($live[0].pvcs
            | map(select((.namespace + "/" + .name) as $claim | $capturedPvcNames | index($claim)))
            | pvcBindings)
          and all($expectedClaims[];
            . as $claim
            | any($consumers[];
                (.claims | index($claim)) != null
                and .phase == "Running"
                and .ready == true))
          and all($consumers[];
            .phase == "Succeeded"
            or .phase == "Failed"
            or (.phase == "Running" and .ready == true))
          and all($expectedPvs[];
            . as $volume
            | any($attachments[];
                .pvName == $volume
                and .nodeName != ""
                and .target != ""))
          and all($attachments[];
            . as $attachment
            | any($live[0].sessions[];
                .nodeName == $attachment.nodeName
                and (.targets | index($attachment.target)) != null))
      ' >/dev/null
    then
      rm -f "$current"
      return 0
    fi
    [ "$wait" = yes ] || break
    remaining=$((deadline - SECONDS))
    [ "$remaining" -gt 2 ] || break
    sleep 2
  done
  echo "$host preserved storage consumers did not recover to the captured bindings, readiness, attachments, and iSCSI sessions within the guarded interval" >&2
  rm -f "$current"
  return 1
}

capture_managed_recovery() {
  local host=$1 recovery
  recovery="$state/recovery/$host-reconcile-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -m 0700 "$recovery"
  remote "$host" 'sudo -n tar -C / -cf - etc' > "$recovery/etc-state.tar"
  chmod 0600 "$recovery/etc-state.tar"
  printf '%s\n' "$recovery"
}
restore_previous_secrets() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    base=/var/lib/homelab-secrets
    test -L "$base/previous" || exit 0
    abandoned=$(readlink "$base/active" 2>/dev/null || true)
    restore=$(readlink "$base/previous")
    name=${restore#generations/}
    case "$name" in ""|.|..|*/*) exit 1 ;; esac
    test "$restore" = "generations/$name"
    test -d "$base/$restore"
    rm -f "$base/active.new"
    ln -s "$restore" "$base/active.new"
    mv -Tf "$base/active.new" "$base/active"
    if test -n "$abandoned" && test "$abandoned" != "$restore"; then
      name=${abandoned#generations/}
      case "$name" in ""|.|..|*/*) exit 1 ;; esac
      test "$abandoned" = "generations/$name"
      rm -rf -- "$base/$abandoned"
    fi
    rm -f "$base/previous"
  '\'''
}
cleanup_legacy_files() {
  local host=$1
  remote "$host" 'sudo -n sh -ceu '\''
    for unit in k3s.service k3s-agent.service zram-swap.service ksm.service thp-madvise.service; do
      systemctl disable --now "$unit" >/dev/null 2>&1 || true
      fragment=$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null || true)
      case "$fragment" in /etc/systemd/system/*) rm -f "$fragment" ;; esac
      rm -f "/etc/systemd/system/$unit"
      for link in \
        /etc/systemd/system/*.wants/"$unit" \
        /etc/systemd/system/*.requires/"$unit"
      do
        if test -e "$link" || test -L "$link"; then
          rm -f -- "$link"
        fi
      done
      rm -f "/etc/systemd/system/$unit.env"
      rm -rf "/etc/systemd/system/$unit.d"
    done
    systemctl daemon-reload
  '\'''
}
verify_legacy_cleanup() {
  local host=$1 role require_k3s_binary=false
  role=$(nix_eval --json "$root#topology.nodes.$host.k3sRole") || return 1
  case "$role" in
    '"server"'|'"agent"') require_k3s_binary=true ;;
    null) ;;
    *)
      echo "$host has invalid k3sRole: $role" >&2
      return 1
      ;;
  esac
  remote "$host" "sudo -n env REQUIRE_K3S_BINARY=$require_k3s_binary sh -seu" <<'REMOTE_VERIFY_LEGACY_CLEANUP'
    if test "$REQUIRE_K3S_BINARY" = true; then
      test -x /usr/local/bin/k3s
    fi
    assert_path_absent() {
      test ! -e "$1"
      test ! -L "$1"
    }
    for unit in k3s.service k3s-agent.service zram-swap.service ksm.service thp-madvise.service; do
      test -z "$(systemctl show -p FragmentPath --value "$unit" 2>/dev/null || true)"
      assert_path_absent "/etc/systemd/system/$unit"
      assert_path_absent "/etc/systemd/system/$unit.env"
      assert_path_absent "/etc/systemd/system/$unit.d"
      for link in \
        /etc/systemd/system/*.wants/"$unit" \
        /etc/systemd/system/*.requires/"$unit"
      do
        assert_path_absent "$link"
      done
    done
REMOTE_VERIFY_LEGACY_CLEANUP
}
rollback_state() {
  "$root/nix/scripts/k3s-handoff" state "$1"
}
sync_completed_rollback() {
  local host=$1 file phase rollback_status previous legacy recovery secret_generation nas_baseline storage_inventory
  file=$(receipt "$host")
  test -s "$file" || return 0
  phase=$(jq -r '.phase // empty' "$file")
  case "$phase" in
    prepared|activated|rebooting|reboot-verified|rolled-back) ;;
    *) return 0 ;;
  esac
  rollback_status=$(rollback_state "$host") || return 1
  case "$rollback_status" in
    armed)
      if [ "$phase" = rolled-back ]; then
        echo "$host receipt is rolled-back but remote recovery is armed" >&2
        return 1
      fi
      return 0
      ;;
    restored)
      verify_receipt_nas_baseline "$host" yes || return 1
      if [ "$phase" != rolled-back ]; then
        previous=$(jq -r '.previousGeneration // empty' "$file")
        legacy=$(jq -r '.legacyK3sUnit // empty' "$file")
        recovery=$(jq -r '.recoveryDirectory // empty' "$file")
        secret_generation=$(jq -r '.secretGeneration // empty' "$file")
        nas_baseline=$(jq -r '.nasBaseline // empty' "$file")
        storage_inventory=$(jq -r '.storageInventory // empty' "$file")
        write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation" "" "" "$nas_baseline" "$storage_inventory" || return 1
      fi
      if ! "$root/nix/scripts/k3s-handoff" cleanup-restored "$host"; then
        echo "$host completed rollback cleanup failed; receipt is rolled-back and recovery remains retryable" >&2
        return 1
      fi
      echo "$host completed watchdog rollback synchronized locally" >&2
      ;;
    restoring)
      echo "$host rollback is still restoring; inspect nix run .#k3s-handoff -- status $host" >&2
      return 1
      ;;
    absent)
      case "$phase" in
        prepared|rolled-back) return 0 ;;
      esac
      echo "$host rollback state is absent for receipt phase $phase" >&2
      return 1
      ;;
    *)
      echo "$host reported invalid rollback state: $rollback_status" >&2
      return 1
      ;;
  esac
}
require_receipt_phase() {
  local host=$1 phase=$2 wait=${3:-no} file actual generation active store_path active_store
  sync_completed_rollback "$host" || return 1
  file=$(receipt "$host")
  test -s "$file" || {
    echo "$host migration receipt is missing" >&2
    return 1
  }
  actual=$(jq -r '.phase // empty' "$file")
  test "$actual" = "$phase" || {
    echo "$host receipt phase is ${actual:-missing}; expected $phase" >&2
    return 1
  }
  test "$(jq -r .revision "$file")" = "$(current_revision)" || {
    echo "$host receipt belongs to a different Git revision; rerun prepare" >&2
    return 1
  }
  generation=$(jq -r '.secretGeneration // empty' "$file")
  if [ -n "$generation" ]; then
    active=$(remote "$host" 'sudo -n readlink /var/lib/homelab-secrets/active')
    test "$active" = "generations/$generation" || {
      echo "$host active secret generation changed after prepare" >&2
      return 1
    }
  fi
  store_path=$(jq -r '.storePath // empty' "$file")
  if [ -n "$store_path" ]; then
    active_store=$(remote "$host" 'sudo -n readlink -f /nix/var/nix/profiles/system-manager-profiles/system-manager')
    test "$active_store" = "$store_path" || {
      echo "$host system-manager generation changed after prepare" >&2
      return 1
    }
  fi
  verify_receipt_nas_baseline "$host" "$wait"
}
current_k3s() {
  local raw version
  raw=$(remote "$1" 'sudo -n sh -ceu '\''
    if test -x /usr/local/bin/k3s; then
      exec /usr/local/bin/k3s --version
    fi
    state=$(systemctl is-active homelab-k3s.service 2>/dev/null || true)
    if test "$state" = active; then
      pid=$(systemctl show homelab-k3s.service -p MainPID --value)
      test -n "$pid" && test "$pid" != 0
      executable=$(readlink "/proc/$pid/exe")
      exec "$executable" --version
    fi
    if test -d /var/lib/rancher/k3s; then
      echo "K3s state exists but no running binary can be identified" >&2
      exit 1
    fi
    printf "absent\n"
  '\''')
  if [ "$raw" = absent ]; then
    printf 'absent\n'
    return
  fi
  version=$(printf '%s\n' "$raw" | sed -n 's/^k3s version v\([^ ]*\).*/\1/p')
  test -n "$version" || {
    echo "unable to parse the running K3s version on $1" >&2
    return 1
  }
  printf '%s\n' "$version"
}
render_receipt() {
  local output=$1 host=$2 phase=$3 previous=${4-} legacy=${5:-} recovery=${6:-} secret_generation=${7:-} store_path=${8:-} boot_id=${9:-} nas_baseline=${10:-} storage_inventory=${11:-}
  jq -n --arg host "$host" --arg phase "$phase" --arg revision "$(current_revision)" --arg previous "$previous" --arg legacy "$legacy" --arg recovery "$recovery" --arg secretGeneration "$secret_generation" --arg storePath "$store_path" --arg bootId "$boot_id" --arg nasBaseline "$nas_baseline" --arg storageInventory "$storage_inventory" --arg time "$(date -u +%FT%TZ)" '{host:$host,phase:$phase,revision:$revision,previousGeneration:$previous,legacyK3sUnit:$legacy,recoveryDirectory:$recovery,secretGeneration:$secretGeneration,storePath:$storePath,bootId:$bootId,nasBaseline:$nasBaseline,storageInventory:$storageInventory,time:$time}' > "$output"
  chmod 0600 "$output"
}
write_receipt() {
  local host=$1 output
  output="$(receipt "$host").new"
  render_receipt "$output" "$@"
  mv -f "$output" "$(receipt "$host")"
}
record_rolled_back() {
  local host=$1 previous=${2-} legacy=${3:-} recovery=${4:-} secret_generation=${5:-} file nas_baseline storage_inventory
  file=$(receipt "$host")
  nas_baseline=$(jq -r '.nasBaseline // empty' "$file" 2>/dev/null || true)
  storage_inventory=$(jq -r '.storageInventory // empty' "$file" 2>/dev/null || true)
  verify_receipt_nas_baseline "$host" yes || return 1
  write_receipt "$host" rolled-back "$previous" "$legacy" "$recovery" "$secret_generation" "" "" "$nas_baseline" "$storage_inventory" || return 1
  if ! "$root/nix/scripts/k3s-handoff" cleanup-restored "$host"; then
    echo "$host rollback is recorded locally, but recovery artifact cleanup failed; rerun a phase-gated command or nix run .#k3s-handoff -- cleanup-restored $host" >&2
    return 1
  fi
}
rollback_armed_host() {
  local host=$1 attempt=1
  verify_receipt_nas_baseline "$host" || return 1
  while ! "$root/nix/scripts/k3s-handoff" restore "$host"; do
    if [ "$attempt" -ge 2 ]; then
      echo "$host rollback restore failed after $attempt attempts; recovery remains armed" >&2
      return 1
    fi
    attempt=$((attempt + 1))
    echo "$host rollback restore failed; retrying once" >&2
  done
  verify_receipt_nas_baseline "$host" yes
}
assert_host_rebooted() {
  local host=$1 file recorded_boot_id active_boot_id
  file=$(receipt "$host")
  recorded_boot_id=$(jq -r '.bootId // empty' "$file")
  test -n "$recorded_boot_id" || {
    echo "$host reboot receipt has no pre-reboot boot ID; run prepare and activate again" >&2
    return 1
  }
  active_boot_id=$(remote "$host" 'cat /proc/sys/kernel/random/boot_id') || return 1
  test -n "$active_boot_id" || {
    echo "$host returned an empty boot ID" >&2
    return 1
  }
  test "$active_boot_id" != "$recorded_boot_id" || {
    echo "$host has not rebooted since the reboot receipt was written" >&2
    return 1
  }
}
reboot_host() {
  local host=$1 file phase previous legacy recovery secret_generation store_path boot_id active_boot_id nas_baseline storage_inventory rc
  sync_completed_rollback "$host" || return 1
  file=$(receipt "$host")
  test -s "$file" || {
    echo "$host migration receipt is missing" >&2
    return 1
  }
  phase=$(jq -r '.phase // empty' "$file")
  verify_receipt_nas_baseline "$host" || return 1
  case "$phase" in
    activated|rebooting)
      if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
        sync_completed_rollback "$host" || true
        return 1
      fi
      ;;
    *)
      echo "$host receipt phase is ${phase:-missing}; expected activated or rebooting" >&2
      return 1
      ;;
  esac
  require_receipt_phase "$host" "$phase" || return 1
  file=$(receipt "$host")
  case "$phase" in
    activated)
      previous=$(jq -r '.previousGeneration // empty' "$file")
      legacy=$(jq -r '.legacyK3sUnit // empty' "$file")
      recovery=$(jq -r '.recoveryDirectory // empty' "$file")
      secret_generation=$(jq -r '.secretGeneration // empty' "$file")
      store_path=$(jq -r '.storePath // empty' "$file")
      nas_baseline=$(jq -r '.nasBaseline // empty' "$file")
      storage_inventory=$(jq -r '.storageInventory // empty' "$file")
      boot_id=$(remote "$host" 'cat /proc/sys/kernel/random/boot_id') || return 1
      test -n "$boot_id" || {
        echo "$host returned an empty boot ID" >&2
        return 1
      }
      write_receipt "$host" rebooting "$previous" "$legacy" "$recovery" "$secret_generation" "$store_path" "$boot_id" "$nas_baseline" "$storage_inventory" || return 1
      ;;
    rebooting)
      boot_id=$(jq -r '.bootId // empty' "$file")
      test -n "$boot_id" || {
        echo "$host reboot receipt has no pre-reboot boot ID; run prepare and activate again" >&2
        return 1
      }
      active_boot_id=$(remote "$host" 'cat /proc/sys/kernel/random/boot_id') || return 1
      test -n "$active_boot_id" || {
        echo "$host returned an empty boot ID" >&2
        return 1
      }
      if [ "$active_boot_id" != "$boot_id" ]; then
        echo "$host already rebooted; run reboot-verify" >&2
        return 1
      fi
      ;;
  esac
  rc=0
  remote "$host" 'sudo -n systemctl --no-block reboot' || rc=$?
  case "$rc" in
    0|255) ;;
    *)
      echo "$host reboot request failed with exit $rc; the rebooting receipt is retryable" >&2
      return "$rc"
      ;;
  esac
}
restore_host() {
  local host=$1 receipt_file phase rollback_status previous legacy recovery secret_generation
  receipt_file=$(receipt "$host")
  phase=$(jq -r '.phase // empty' "$receipt_file" 2>/dev/null)
  case "$phase" in
    prepared|activated|rebooting|reboot-verified) ;;
    *) echo "$host has no migration recovery to restore" >&2; return 1 ;;
  esac
  rollback_status=$(rollback_state "$host") || return 1
  case "$rollback_status" in
    armed|restoring|restored) ;;
    absent) echo "$host has no remote recovery state to restore" >&2; return 1 ;;
    *) echo "$host reported invalid rollback state: $rollback_status" >&2; return 1 ;;
  esac
  previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
  legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
  recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
  secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
  rollback_armed_host "$host" || return 1
  record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
}
verify_wireguard_handshake() {
  local host=$1 interface=$2 peer=$3 peer_public=$4 peer_address=$5 command
  printf -v command \
    'sudo -n env WG_INTERFACE=%q WG_PEER=%q WG_PUBLIC=%q WG_ADDRESS=%q sh -s' \
    "$interface" "$peer" "$peer_public" "$peer_address"
  remote "$host" "$command" <<'REMOTE_WIREGUARD_HANDSHAKE'
set -eu
attempt=0
while [ "$attempt" -lt 30 ]; do
  if command -v ping >/dev/null 2>&1; then
    ping -c 1 -W 1 "$WG_ADDRESS" >/dev/null 2>&1 || true
  fi
  handshake=$(wg show "$WG_INTERFACE" latest-handshakes | awk -v key="$WG_PUBLIC" '$1 == key { print $2 }')
  case "${handshake:-}" in ""|*[!0-9]*) handshake=0 ;; esac
  if [ "$handshake" -gt 0 ]; then
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 2
done
echo "$WG_INTERFACE handshake with $WG_PEER ($WG_ADDRESS) did not recover after 30 attempts" >&2
exit 1
REMOTE_WIREGUARD_HANDSHAKE
}

case "${1:-}" in
  inventory) nix_eval --json "$root#topology.nodes" | jq . ;;
  bootstrap-host)
    host=${2:?host required}
    target=$(host_field "$host" sshTarget)
    ssh -tt -o StrictHostKeyChecking=accept-new "$target" "sh -ceu '
      user=\$(id -un)
      if test \"\$(id -u)\" -eq 0; then
        SUDO=
      else
        sudo -v
        SUDO=sudo
        tmp=\$(mktemp /tmp/homelab-admin.XXXXXX)
        trap \"rm -f -- \$tmp\" EXIT HUP INT TERM
        printf \"%s ALL=(ALL) NOPASSWD: ALL\\n\" \"\$user\" > \"\$tmp\"
        chmod 0440 \"\$tmp\"
        sudo visudo -cf \"\$tmp\"
        sudo install -m 0440 \"\$tmp\" /etc/sudoers.d/homelab-admin
        rm -f \"\$tmp\"
        trap - EXIT HUP INT TERM
      fi
      . /etc/os-release
      case \"\$ID\" in
        arch|archarm)
          \$SUDO pacman --noconfirm --needed -S age curl git sudo xz
          ;;
        debian|ubuntu|raspbian)
          \$SUDO apt-get update
          \$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends age ca-certificates curl git sudo xz-utils
          ;;
        *)
          echo \"unsupported bootstrap distribution: \$ID\" >&2
          exit 1
          ;;
      esac
      if ! command -v nix >/dev/null 2>&1 && ! test -x /nix/var/nix/profiles/default/bin/nix; then
        curl --proto \"=https\" --tlsv1.2 -fsSL https://nixos.org/nix/install | sh -s -- --daemon --yes
      fi
      test -x /nix/var/nix/profiles/default/bin/nix || command -v nix >/dev/null
      command -v age-keygen >/dev/null
      command -v git >/dev/null
      sudo -n true
    '"
    ;;
  baseline)
    test "$#" -eq 2 || { usage >&2; exit 2; }
    "$root/nix/scripts/adopt-host" baseline "$2"
    ;;
  storage-impact)
    test "$#" -eq 2 || { usage >&2; exit 2; }
    storage_impact_json "$2"
    ;;
  reconcile)
    host=${2:?host required}
    preserve=$(preserve_nas_state "$host") || exit 1
    [ "$preserve" != true ] || {
      echo "$host preserves an external NAS data plane; use prepare, activate, reboot, reboot-verify, and commit" >&2
      exit 1
    }
    sync_completed_rollback "$host"
    test "$(host_field "$host" lifecycle)" = active || {
      echo "$host must have lifecycle=active before reconciliation" >&2
      exit 1
    }
    legacy_unit=$(remote "$host" 'for unit in k3s.service k3s-agent.service; do test "$(systemctl is-active "$unit" 2>/dev/null || true)" = active && { printf "%s" "$unit"; exit; }; done; true')
    test -z "$legacy_unit" || {
      echo "$host still uses $legacy_unit; use the separate adopt-host migration workflow" >&2
      exit 1
    }
    "$root/nix/scripts/k3s-handoff" preflight "$host" ""
    recovery=$(capture_managed_recovery "$host")
    "$root/nix/scripts/k3s-handoff" snapshot-packages "$host" "$recovery"
    reconcile_distro_packages "$host" no
    assert_iptables_nft_backend "$host"
    previous=$(current_remote_generation "$host")
    test -n "$previous" || {
      echo "$host has no active system-manager generation; use the provisioning or adoption workflow" >&2
      exit 1
    }
    store_path=$(register_system "$host" "$host")
    stage_result=$("$root/nix/scripts/wireguard-secrets" stage-secrets "$host")
    secret_generation=${stage_result#* }
    test -n "$secret_generation" && test "$secret_generation" != "$stage_result"
    capture_runtime_firewall "$host" "$recovery"
    "$root/nix/scripts/k3s-handoff" arm "$host" "$recovery" "$previous" ""
    if ! prepare_native_runtime_handoff "$host" \
      || ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host-while-armed "$host"; then
      if rollback_armed_host "$host"; then
        record_rolled_back "$host" "$previous" "" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    "$root/nix/scripts/k3s-handoff" accept "$host"
    write_receipt "$host" reconciled "$previous" "" "$recovery" "$secret_generation" "$store_path"
    rm -rf "$recovery"
    printf 'reconciled %s at %s\n' "$host" "$(current_revision)"
    ;;
  prepare|deploy)
    host=${2:?host required}
    case "${HOMELAB_K3S_BINARY_PRESENT:-}" in
      ""|true|false) ;;
      *) echo "invalid K3s binary baseline override" >&2; exit 2 ;;
    esac
    sync_completed_rollback "$host"
    assert_preservation_plan_safe "$host"
    legacy_unit=$(remote "$host" 'for unit in k3s.service k3s-agent.service; do test "$(systemctl is-active "$unit" 2>/dev/null || true)" = active && { printf "%s" "$unit"; exit; }; done; true')
    "$root/nix/scripts/k3s-handoff" preflight "$host" "$legacy_unit"
    recovery=$("$root/nix/scripts/adopt-host" "$host")
    if [ -n "${HOMELAB_K3S_BINARY_PRESENT:-}" ]; then
      printf '%s\n' "$HOMELAB_K3S_BINARY_PRESENT" > "$recovery/k3s-binary-present"
      chmod 0600 "$recovery/k3s-binary-present"
    fi
    preserve=$(preserve_nas_state "$host") || exit 1
    storage_required=$(storage_recovery_required "$host") || exit 1
    if [ "$preserve" = true ]; then
      nas_baseline=$(cat "$recovery/baseline-path")
      verify_nas_baseline "$host" "$nas_baseline"
    else
      nas_baseline=
    fi
    if [ "$storage_required" = true ]; then
      storage_inventory="$recovery/storage-consumers.json"
      capture_storage_impact "$host" "$storage_inventory"
    else
      storage_inventory=
    fi
    "$root/nix/scripts/k3s-handoff" snapshot-packages "$host" "$recovery"
    reconcile_distro_packages "$host" no
    assert_iptables_nft_backend "$host"
    previous=$(current_remote_generation "$host")
    store_path=$(register_system "$host" "$host")
    stage_result=$("$root/nix/scripts/wireguard-secrets" stage-secrets "$host")
    secret_generation=${stage_result#* }
    test -n "$secret_generation" && test "$secret_generation" != "$stage_result"
    verify_nas_baseline "$host" "$nas_baseline"
    write_receipt "$host" prepared "$previous" "$legacy_unit" "$recovery" "$secret_generation" "$store_path" "" "$nas_baseline" "$storage_inventory"
    printf 'prepared %s; run activate explicitly\n' "$host"
    ;;
  activate)
    host=${2:?host required}
    require_receipt_phase "$host" prepared
    assert_preservation_plan_safe "$host"
    assert_iptables_nft_backend "$host"
    receipt_file=$(receipt "$host")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    store_path=$(jq -r '.storePath // empty' "$receipt_file")
    nas_baseline=$(jq -r '.nasBaseline // empty' "$receipt_file")
    storage_inventory=$(jq -r '.storageInventory // empty' "$receipt_file")
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    capture_runtime_firewall "$host" "$recovery"
    "$root/nix/scripts/k3s-handoff" arm "$host" "$recovery" "$previous" "$legacy"
    if [ "$role" = server ] && remote "$host" 'sudo -n test -d /var/lib/rancher/k3s/server/db'; then
      if ! remote "$host" 'sudo -n sh -eu' > "$recovery/k3s-cold-state.tar" <<'REMOTE_K3S_COLD_BACKUP'
if test "$(systemctl is-active homelab-k3s.service 2>/dev/null || true)" = active; then
  systemctl stop homelab-k3s.service
fi
test "$(systemctl is-active homelab-k3s.service 2>/dev/null || true)" != active
test "$(systemctl is-active k3s.service 2>/dev/null || true)" != active
tar -C /var/lib/rancher/k3s -cf - server/db server/cred server/token
REMOTE_K3S_COLD_BACKUP
      then
        if rollback_armed_host "$host"; then
          record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
        fi
        exit 1
      fi
      chmod 0600 "$recovery/k3s-cold-state.tar"
    fi
    if ! prepare_native_runtime_handoff "$host" \
      || ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host-while-armed "$host" \
      || ! verify_storage_recovery "$host" "$storage_inventory" yes; then
      if rollback_armed_host "$host"; then
        record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
      else
        echo "$host automatic rollback failed; inspect nix run .#k3s-handoff -- status $host" >&2
      fi
      exit 1
    fi
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      if rollback_armed_host "$host"; then
        record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    verify_nas_baseline "$host" "$nas_baseline"
    write_receipt "$host" activated "$previous" "$legacy" "$recovery" "$secret_generation" "$store_path" "" "$nas_baseline" "$storage_inventory"
    printf 'activated %s; run homelab-host reboot %s while the rollback timer remains armed\n' "$host" "$host"
    ;;
  reboot)
    host=${2:?host required}
    reboot_host "$host"
    ;;
  reboot-verify)
    host=${2:?host required}
    sync_completed_rollback "$host" || exit 1
    receipt_file=$(receipt "$host")
    phase=$(jq -r '.phase // empty' "$receipt_file" 2>/dev/null || true)
    test "$phase" = rebooting || {
      echo "$host receipt phase is ${phase:-missing}; expected rebooting" >&2
      exit 1
    }
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      sync_completed_rollback "$host" || true
      exit 1
    fi
    require_receipt_phase "$host" rebooting yes
    assert_host_rebooted "$host"
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    store_path=$(jq -r '.storePath // empty' "$receipt_file")
    nas_baseline=$(jq -r '.nasBaseline // empty' "$receipt_file")
    storage_inventory=$(jq -r '.storageInventory // empty' "$receipt_file")
    boot_id=$(jq -r '.bootId // empty' "$receipt_file")
    if ! HOMELAB_STORAGE_WAIT=yes timeout --foreground --kill-after=30s 12m "$0" verify-host-while-armed "$host" \
      || ! verify_nas_baseline "$host" "$nas_baseline" yes \
      || ! verify_storage_recovery "$host" "$storage_inventory" yes \
      || ! "$root/nix/scripts/k3s-handoff" disarm "$host"; then
      if rollback_armed_host "$host"; then
        record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
      fi
      exit 1
    fi
    write_receipt "$host" reboot-verified "$previous" "$legacy" "$recovery" "$secret_generation" "$store_path" "$boot_id" "$nas_baseline" "$storage_inventory"
    ;;
  commit)
    host=${2:?host required}
    require_receipt_phase "$host" reboot-verified
    assert_preservation_plan_safe "$host" "$host-commit"
    receipt_file=$(receipt "$host")
    previous=$(jq -r '.previousGeneration // empty' "$receipt_file")
    legacy=$(jq -r '.legacyK3sUnit // empty' "$receipt_file")
    recovery=$(jq -r '.recoveryDirectory // empty' "$receipt_file")
    secret_generation=$(jq -r '.secretGeneration // empty' "$receipt_file")
    nas_baseline=$(jq -r '.nasBaseline // empty' "$receipt_file")
    storage_inventory=$(jq -r '.storageInventory // empty' "$receipt_file")
    committed_store_path=$(register_system "$host" "$host-commit")
    if ! "$root/nix/scripts/k3s-handoff" rearm "$host"; then
      echo "$host commit rollback timer could not be armed; host state was not changed" >&2
      exit 1
    fi
    if ! activate_registered_system "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host-while-armed "$host" \
      || ! reconcile_distro_packages "$host" yes \
      || ! cleanup_legacy_files "$host" \
      || ! apply_native_runtime "$host" \
      || ! "$0" verify-host-while-armed "$host" \
      || ! verify_legacy_cleanup "$host" \
      || ! verify_storage_recovery "$host" "$storage_inventory" yes; then
      if rollback_armed_host "$host"; then
        record_rolled_back "$host" "$previous" "$legacy" "$recovery" "$secret_generation"
      else
        echo "$host rollback failed; recovery remains armed" >&2
      fi
      exit 1
    fi
    staged_receipt="$(receipt "$host").accepted"
    render_receipt "$staged_receipt" "$host" committed "$previous" "$legacy" "$recovery" "$secret_generation" "$committed_store_path" "" "$nas_baseline" "$storage_inventory"
    if ! verify_nas_baseline "$host" "$nas_baseline" \
      || ! "$root/nix/scripts/k3s-handoff" accept "$host"; then
      rm -f "$staged_receipt"
      echo "$host commit verification or rollback artifact cleanup failed; rerun commit" >&2
      exit 1
    fi
    mv -f "$staged_receipt" "$(receipt "$host")"
    printf 'committed %s after preserved storage recovery verification\n' "$host"
    ;;
  onboard-k3s-node)
    host=${2:?host required}
    preserve=$(preserve_nas_state "$host") || exit 1
    test "${3:-}" = --token-source
    source_host=${4:?token source required}
    [ "$preserve" != true ] || {
      echo "$host is an adopted NAS host and cannot use onboard-k3s-node" >&2
      exit 1
    }
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    test "$role" = server || test "$role" = agent || {
      echo "$host must have a K3s role before onboarding" >&2
      exit 1
    }
    source_role=$(host_field "$source_host" k3sRole 2>/dev/null || true)
    test "$source_role" = server || {
      echo "$source_host must be an existing K3s server" >&2
      exit 1
    }
    remote "$host" 'test ! -e /var/lib/rancher/k3s && for unit in k3s.service k3s-agent.service homelab-k3s.service; do test "$(systemctl is-active "$unit" 2>/dev/null || true)" != active && test "$(systemctl is-enabled "$unit" 2>/dev/null || true)" != enabled; done'
    binary_present=true
    if ! remote "$host" 'test -x /usr/local/bin/k3s'; then
      binary_present=false
      version=$(remote "$source_host" 'sudo -n /usr/local/bin/k3s --version' | sed -n 's/^k3s version v\([^ ]*\).*/\1/p')
      test -n "$version" || {
        echo "could not determine the live K3s version on $source_host" >&2
        exit 1
      }
      printf -v command 'sudo -n env K3S_VERSION=%q K3S_ROLE=%q sh -s' "v$version" "$role"
      remote "$host" "$command" <<'REMOTE_K3S_INSTALL'
set -eu
test ! -e /var/lib/rancher/k3s
for unit in k3s.service k3s-agent.service homelab-k3s.service; do
  test "$(systemctl is-active "$unit" 2>/dev/null || true)" != active
  test "$(systemctl is-enabled "$unit" 2>/dev/null || true)" != enabled
done
installer=$(mktemp /tmp/k3s-install.XXXXXX)
cleanup_installer() { rm -f -- "$installer"; }
trap cleanup_installer EXIT HUP INT TERM
curl --proto '=https' --tlsv1.2 -fsSL -o "$installer" https://get.k3s.io
test -s "$installer"
INSTALL_K3S_SKIP_ENABLE=true \
  INSTALL_K3S_SKIP_START=true \
  INSTALL_K3S_VERSION="$K3S_VERSION" \
  INSTALL_K3S_EXEC="$K3S_ROLE" \
  sh "$installer"
test -x /usr/local/bin/k3s
test ! -e /var/lib/rancher/k3s
for unit in k3s.service k3s-agent.service homelab-k3s.service; do
  test "$(systemctl is-active "$unit" 2>/dev/null || true)" != active
  test "$(systemctl is-enabled "$unit" 2>/dev/null || true)" != enabled
done
REMOTE_K3S_INSTALL
    fi
    cleanup_onboard_binary() {
      [ "$binary_present" != false ] || remote "$host" \
        'sudo -n rm -f -- /usr/local/bin/k3s /usr/local/bin/kubectl /usr/local/bin/crictl /usr/local/bin/ctr /usr/local/bin/k3s-killall.sh /usr/local/bin/k3s-uninstall.sh /usr/local/bin/k3s-agent-uninstall.sh'
    }
    trap cleanup_onboard_binary EXIT HUP INT TERM
    if ! "$root/nix/scripts/wireguard-secrets" copy-k3s-token --from "$source_host" --to "$host" --check >/dev/null 2>&1; then
      "$root/nix/scripts/wireguard-secrets" copy-k3s-token --from "$source_host" --to "$host" --write
    fi
    HOMELAB_K3S_BINARY_PRESENT="$binary_present" "$0" prepare "$host"
    trap - EXIT HUP INT TERM
    ;;
  reconcile-distro-packages)
    host=${2:?host required}
    case "${3:-}" in
      "") purge=no ;;
      --purge) purge=yes ;;
      *) usage; exit 2 ;;
    esac
    reconcile_distro_packages "$host" "$purge"
    ;;
  verify-legacy-cleanup)
    verify_legacy_cleanup "${2:?host required}"
    ;;
  verify-host-while-armed)
    host=${2:?host required}
    verify_receipt_nas_baseline "$host" "${HOMELAB_STORAGE_WAIT:-no}"
    "$root/nix/scripts/k3s-handoff" rearm "$host"
    shift
    exec "$0" verify-host "$@"
    ;;
  verify-host|verify)
    host=${2:?host required}; shift 2
    baseline=
    if [ "${1:-}" = --baseline ]; then baseline=${2:?baseline path required}; shift 2; fi
    test "$#" -eq 0
    preserve=$(preserve_nas_state "$host") || exit 1
    manage_rules=$(manage_firewall_rules "$host")
    assert_iptables_nft_backend "$host"
    if [ "$preserve" = true ]; then
      verify_receipt_nas_baseline "$host" "${HOMELAB_STORAGE_WAIT:-no}"
      if [ -n "$baseline" ]; then verify_nas_baseline "$host" "$baseline" "${HOMELAB_STORAGE_WAIT:-no}"; fi
    elif [ -n "$baseline" ]; then
      test -s "$baseline"
      current_baseline=$("$root/nix/scripts/adopt-host" baseline "$host")
      for key in os arch wireguard-public; do
        test "$(sed -n "s/^$key=//p" "$baseline")" = "$(sed -n "s/^$key=//p" "$current_baseline")" || {
          echo "$host baseline changed: $key" >&2
          rm -f "$current_baseline"
          exit 1
        }
      done
      rm -f "$current_baseline"
    fi
    role=$(host_field "$host" k3sRole 2>/dev/null || true)
    iscsi_client=$(nix_eval --json "$root#topology.nodes.$host.iscsiClient")
    iscsi_server=$(nix_eval --json "$root#topology.nodes.$host.iscsiServer")
    zram=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.zram")
    lan_address=$(host_field "$host" lanAddress 2>/dev/null || true)
    gateway_address=$(host_field "$host" gatewayAddress 2>/dev/null || true)
    default_interface=$(host_field "$host" defaultInterface 2>/dev/null || true)
    backend=$(host_field "$host" packageBackend)
    ssh_target=$(host_field "$host" sshTarget)
    admin_user=${ssh_target%@*}
    samba_clients=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.firewall.sambaClients" | jq -r 'join(" ")')
    netbios=$(nix_eval --json "$root#systemConfigs.$host.config.homelab.firewall.netbios")
    local_network=$(nix_eval --raw "$root#systemConfigs.$host.config.homelab.firewall.localNetwork")
    localtime_source=$(nix_eval --raw "$root#systemConfigs.$host.config.environment.etc.localtime.source")
    if [ "$backend" = pacman ]; then
      firewall_rules=/etc/iptables/iptables.rules
      firewall_service=iptables.service
      ssh_service=sshd.service
      iscsi_login_service=iscsi.service
    else
      firewall_rules=/etc/iptables/rules.v4
      firewall_service=netfilter-persistent.service
      ssh_service=ssh.service
      iscsi_login_service=open-iscsi.service
    fi
    democratic_csi_key_sha=
    if [ "$iscsi_server" = true ] && [ "$preserve" != true ]; then
      democratic_csi_key_sha=$(sha256sum "$root/ssh_pub_keys/democratic-csi.pub" | awk '{print $1}')
    fi
    printf -v verify_command \
      'env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOST_NAME=%q ROLE=%q ISCSI_CLIENT=%q ISCSI_LOGIN_SERVICE=%q ISCSI_SERVER=%q PRESERVE_NAS_STATE=%q MANAGE_FIREWALL_RULES=%q ZRAM=%q DEMOCRATIC_CSI_KEY_SHA=%q LAN_ADDRESS=%q GATEWAY_ADDRESS=%q DEFAULT_INTERFACE=%q FIREWALL_RULES=%q FIREWALL_SERVICE=%q SSH_SERVICE=%q ADMIN_USER=%q SAMBA_CLIENTS=%q NETBIOS=%q LOCAL_NETWORK=%q LOCALTIME_SOURCE=%q sh -s' \
      "$host" "$role" "$iscsi_client" "$iscsi_login_service" "$iscsi_server" "$preserve" "$manage_rules" "$zram" "$democratic_csi_key_sha" \
      "$lan_address" "$gateway_address" "$default_interface" "$firewall_rules" "$firewall_service" "$ssh_service" \
      "$admin_user" "$samba_clients" "$netbios" "$local_network" "$localtime_source"
    remote "$host" "$verify_command" <<'REMOTE_VERIFY'
set -eu
stage=core-services
trap 'rc=$?; test "$rc" -eq 0 || echo "host verification failed during $stage" >&2' EXIT
test "$(uname -n)" = "$HOST_NAME"
systemctl is-active systemd-networkd systemd-resolved systemd-timesyncd "$SSH_SERVICE"
systemctl is-enabled systemd-networkd systemd-resolved systemd-timesyncd
if test "$MANAGE_FIREWALL_RULES" = true; then systemctl is-enabled "$FIREWALL_SERVICE"; fi
if test "$ROLE" = server || test "$ROLE" = agent; then
  systemctl is-enabled homelab-k3s.service
fi
stage=time-and-locale
attempt=0
while test "$(timedatectl show -p NTPSynchronized --value)" != yes; do
  attempt=$((attempt + 1))
  if test "$attempt" -ge 45; then
    echo "system clock did not synchronize within 90 seconds" >&2
    exit 1
  fi
  sleep 2
done
actual=$(readlink /etc/localtime 2>/dev/null || true)
test "$actual" = "$LOCALTIME_SOURCE" || {
  printf 'unexpected /etc/localtime target: %s (expected %s)\n' "${actual:-missing}" "$LOCALTIME_SOURCE" >&2
  exit 1
}
grep -qx "Asia/Seoul" /etc/timezone || {
  echo "/etc/timezone is not Asia/Seoul" >&2
  exit 1
}
grep -qx "LANG=ko_KR.UTF-8" /etc/locale.conf || {
  echo "/etc/locale.conf is not ko_KR.UTF-8" >&2
  exit 1
}
locale -a | grep -qi '^ko_KR\.utf8$' || {
  echo "ko_KR.UTF-8 locale was not generated" >&2
  exit 1
}
for setting in DNSSEC=yes DNSOverTLS=yes MulticastDNS=yes LLMNR=no; do
  grep -qx "$setting" /etc/systemd/resolved.conf || {
    echo "/etc/systemd/resolved.conf is missing $setting" >&2
    exit 1
  }
done
actual=$(readlink /etc/resolv.conf 2>/dev/null || true)
test "$actual" = /run/systemd/resolve/stub-resolv.conf || {
  printf 'unexpected /etc/resolv.conf target: %s\n' "${actual:-missing}" >&2
  exit 1
}
actual=$(getent passwd root | cut -d: -f7)
test "$actual" = /bin/bash || {
  printf 'unexpected root login shell: %s\n' "${actual:-missing}" >&2
  exit 1
}
stage=ssh
for path in /etc /etc/ssh /etc/ssh/authorized_keys.d; do
  test "$(stat -c '%a %u %g' "$path")" = "755 0 0"
done
test -s "/etc/ssh/authorized_keys.d/$ADMIN_USER"
sshd_bin=$(command -v sshd || printf /usr/sbin/sshd)
sudo -n "$sshd_bin" -T | grep -Eqi '^authorizedkeysfile( \.ssh/authorized_keys)? /etc/ssh/authorized_keys\.d/%u$'
if test "$ADMIN_USER" != root; then
  sudo -n grep -Fx "$ADMIN_USER ALL=(ALL) NOPASSWD: ALL" /etc/sudoers.d/homelab-admin
  visudo_bin=$(command -v visudo || printf /usr/sbin/visudo)
  sudo -n "$visudo_bin" -cf /etc/sudoers.d/homelab-admin
fi
stage=firewall
if test "$MANAGE_FIREWALL_RULES" = true; then test -s "$FIREWALL_RULES"; fi
for unit in homelab-host-settings.service homelab-wireguard.service homelab-firewall.service homelab-runtime-tuning.service homelab-k3s-legacy-cleanup.service homelab-legacy-tuning-cleanup.service; do
  ! systemctl cat "$unit" >/dev/null 2>&1
done
stage=lan
if test -n "$LAN_ADDRESS" && test "$LAN_ADDRESS" != null; then
  ip -o -4 address show dev "$DEFAULT_INTERFACE" | awk '{print $4}' | grep -Fx "$LAN_ADDRESS/24"
  ip -4 route show default | grep -F "via $GATEWAY_ADDRESS dev $DEFAULT_INTERFACE"
  grep -qx "MulticastDNS=yes" /etc/systemd/network/10-homelab-lan.network
  grep -qx "LLMNR=no" /etc/systemd/network/10-homelab-lan.network
fi
if test "$MANAGE_FIREWALL_RULES" = true; then
  test "$(sudo -n iptables -S INPUT | grep -c -- "-j HOMELAB_INPUT")" -eq 1
  test "$(sudo -n iptables -S FORWARD | grep -c -- "-j HOMELAB_FORWARD")" -eq 1
  test "$(sudo -n iptables -S INPUT | sed -n "1p")" = "-P INPUT DROP"
  test "$(sudo -n iptables -S FORWARD | sed -n "1p")" = "-P FORWARD DROP"
  test "$(sudo -n iptables -S OUTPUT | sed -n "1p")" = "-P OUTPUT ACCEPT"
  for source in $SAMBA_CLIENTS; do
    sudo -n iptables -C HOMELAB_TCP -s "$source" -p tcp --dport 445 -j ACCEPT
  done
  if test "$NETBIOS" = true; then
    sudo -n iptables -C HOMELAB_UDP -s "$LOCAL_NETWORK" -p udp --dport 137:138 -j ACCEPT
  fi
fi
stage=k3s-sysctl
if test "$ROLE" = server || test "$ROLE" = agent; then
  test "$(sysctl -n net.ipv4.ip_forward)" = 1
  stage=k3s-service
  test -x /usr/local/bin/k3s
  attempt=0
  until systemctl is-active --quiet homelab-k3s.service; do
    attempt=$((attempt + 1))
    if test "$attempt" -ge 120; then
      echo "K3s service did not become active within 240 seconds" >&2
      exit 1
    fi
    sleep 2
  done
  stage=k3s-credential-config
  sudo -n test -s /var/lib/homelab-secrets/active/k3s-token.cred
  systemctl cat homelab-k3s.service | grep -Fx 'LoadCredentialEncrypted=k3s-token:/var/lib/homelab-secrets/active/k3s-token.cred'
  if test "$MANAGE_FIREWALL_RULES" = true; then
  stage=k3s-firewall
  attempt=0
  until sudo -n iptables -S INPUT | awk '
      /-j CILIUM_INPUT$/ || /-j KUBE-FIREWALL$/ { native = NR }
      /-j HOMELAB_INPUT$/ { homelab = NR; count++ }
      END { exit !(native && homelab > native && count == 1) }
    ' \
    && sudo -n iptables -S FORWARD | awk '
      /-j CILIUM_FORWARD$/ { native = NR }
      /-j HOMELAB_FORWARD$/ { homelab = NR; count++ }
      END { exit !(native && homelab > native && count == 1) }
    '; do
    attempt=$((attempt + 1))
    if test "$attempt" -ge 120; then
      echo "Cilium and HOMELAB firewall ordering did not stabilize within 240 seconds" >&2
      exit 1
    fi
    sleep 2
  done
  fi
elif test "$MANAGE_FIREWALL_RULES" = true; then
  test "$(sudo -n iptables -S INPUT | sed -n "2p")" = "-A INPUT -j HOMELAB_INPUT"
  test "$(sudo -n iptables -S FORWARD | sed -n "2p")" = "-A FORWARD -j HOMELAB_FORWARD"
fi
stage=zram
if test "$ZRAM" = true; then
  systemctl is-active dev-zram0.swap
  swapon --show=NAME --noheadings | grep -qx /dev/zram0
fi
stage=iscsi-client
if test "$ISCSI_CLIENT" = true; then
  systemctl is-active iscsid.service
  systemctl is-enabled "$ISCSI_LOGIN_SERVICE"
  if find /etc/iscsi/nodes -mindepth 1 -print -quit 2>/dev/null | grep -q .; then
    systemctl is-active "$ISCSI_LOGIN_SERVICE"
  fi
fi
stage=iscsi-server
if test "$ISCSI_SERVER" = true && test "$PRESERVE_NAS_STATE" != true; then
  test "$(id -u democratic-csi)" -eq 1001
  test "$(id -g democratic-csi)" -eq 1001
  test "$(sha256sum /etc/ssh/authorized_keys.d/democratic-csi | awk '{print $1}')" = "$DEMOCRATIC_CSI_KEY_SHA"
  sudo -n -u democratic-csi sudo -n true
fi
stage=etcd
if test "$ROLE" = server; then
  pid=$(systemctl show homelab-k3s.service -p MainPID --value)
  test "$pid" -gt 1
  sudo -n /usr/local/bin/k3s etcd-snapshot ls >/dev/null
fi
trap - EXIT
REMOTE_VERIFY
    while IFS= read -r interface; do
      expected_public=$(nix_eval --raw "$root#topology.$interface.nodes.$host.publicKey")
      expected_address=$(nix_eval --raw "$root#topology.$interface.nodes.$host.address")
      remote "$host" "sudo -n sh -ceu 'test -s \"/run/credentials/systemd-networkd.service/$interface-private\"; test \"\$(wg show \"$interface\" public-key)\" = \"$expected_public\"; ip -o -4 address show dev \"$interface\" | awk \"{print \\\$4}\" | grep -Fx \"$expected_address\"'"
      verify_wireguard_runtime "$host" "$interface"
      while IFS= read -r peer; do
        peer_public=$(nix_eval --raw "$root#topology.$interface.nodes.$peer.publicKey")
        peer_address=$(nix_eval --raw "$root#topology.$interface.nodes.$peer.address")
        verify_wireguard_handshake "$host" "$interface" "$peer" "$peer_public" "${peer_address%/*}"
      done < <(nix_eval --json "$root#topology.requiredLinks" | jq -r --arg host "$host" --arg interface "$interface" '.[] | select(.network == $interface and .managed and (.aName == $host or .bName == $host)) | if .aName == $host then .bName else .aName end')
    done < <(nix_eval --json "$root#topology.nodes.$host.wireguard" | jq -r '.[]')
    if [ "$role" = server ] || [ "$role" = agent ]; then
      context=${BACKBONE_CONTEXT:-homelab-backbone}
      node_ready=$(kubectl --context "$context" get node "$host" -o jsonpath='{range .status.conditions[?(@.type=="Ready")]}{.status}{end}')
      test "$node_ready" = True || {
        echo "$host Kubernetes Node Ready is ${node_ready:-missing}" >&2
        exit 1
      }
    fi
    ;;
  restore-host)
    host=${2:?host required}
    restore_host "$host"
    ;;
  rollback)
    host=${2:?host required}
    preserve=$(preserve_nas_state "$host") || exit 1
    generation=${3:?generation required}
    [ "$preserve" != true ] || {
      echo "$host preserves an external NAS data plane; generation rollback is not allowed outside the guarded recovery lifecycle" >&2
      exit 1
    }
    restore_previous_secrets "$host"
    remote "$host" "sudo -n sh -ceu '
      profile=/nix/var/nix/profiles/system-manager-profiles/system-manager
      nix_env=/nix/var/nix/profiles/default/bin/nix-env
      test -x \"\$nix_env\"
      \"\$nix_env\" --profile \"\$profile\" --switch-generation \"$generation\"
      test -x \"\$profile/bin/activate\"
      \"\$profile/bin/activate\"
    '"
    apply_native_runtime "$host"
    "$0" verify-host "$host"
    ;;
  check-bootstrap)
    kubectl --context "${BACKBONE_CONTEXT:-homelab-backbone}" get --raw=/readyz >/dev/null
    printf 'bootstrap: existing clusters are ready; Rancher system-upgrade-controller retains K3s upgrade ownership\n'
    ;;
  bootstrap-k3s)
    cluster=${2:?cluster required}; test "$cluster" = backbone
    context=${BOOTSTRAP_CONTEXT:-homelab-backbone}; values="$root/values/cilium/backbone.yaml"
    if kubectl --context "$context" get --raw=/readyz >/dev/null 2>&1; then
      helm --kube-context "$context" diff upgrade cilium cilium --repo https://helm.cilium.io --version 1.20.0 --namespace kube-system --values "$values" >/dev/null
      printf 'existing cluster: Cilium dry-run diff completed; release ownership unchanged\n'
    else
      test "${ALLOW_NEW_CLUSTER_BOOTSTRAP:-}" = yes
      helm --kube-context "$context" upgrade --install cilium cilium --repo https://helm.cilium.io --version 1.20.0 --namespace kube-system --create-namespace --atomic --wait --values "$values"
      kubectl --context "$context" -n kube-system rollout status ds/cilium --timeout=10m
      kubectl --context "$context" -n kube-system rollout status ds/cilium-envoy --timeout=10m
      kubectl --context "$context" -n kube-system rollout status deploy/cilium-operator --timeout=10m
    fi
    ;;
  bootstrap-argocd)
    cluster=${2:-backbone}; test "$cluster" = backbone; context=${BACKBONE_CONTEXT:-homelab-backbone}
    test "${ALLOW_NEW_CLUSTER_BOOTSTRAP:-}" = yes
    grep -q '^  clusterCredentials:' "$root/values/argo-cd/backbone.yaml"
    sops --decrypt "$root/nix/secrets/kubernetes/backbone-bootstrap.sops.yaml" | kubectl --context "$context" apply --server-side -f -
    helm --kube-context "$context" upgrade --install argocd argo-cd --repo https://argoproj.github.io/argo-helm --version 10.1.4 --namespace argocd --create-namespace --atomic --wait --values "$root/values/argo-cd/backbone.yaml"
    helm --kube-context "$context" upgrade --install argocd-apps argocd-apps --repo https://argoproj.github.io/argo-helm --version 2.0.5 --namespace argocd --atomic --wait --values "$root/values/argocd-apps/backbone.yaml"
    ;;
  issue-kubeconfig) HOMELAB_REPO_ROOT="$root" "$root/nix/scripts/issue-kubeconfig" "${2:?identity required}" ;;
  *) usage; exit 2 ;;
esac
