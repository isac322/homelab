#!/usr/bin/env bash
set -euo pipefail
plaintext_workdir() {
  local runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  if [ ! -d "$runtime" ] || [ ! -w "$runtime" ]; then runtime=/dev/shm; fi
  test -d "$runtime" && test -w "$runtime"
  mktemp -d "$runtime/homelab-bootstrap.XXXXXX"
}
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
cluster=${1:?cluster required}
case "$cluster" in backbone) terraform_dir=${TERRAFORM_DIR:-"$root/1-provision/env/backbone"} ;; *) echo "unsupported cluster: $cluster" >&2; exit 2 ;; esac
out="$root/nix/secrets/kubernetes/$cluster-bootstrap.sops.yaml"
recipient=${BOOTSTRAP_SECRET_AGE_RECIPIENT:?BOOTSTRAP_SECRET_AGE_RECIPIENT required}
work=$(plaintext_workdir)
trap 'rm -rf "$work"' EXIT
umask 077
terraform -chdir="$terraform_dir" output -json > "$work/terraform.json"
jq -e '{
  apiVersion: "v1",
  kind: "Secret",
  metadata: {
    name: "external-secrets-cluster-store-aws",
    namespace: "kube-system"
  },
  type: "Opaque",
  stringData: {
    id: (.external_secrets_cluster_store_aws.value.id // .external_secrets_cluster_store_aws.value.access_key_id),
    secret: (.external_secrets_cluster_store_aws.value.secret // .external_secrets_cluster_store_aws.value.secret_access_key)
  }
} | if (.stringData.id | length > 0) and (.stringData.secret | length > 0) then . else error("AWS bootstrap credential output is incomplete") end' "$work/terraform.json" > "$work/secret.json"
yq -p=json -o=yaml '.' "$work/secret.json" > "$work/secret.yaml"
mkdir -p "$(dirname "$out")"
SOPS_AGE_RECIPIENTS="$recipient" sops --encrypt --input-type yaml --output-type yaml "$work/secret.yaml" > "$work/ciphertext.yaml"
grep -q 'ENC\[AES256_GCM' "$work/ciphertext.yaml"
mv -f "$work/ciphertext.yaml" "$out"
printf '%s\n' "$out"
