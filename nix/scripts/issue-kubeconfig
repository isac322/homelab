#!/usr/bin/env bash
set -euo pipefail
identity=${1:?identity required}
context=${KUBE_CONTEXT:-private-backbone}
cluster=${CLUSTER_NAME:-homelab-backbone}
server=${API_SERVER:-https://k8s.backbone.homelab.bhyoo.com:6443}
namespace=${NAMESPACE:-}
root=${HOMELAB_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}
out=${KUBECONFIG_OUTPUT_DIR:-"$root/.host-state/kubeconfig"}
mkdir -p "$out"
chmod 0700 "$out"
key="$out/$identity.key"
csr="$out/$identity.csr"
cert="$out/$identity.crt"
config="$out/$identity.yaml"
if [ ! -s "$key" ]; then openssl genpkey -algorithm ED25519 -out "$key"; fi
chmod 0600 "$key"
openssl req -new -key "$key" -out "$csr" -subj "/CN=$identity/O=homelab:cluster-admins"
request=$(base64 < "$csr" | tr -d '\n')
if kubectl --context "$context" get csr "$identity" >/dev/null 2>&1; then
  echo "CSR $identity already exists; delete it explicitly before reissuing" >&2
  exit 1
fi
kubectl --context "$context" apply --server-side -f - <<EOF
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: $identity
spec:
  request: $request
  signerName: kubernetes.io/kube-apiserver-client
  expirationSeconds: 31536000
  usages: [client auth]
EOF
kubectl --context "$context" certificate approve "$identity"
kubectl --context "$context" get csr "$identity" -o jsonpath='{.status.certificate}' | base64 -d > "$cert"
ca=$(kubectl --context "$context" config view --raw -o 'jsonpath={.clusters[0].cluster.certificate-authority-data}')
kubectl config --kubeconfig "$config" set-cluster "$cluster" --server "$server" --certificate-authority <(printf '%s' "$ca" | base64 -d) --embed-certs=true
kubectl config --kubeconfig "$config" set-credentials "$identity" --client-certificate "$cert" --client-key "$key" --embed-certs=true
kubectl config --kubeconfig "$config" set-context "$identity@$cluster" --cluster "$cluster" --user "$identity" ${namespace:+--namespace "$namespace"}
kubectl config --kubeconfig "$config" use-context "$identity@$cluster"
chmod 0600 "$config"
printf '%s\n' "$config"
