#!/usr/bin/env bash
set -euo pipefail

root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
state=${HOMELAB_STATE_DIR:-"$root/.host-state"}
bundle="$root/nix/secrets/wireguard/edges.sops.yaml"
operator_key_file=${HOMELAB_OPERATOR_AGE_KEY_FILE:-"${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"}
if [ -z "${SOPS_AGE_KEY_FILE:-}" ] && [ -s "$operator_key_file" ]; then
  export SOPS_AGE_KEY_FILE="$operator_key_file"
fi
workdir=
cleanup() {
  if [ -n "${workdir:-}" ]; then rm -rf -- "$workdir"; fi
}
trap cleanup EXIT HUP INT TERM

usage() {
  cat <<'EOF'
Usage: edge-wireguard-secrets <command> [arguments]
  status
  render <edge> [output-file]
EOF
}

nix_eval() { nix --extra-experimental-features 'nix-command flakes' eval "$@"; }
json_eval() { nix_eval --json "$@"; }
raw_eval() { nix_eval --raw "$@"; }

plaintext_workdir() {
  local runtime=${XDG_RUNTIME_DIR:-}
  if [ -z "$runtime" ] || [ ! -d "$runtime" ] || [ ! -w "$runtime" ]; then
    if [ -d /dev/shm ] && [ -w /dev/shm ]; then
      runtime=/dev/shm
    else
      runtime=${TMPDIR:-/tmp}
    fi
  fi
  test -d "$runtime" && test -w "$runtime"
  umask 077
  mktemp -d "$runtime/homelab-edge-wireguard.XXXXXX"
}

assert_ciphertext() {
  test -s "$1"
  grep -q '^sops:' "$1"
  grep -q 'ENC\[AES256_GCM' "$1"
  ! grep -Eq '^        [a-z0-9-]+: [A-Za-z0-9+/]{43}=$' "$1"
}

decrypt_bundle() { sops --decrypt "$1"; }

all_edges_json() { json_eval "$root#topology.wg0.edges"; }

assert_edge() {
  local edge=$1
  case "$edge" in
    ""|*[!A-Za-z0-9._-]*) echo "invalid edge name" >&2; exit 2 ;;
  esac
  all_edges_json | jq -e --arg edge "$edge" 'has($edge)' >/dev/null || {
    echo "unknown WireGuard edge: $edge" >&2
    exit 2
  }
}

edge_public_key() {
  all_edges_json | jq -er --arg edge "$1" '.[$edge].publicKey'
}

edge_address() {
  all_edges_json | jq -er --arg edge "$1" '.[$edge].address'
}

secret_recipients() {
  local operator recovery
  operator=$(raw_eval "$root#topology.secretRecipients.operator")
  recovery=$(raw_eval "$root#topology.secretRecipients.recovery")
  case "$operator" in age1*) ;; *) echo "invalid operator age recipient" >&2; exit 1 ;; esac
  case "$recovery" in age1*) ;; *) echo "invalid recovery age recipient" >&2; exit 1 ;; esac
  printf '%s,%s\n' "$operator" "$recovery"
}

assert_edge_recipients() {
  local encrypted=$1 work=$2
  secret_recipients | tr ',' '\n' | LC_ALL=C sort > "$work/expected-recipients"
  yq -r '.sops.age[].recipient' "$encrypted" | LC_ALL=C sort > "$work/actual-recipients"
  cmp "$work/expected-recipients" "$work/actual-recipients" >/dev/null || {
    echo "$encrypted must be encrypted only for the operator and recovery recipients" >&2
    exit 1
  }
}

load_edge_bundle() {
  local output=$1 work=$2
  if [ -s "$bundle" ]; then
    assert_ciphertext "$bundle"
    assert_edge_recipients "$bundle" "$work"
    decrypt_bundle "$bundle" > "$output"
  else
    printf 'wireguard:\n  privateKeys: {}\n' > "$output"
  fi
  yq -e '.wireguard.privateKeys' "$output" >/dev/null
}

validate_private_key() {
  local edge=$1 private_file=$2 expected actual
  expected=$(edge_public_key "$edge")
  actual=$(wg pubkey < "$private_file")
  test "$actual" = "$expected" || {
    echo "$edge private key does not derive the public key declared in topology" >&2
    return 1
  }
}

gateway_name() { raw_eval "$root#topology.wg0.gateway"; }

gateway_bundle() {
  local gateway id
  gateway=$(gateway_name)
  id=$(raw_eval "$root#topology.nodes.$gateway.nodeId")
  printf '%s/nix/secrets/wireguard/hosts/%s.sops.yaml\n' "$root" "$id"
}

link_id() {
  printf 'wg0-%s-%s\n' "$(gateway_name)" "$1"
}

status_command() {
  local work plaintext gateway_plain gateway_secrets edge key link private_file healthy total recoverable
  work=$(plaintext_workdir)
  workdir=$work
  plaintext="$work/edges.yaml"
  gateway_plain="$work/gateway.yaml"
  load_edge_bundle "$plaintext" "$work"
  gateway_secrets=$(gateway_bundle)
  assert_ciphertext "$gateway_secrets"
  decrypt_bundle "$gateway_secrets" > "$gateway_plain"
  healthy=true
  total=0
  recoverable=0
  while IFS= read -r edge; do
    total=$((total + 1))
    key=$(EDGE="$edge" yq -r '.wireguard.privateKeys[strenv(EDGE)] // ""' "$plaintext")
    if [ -z "$key" ]; then
      printf 'missing-private-key %s\n' "$edge"
      healthy=false
      continue
    fi
    private_file="$work/$edge.private"
    printf '%s\n' "$key" > "$private_file"
    chmod 0600 "$private_file"
    if ! validate_private_key "$edge" "$private_file" >/dev/null 2>&1; then
      printf 'mismatched-private-key %s\n' "$edge"
      healthy=false
      continue
    fi
    link=$(link_id "$edge")
    if ! LINK="$link" yq -e '.wireguard.psks[strenv(LINK)] | length > 0' "$gateway_plain" >/dev/null; then
      printf 'missing-psk %s\n' "$edge"
      healthy=false
      continue
    fi
    printf 'recoverable %s\n' "$edge"
    recoverable=$((recoverable + 1))
  done < <(all_edges_json | jq -r 'keys[]')
  printf 'edge-recovery: %s/%s recoverable\n' "$recoverable" "$total"
  test "$healthy" = true
}

render_command() {
  local edge=${1:?edge required} output=${2:-} work plaintext gateway_plain gateway_secrets private_file private_key psk gateway gateway_public address network endpoint allowed link prefix
  assert_edge "$edge"
  if [ -z "$output" ]; then
    output="$state/generated/wireguard-edges/$edge.conf"
  fi
  case "$output" in /*) ;; *) output="$root/$output" ;; esac
  work=$(plaintext_workdir)
  workdir=$work
  plaintext="$work/edges.yaml"
  gateway_plain="$work/gateway.yaml"
  private_file="$work/privatekey"
  load_edge_bundle "$plaintext" "$work"
  private_key=$(EDGE="$edge" yq -r '.wireguard.privateKeys[strenv(EDGE)] // ""' "$plaintext")
  test -n "$private_key" || {
    echo "$edge has no recoverable private key in $bundle" >&2
    exit 1
  }
  printf '%s\n' "$private_key" > "$private_file"
  chmod 0600 "$private_file"
  validate_private_key "$edge" "$private_file"
  gateway=$(gateway_name)
  gateway_public=$(raw_eval "$root#topology.wg0.nodes.$gateway.publicKey")
  gateway_secrets=$(gateway_bundle)
  assert_ciphertext "$gateway_secrets"
  decrypt_bundle "$gateway_secrets" > "$gateway_plain"
  link=$(link_id "$edge")
  psk=$(LINK="$link" yq -er '.wireguard.psks[strenv(LINK)]' "$gateway_plain")
  address=$(edge_address "$edge")
  network=$(raw_eval "$root#topology.wg0.network")
  prefix=${network#*/}
  address="${address%/*}/$prefix"
  endpoint=$(raw_eval "$root#topology.wg0.endpoint")
  allowed=$(raw_eval "$root#topology.wg0.trustedNetwork")
  install -d -m 0700 "$(dirname "$output")"
  umask 077
  cat > "$work/wg0.conf" <<EOF
[Interface]
Address = $address
PrivateKey = $private_key

[Peer]
PublicKey = $gateway_public
PresharedKey = $psk
AllowedIPs = $allowed
Endpoint = $endpoint
PersistentKeepalive = 25
EOF
  chmod 0600 "$work/wg0.conf"
  mv -f "$work/wg0.conf" "$output"
  chmod 0600 "$output"
  printf '%s\n' "$output"
}

case "${1:-}" in
  status) shift; test "$#" -eq 0; status_command ;;
  render) shift; render_command "$@" ;;
  *) usage; exit 2 ;;
esac
