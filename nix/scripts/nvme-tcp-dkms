#!/usr/bin/env bash
# Select and install one node's pinned NVMe/TCP DKMS package.
#
#   select <host> [--baseline <version>]
#     Test-build the transport sources of every newer release in the node's
#     kernel stable series, newest first, against the node's real kernel
#     headers and Module.symvers in a scratch directory, and record the first
#     one that compiles and links in nix/lib/nvme-tcp-dkms.json. Nothing is
#     installed. Commit the resulting declaration.
#   install <host>
#     Build the declared package with Nix and install it with the node's
#     package manager. Loaded modules are not replaced until the next reboot or
#     an explicit module reload.
set -euo pipefail
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
declarations="$root/nix/lib/nvme-tcp-dkms.json"
cache=${XDG_CACHE_HOME:-$HOME/.cache}/homelab/nvme-tcp-dkms
stable_git=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git

usage() {
  cat >&2 <<'EOF'
Usage: nvme-tcp-dkms select <host> [--baseline <upstream-version>]
       nvme-tcp-dkms install <host>
EOF
  exit 2
}

nix_cmd() { nix --extra-experimental-features 'nix-command flakes' "$@"; }
host_field() { nix_cmd eval --raw "$root#topology.nodes.$1.$2"; }
remote() {
  local host=$1
  shift
  ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$(host_field "$host" sshTarget)" "$@"
}
declared() { jq -er --arg host "$1" ".[\$host]$2" "$declarations"; }

# Retries cover git.kernel.org's transient 5xx responses.
fetch() {
  local url=$1 destination=$2 attempt status
  for attempt in 1 2 3 4 5 6 7 8; do
    status=$(curl --silent --show-error --location --connect-timeout 15 \
      -o "$destination" -w '%{http_code}' "$url" || echo 000)
    case "$status" in
      200) return 0 ;;
      404) return 1 ;;
    esac
    sleep $((attempt * 5))
  done
  echo "fetching $url failed with HTTP $status" >&2
  return 1
}

tarball_name() { printf 'linux-%s.tar.xz\n' "$1"; }
sri() { nix_cmd hash convert --hash-algo sha256 --to sri "$1"; }

select_source() {
  local host=$1 baseline=${2:-} role modules files subdir kernel headers series major sums work
  local baseline_hex candidate log file module object archive selected='' rejected=()
  role=$(declared "$host" .role)
  mapfile -t modules < <(declared "$host" '.modules[]')
  subdir=$(nix_cmd eval --raw "$root#nvmeTcpDkms.roles.$role.subdir")
  mapfile -t files < <(
    nix_cmd eval --json "$root#nvmeTcpDkms.moduleSources" \
      | jq -r --args '[$ARGS.positional[] as $m | .[$m]] | unique[]' "${modules[@]}"
  )
  kernel=$(remote "$host" 'uname -r')
  # The package depends on the exact vendor headers package it was selected against.
  # shellcheck disable=SC2016 # expanded on the node
  headers=$(remote "$host" '
    makefile=$(readlink -f "/lib/modules/$(uname -r)/build")/Makefile
    if command -v pacman >/dev/null; then pacman -Qqo "$makefile"; else dpkg -S "$makefile" | cut -d: -f1; fi
  ')
  [[ "$headers" =~ ^[A-Za-z0-9.+_-]+$ ]] || {
    echo "$host kernel headers are not owned by a single package: $headers" >&2
    return 1
  }
  if [[ -z "$baseline" ]]; then
    baseline=$(grep -oE '^[0-9]+\.[0-9]+(\.[0-9]+)?' <<< "$kernel" || true)
  fi
  baseline=${baseline%.0}
  [[ "$baseline" =~ ^([0-9]+)\.([0-9]+)(\.([0-9]+))?$ ]] || {
    echo "cannot derive an upstream release from $kernel; pass --baseline" >&2
    return 1
  }
  major=${BASH_REMATCH[1]}
  series="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
  local baseline_sublevel=${BASH_REMATCH[4]:-0}

  mkdir -p "$cache"
  sums="$cache/v${major}.x-sha256sums.asc"
  fetch "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/sha256sums.asc" "$sums"
  sum_of() { awk -v name="$(tarball_name "$1")" '$2 == name { print $1 }' "$sums"; }
  baseline_hex=$(sum_of "$baseline")
  [[ -n "$baseline_hex" ]] || {
    echo "linux-$baseline is not a released kernel.org tarball" >&2
    return 1
  }

  archive="$cache/$(tarball_name "$baseline")"
  if ! printf '%s  %s\n' "$baseline_hex" "$archive" | sha256sum --check --status 2>/dev/null; then
    fetch "https://cdn.kernel.org/pub/linux/kernel/v${major}.x/$(tarball_name "$baseline")" "$archive"
    printf '%s  %s\n' "$baseline_hex" "$archive" | sha256sum --check --status
  fi

  work=$(mktemp -d "${TMPDIR:-/tmp}/nvme-tcp-select.XXXXXX")
  trap 'rm -rf "$work"' RETURN
  mkdir -p "$work/baseline"
  tar -xJf "$archive" --strip-components=4 -C "$work/baseline" \
    "linux-${baseline}/drivers/nvme/${subdir}"
  {
    for module in "${modules[@]}"; do
      object=$(nix_cmd eval --raw "$root#nvmeTcpDkms.moduleSources.\"$module\"")
      printf 'obj-m += %s.o\n%s-y := %s.o\n' "$module" "$module" "${object%.c}"
    done
    # shellcheck disable=SC2016 # $(src) is a make variable
    printf 'ccflags-y += -I$(src)\n'
  } > "$work/Makefile"

  # Newer releases of the same series, newest first, then the baseline itself.
  mapfile -t candidates < <(
    awk -v series="$series" -v floor="$baseline_sublevel" '
      match($2, /^linux-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.xz$/) {
        version = substr($2, 7, length($2) - 13)
        n = split(version, part, ".")
        if (part[1] "." part[2] != series) next
        sublevel = n == 3 ? part[3] : 0
        if (sublevel + 0 > floor + 0) print sublevel "\t" version
      }' "$sums" | sort -rn -k1,1 | cut -f2
  )
  candidates+=("$baseline")

  for candidate in "${candidates[@]}"; do
    rm -rf "$work/tree"
    cp -R "$work/baseline" "$work/tree"
    if [[ "$candidate" != "$baseline" ]]; then
      for file in "${files[@]}"; do
        fetch "$stable_git/plain/drivers/nvme/${subdir}/${file}?h=v${candidate}" "$work/tree/$file" || {
          echo "v$candidate has no drivers/nvme/${subdir}/${file}" >&2
          continue 2
        }
      done
    fi
    cp "$work/Makefile" "$work/tree/Makefile"
    log="$work/build.log"
    # shellcheck disable=SC2016 # expanded on the node
    if tar -C "$work/tree" -cf - . | remote "$host" '
      set -e
      d=$(mktemp -d /var/tmp/nvme-tcp-select.XXXXXX)
      trap "rm -rf \"$d\"" EXIT
      tar -xf - -C "$d"
      make -s -C "/lib/modules/$(uname -r)/build" M="$d" modules 2>&1
    ' > "$log" 2>&1; then
      selected=$candidate
      break
    fi
    rejected+=("v$candidate: $(grep -m1 -E 'error|ERROR' "$log" || tail -n1 "$log")")
  done
  [[ -n "$selected" ]] || {
    printf '%s\n' "${rejected[@]}" >&2
    echo "even the baseline linux-$baseline transport does not build on $host" >&2
    return 1
  }

  local transport_hex
  transport_hex=$(sum_of "$selected")
  jq --arg host "$host" --arg kernel "$kernel" --arg headers "$headers" \
    --arg baseline "$baseline" --arg baseline_hash "$(sri "$baseline_hex")" \
    --arg transport "$selected" --arg transport_hash "$(sri "$transport_hex")" \
    '.[$host] += {
      kernelRelease: $kernel,
      headersPackage: $headers,
      baseline: {version: $baseline, hash: $baseline_hash},
      transport: {version: $transport, hash: $transport_hash}
    }' "$declarations" > "$work/declarations.json"
  mv "$work/declarations.json" "$declarations"

  printf '%s\n' "${rejected[@]}"
  printf '%s: kernel %s, baseline %s, transport v%s (%s)\n' \
    "$host" "$kernel" "$baseline" "$selected" "${files[*]}"
}

install_package() {
  local host=$1 decl kernel declared_kernel package version dkms_name format out file installed
  decl=$(nix_cmd eval --json "$root#nvmeTcpDkms.hosts.$host")
  declared_kernel=$(jq -r .kernelRelease <<< "$decl")
  package=$(jq -r .packageName <<< "$decl")
  version=$(jq -r .version <<< "$decl")
  dkms_name=$(jq -r .dkmsName <<< "$decl")
  format=$(jq -r .packageFormat <<< "$decl")
  kernel=$(remote "$host" 'uname -r')
  [[ "$kernel" == "$declared_kernel" ]] || {
    echo "$host runs $kernel, not the declared $declared_kernel; run select first" >&2
    return 1
  }
  case "$format" in
    deb) installed=$(remote "$host" "dpkg-query -W -f='\${Version}' $package 2>/dev/null || true") ;;
    pacman) installed=$(remote "$host" "pacman -Q $package 2>/dev/null | cut -d' ' -f2 || true") ;;
  esac
  if [[ "$installed" == "$version-1" ]]; then
    echo "$package $installed is already installed on $host" >&2
    return 0
  fi
  out=$(nix_cmd build --no-link --print-out-paths "$root#nvme-tcp-dkms-$host")
  file=$(< "$out/package-file")
  remote "$host" "set -eu
    d=\$(mktemp -d /var/tmp/nvme-tcp-dkms.XXXXXX)
    trap 'rm -rf \"\$d\"' EXIT
    chmod 0755 \"\$d\"
    cat > \"\$d/$file\"
    case $format in
      deb) sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --allow-downgrades --no-install-recommends \"\$d/$file\" ;;
      pacman) sudo -n pacman -U --noconfirm \"\$d/$file\" ;;
    esac
    # Runtime state of the former download-at-build package.
    sudo -n rm -rf /etc/nvme-tcp-dkms /var/cache/nvme-tcp-dkms
    sudo -n dkms status -m $dkms_name -v $version -k $kernel
  " < "$out/$file"
  echo "installed $file on $host; loaded modules change after a reboot or an explicit reload" >&2
}

(( $# >= 2 )) || usage
command=$1
host=$2
shift 2
case "$command" in
  select)
    baseline=
    while (( $# )); do
      case "$1" in
        --baseline) baseline=${2:?}; shift 2 ;;
        *) usage ;;
      esac
    done
    select_source "$host" "$baseline"
    ;;
  install)
    (( $# == 0 )) || usage
    install_package "$host"
    ;;
  *) usage ;;
esac
