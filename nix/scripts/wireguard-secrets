#!/usr/bin/env bash
set -euo pipefail
root=${HOMELAB_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}
state=${HOMELAB_STATE_DIR:-"$root/.host-state"}
secret_root="$root/nix/secrets/wireguard/hosts"
mkdir -p "$state/receipts" "$state/tmp"
chmod 0700 "$state" "$state/receipts" "$state/tmp"
operator_key_file=${HOMELAB_OPERATOR_AGE_KEY_FILE:-"${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"}
if [ -z "${SOPS_AGE_KEY_FILE:-}" ] && [ -s "$operator_key_file" ]; then
  export SOPS_AGE_KEY_FILE="$operator_key_file"
fi

usage() {
  cat <<'EOF'
Usage: wireguard-secrets <command> [arguments]
  bootstrap-age-identity <host> [--recipient-only]
  import-host <host> [--legacy-directory <path>] [--write]
  copy-k3s-token --from <existing-host> --to <target-host> --check|--write
  gen-psk --link <linkId> --check|--write
  rekey-secrets --recipient <ageRecipient> [--remove <ageRecipient>]
  stage-secrets <host> [--generation <id>]
  rotate-psk --link <linkId>
EOF
}

node_id() { nix eval --raw "$root#topology.nodes.$1.nodeId"; }
link_json() { nix eval --json "$root#topology.requiredLinks" | jq -ec --arg id "$1" '.[] | select(.linkId == $id)'; }
host_mutation_hold_reason() {
  local raw
  raw=$(nix eval --json "$root#topology.nodes.$1.hostMutationHoldReason") || return 1
  printf '%s' "$raw" | jq -r '. // empty'
}
assert_host_mutation_allowed() {
  local host=$1 reason
  reason=$(host_mutation_hold_reason "$host") || {
    echo "$host host mutation hold could not be evaluated" >&2
    return 1
  }
  test -z "$reason" || {
    echo "$host host mutation is held: $reason" >&2
    return 1
  }
}
bundle_for_id() { printf '%s/%s.sops.yaml' "$secret_root" "$1"; }
assert_ciphertext() {
  test -s "$1"
  grep -q '^sops:' "$1"
  grep -q 'ENC\[AES256_GCM' "$1"
  ! grep -Eq '(^|: )[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$' "$1"
}
decrypt_bundle() { sops --decrypt "$1"; }
plaintext_workdir() {
  local runtime=${XDG_RUNTIME_DIR:-}
  if [ -z "$runtime" ] || [ ! -d "$runtime" ] || [ ! -w "$runtime" ]; then
    if [ -d /dev/shm ] && [ -w /dev/shm ]; then runtime=/dev/shm; else runtime=${TMPDIR:-/tmp}; fi
  fi
  test -d "$runtime" && test -w "$runtime"
  umask 077
  mktemp -d "$runtime/homelab-secrets.XXXXXX"
}
atomic_encrypt() {
  local input=$1 output=$2 recipients=$3 temp
  temp=$(mktemp "$state/tmp/ciphertext.XXXXXX")
  trap 'rm -f "$temp"' RETURN
  SOPS_AGE_RECIPIENTS="$recipients" sops --encrypt --input-type yaml --output-type yaml "$input" > "$temp"
  assert_ciphertext "$temp"
  install -d -m 0700 "$(dirname "$output")"
  mv -f "$temp" "$output"
  trap - RETURN
}

case "${1:-}" in
  bootstrap-age-identity)
    host=${2:?host required}; mode=${3:-}
    case "$mode" in ""|--recipient-only) ;; *) usage; exit 2 ;; esac
    if test "$mode" != --recipient-only; then
      assert_host_mutation_allowed "$host"
    fi
    target=$(nix eval --raw "$root#topology.nodes.$host.sshTarget")
    recipient=$(ssh -o BatchMode=yes "$target" "sudo -n sh -ceu '
      identity=/var/lib/homelab/age.key
      if test ! -s \"\$identity\"; then
        test \"$mode\" != --recipient-only
        command -v age-keygen >/dev/null
        install -d -m 0700 /var/lib/homelab
        umask 077
        age-keygen -o \"\$identity\"
        chmod 0600 \"\$identity\"
      fi
      age-keygen -y \"\$identity\"
    '")
    case "$recipient" in age1*) ;; *) echo "invalid age recipient" >&2; exit 1 ;; esac
    printf '%s %s\n' "$host" "$recipient"
    ;;
  import-host)
    host=${2:?host required}; shift 2
    legacy=/etc/wireguard; mode=--check
    while [ "$#" -gt 0 ]; do case "$1" in --legacy-directory) legacy=$2; shift 2 ;; --write) mode=--write; shift ;; *) usage; exit 2 ;; esac; done
    id=$(node_id "$host")
    bundle=$(bundle_for_id "$id")
    target=$(nix eval --raw "$root#topology.nodes.$host.sshTarget")
    operator=$(nix eval --raw "$root#topology.secretRecipients.operator")
    recovery=$(nix eval --raw "$root#topology.secretRecipients.recovery")
    work=$(plaintext_workdir); trap 'rm -rf "$work"' EXIT HUP INT TERM
    printf 'wireguard:\n  privateKeys: {}\n  psks: {}\n' > "$work/bundle.yaml"
    links=$(nix eval --json "$root#topology.requiredLinks")
    while IFS= read -r interface; do
      private_file="$work/$interface-privatekey"
      ssh -n -o BatchMode=yes "$target" "sudo -n cat '$legacy/privatekey'" > "$private_file"
      chmod 0600 "$private_file"
      public=$(wg pubkey < "$private_file")
      expected=$(nix eval --raw "$root#topology.${interface}.nodes.$host.publicKey")
      test "$public" = "$expected"
      INTERFACE="$interface" PRIVATE_FILE="$private_file" yq -i '.wireguard.privateKeys[strenv(INTERFACE)] = (load_str(strenv(PRIVATE_FILE)) | sub("\n+$"; ""))' "$work/bundle.yaml"
      while IFS=$'\t' read -r link peer; do
        psk_file="$work/$link.psk"
        ssh -n -o BatchMode=yes "$target" "sudo -n cat '$legacy/psk-$peer'" > "$psk_file"
        chmod 0600 "$psk_file"
        LINK="$link" PSK_FILE="$psk_file" yq -i '.wireguard.psks[strenv(LINK)] = (load_str(strenv(PSK_FILE)) | sub("\n+$"; ""))' "$work/bundle.yaml"
      done < <(jq -r --arg id "$id" --arg network "$interface" '.[] | select(.network == $network and (.aNodeId == $id or .bNodeId == $id)) | [.linkId,(if .aNodeId == $id then .bName else .aName end)] | @tsv' <<<"$links")
    done < <(nix eval --json "$root#topology.nodes.$host.wireguard" | jq -r '.[]')
    role=$(nix eval --raw "$root#topology.nodes.$host.k3sRole" 2>/dev/null || true)
    if [ "$role" = server ]; then
      ssh -n -o BatchMode=yes "$target" "sudo -n cat /var/lib/rancher/k3s/server/token" > "$work/k3s-token"
      chmod 0600 "$work/k3s-token"
      test -s "$work/k3s-token"
      base64 --wrap=0 "$work/k3s-token" > "$work/k3s-token.b64"
      TOKEN_FILE="$work/k3s-token.b64" yq -i '.k3s.serverTokenBase64 = load_str(strenv(TOKEN_FILE))' "$work/bundle.yaml"
    elif [ "$role" = agent ] && [ -s "$bundle" ]; then
      assert_ciphertext "$bundle"
      decrypt_bundle "$bundle" > "$work/existing.yaml"
      if yq -e '.k3s.serverTokenBase64 | length > 0' "$work/existing.yaml" >/dev/null; then
        yq -r '.k3s.serverTokenBase64' "$work/existing.yaml" | base64 --decode > "$work/existing-k3s-token"
        chmod 0600 "$work/existing-k3s-token"
        base64 --wrap=0 "$work/existing-k3s-token" > "$work/k3s-token.b64"
        TOKEN_FILE="$work/k3s-token.b64" yq -i '.k3s.serverTokenBase64 = load_str(strenv(TOKEN_FILE))' "$work/bundle.yaml"
      fi
    fi
    if [ "$mode" = --write ]; then
      recipient=$("$0" bootstrap-age-identity "$host" --recipient-only | awk '{print $2}')
      case "$operator" in REPLACE_WITH_*) echo "replace the online operator recipient before import" >&2; exit 1 ;; age1*) ;; *) echo "invalid operator recipient" >&2; exit 1 ;; esac
      case "$recovery" in REPLACE_WITH_*) echo "replace the offline recovery recipient before import" >&2; exit 1 ;; age1*) ;; *) echo "invalid recovery recipient" >&2; exit 1 ;; esac
      recipients="$recipient,$operator,$recovery"
      if [ -s "$bundle" ]; then
        assert_ciphertext "$bundle"
        REQUIRED="$recipient" yq -e '.sops.age[].recipient | select(. == strenv(REQUIRED))' "$bundle" >/dev/null
        REQUIRED="$operator" yq -e '.sops.age[].recipient | select(. == strenv(REQUIRED))' "$bundle" >/dev/null
        REQUIRED="$recovery" yq -e '.sops.age[].recipient | select(. == strenv(REQUIRED))' "$bundle" >/dev/null
        recipients=$(yq -r '.sops.age[].recipient' "$bundle" | paste -sd, -)
      fi
      atomic_encrypt "$work/bundle.yaml" "$bundle" "$recipients"
      printf '%s\n' "$bundle"
    else
      yq -e '.wireguard.privateKeys and .wireguard.psks' "$work/bundle.yaml" >/dev/null
      if [ "$role" = server ]; then yq -e '.k3s.serverTokenBase64 | length > 0' "$work/bundle.yaml" >/dev/null; fi
      printf '%s import verified; rerun with --write\n' "$host"
    fi
    ;;
  gen-psk)
    shift; link= mode=
    while [ "$#" -gt 0 ]; do case "$1" in --link) link=$2; shift 2 ;; --check|--write) mode=$1; shift ;; *) usage; exit 2 ;; esac; done
    test -n "$link" && test -n "$mode"
    data=$(link_json "$link")
    test "$(jq -r .managed <<<"$data")" = true || {
      echo "unmanaged link has no repository-owned endpoint bundle; use an explicit delivery channel" >&2
      exit 1
    }
    a=$(jq -r .aNodeId <<<"$data"); b=$(jq -r .bNodeId <<<"$data")
    jq -e '.aName and .bName' <<<"$data" >/dev/null
    a_bundle=$(bundle_for_id "$a"); b_bundle=$(bundle_for_id "$b")
    if [ "$mode" = --check ]; then
      assert_ciphertext "$a_bundle"; assert_ciphertext "$b_bundle"
      ah=$(decrypt_bundle "$a_bundle" | LINK="$link" yq -r '.wireguard.psks[strenv(LINK)]' | sha256sum | cut -d' ' -f1)
      bh=$(decrypt_bundle "$b_bundle" | LINK="$link" yq -r '.wireguard.psks[strenv(LINK)]' | sha256sum | cut -d' ' -f1)
      test "$ah" = "$bh"
      printf '%s %s\n' "$link" "$ah"
    else
      command -v age-keygen >/dev/null; command -v sops >/dev/null; command -v yq >/dev/null
      work=$(plaintext_workdir); trap 'rm -rf "$work"' EXIT HUP INT TERM
      wg genpsk > "$work/generated.psk"
      chmod 0600 "$work/generated.psk"
      while IFS=$'\t' read -r endpoint bundle; do
        decrypt_bundle "$bundle" > "$work/$endpoint.yaml"
        PSK_FILE="$work/generated.psk" LINK="$link" yq -i '.wireguard.psks[strenv(LINK)] = (load_str(strenv(PSK_FILE)) | sub("\n+$"; ""))' "$work/$endpoint.yaml"
        recipients=$(yq -r '.sops.age[].recipient' "$bundle" | paste -sd, -)
        atomic_encrypt "$work/$endpoint.yaml" "$work/$endpoint.sops.yaml" "$recipients"
      done <<EOF
$a	$a_bundle
$b	$b_bundle
EOF
      for endpoint in "$a" "$b"; do mv -f "$work/$endpoint.sops.yaml" "$(bundle_for_id "$endpoint")"; done
      "$0" gen-psk --link "$link" --check >/dev/null
      printf 'generated %s\n' "$link"
    fi
    ;;
  rekey-secrets)
    shift; add= remove=
    while [ "$#" -gt 0 ]; do case "$1" in --recipient) add=$2; shift 2 ;; --remove) remove=$2; shift 2 ;; *) usage; exit 2 ;; esac; done
    test -n "$add"
    work=$(plaintext_workdir); trap 'rm -rf "$work"' EXIT HUP INT TERM
    for bundle in "$secret_root"/*.sops.yaml; do
      assert_ciphertext "$bundle"
      base=$(basename "$bundle")
      decrypt_bundle "$bundle" > "$work/$base.plain"
      recipients=$(yq -r '.sops.age[].recipient' "$bundle" | { cat; printf '%s\n' "$add"; } | awk 'NF' | sort -u | { if [ -n "$remove" ]; then grep -Fvx "$remove"; else cat; fi; } | paste -sd, -)
      atomic_encrypt "$work/$base.plain" "$work/$base" "$recipients"
      decrypt_bundle "$work/$base" >/dev/null
    done
    for candidate in "$work"/*.sops.yaml; do mv -f "$candidate" "$secret_root/$(basename "$candidate")"; done
    printf 'rekeyed bundles; target rollout ACK is required before removing the old host identity\n'
    ;;
  copy-k3s-token)
    shift; source_host= target_host= mode=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --from) source_host=$2; shift 2 ;;
        --to) target_host=$2; shift 2 ;;
        --check|--write) mode=$1; shift ;;
        *) usage; exit 2 ;;
      esac
    done
    test -n "$source_host" && test -n "$target_host" && test -n "$mode"
    target_role=$(nix eval --raw "$root#topology.nodes.$target_host.k3sRole" 2>/dev/null || true)
    test "$target_role" = server || test "$target_role" = agent
    source_role=$(nix eval --raw "$root#topology.nodes.$source_host.k3sRole" 2>/dev/null || true)
    test "$source_role" = server || { echo "K3s token source must be a server" >&2; exit 1; }
    source_target=$(nix eval --raw "$root#topology.nodes.$source_host.sshTarget")
    target_bundle=$(bundle_for_id "$(node_id "$target_host")")
    assert_ciphertext "$target_bundle"
    work=$(plaintext_workdir); trap 'rm -rf "$work"' EXIT HUP INT TERM
    ssh -n -o BatchMode=yes "$source_target" "sudo -n cat /var/lib/rancher/k3s/server/token" > "$work/source-token"
    chmod 0600 "$work/source-token"
    test -s "$work/source-token"
    base64 --wrap=0 "$work/source-token" > "$work/source-token.b64"
    decrypt_bundle "$target_bundle" > "$work/target.yaml"
    if [ "$mode" = --check ]; then
      yq -e '.k3s.serverTokenBase64 | length > 0' "$work/target.yaml" >/dev/null
      yq -r '.k3s.serverTokenBase64' "$work/target.yaml" | base64 --decode > "$work/target-token"
      cmp "$work/source-token" "$work/target-token"
      printf '%s K3s token matches %s\n' "$target_host" "$source_host"
    else
      TOKEN_FILE="$work/source-token.b64" yq -i '.k3s.serverTokenBase64 = load_str(strenv(TOKEN_FILE))' "$work/target.yaml"
      recipients=$(yq -r '.sops.age[].recipient' "$target_bundle" | paste -sd, -)
      atomic_encrypt "$work/target.yaml" "$work/target.sops.yaml" "$recipients"
      mv -f "$work/target.sops.yaml" "$target_bundle"
      printf '%s K3s token ciphertext updated from %s\n' "$target_host" "$source_host"
    fi
    ;;
  stage-secrets)
    host=${2:?host required}; shift 2
    assert_host_mutation_allowed "$host"
    generation=$(date -u +%Y%m%dT%H%M%SZ)
    if [ "${1:-}" = --generation ]; then generation=${2:?generation required}; fi
    id=$(node_id "$host"); bundle=$(bundle_for_id "$id"); assert_ciphertext "$bundle"
    local_stage=$(plaintext_workdir); trap 'rm -rf "$local_stage"' EXIT HUP INT TERM
    decrypt_bundle "$bundle" > "$local_stage/bundle.yaml"
    mkdir -p "$local_stage/tree"
    chmod 0700 "$local_stage/tree"
    yq -e '.wireguard.privateKeys and .wireguard.psks' "$local_stage/bundle.yaml" >/dev/null
    role=$(nix eval --raw "$root#topology.nodes.$host.k3sRole" 2>/dev/null || true)
    if [ "$role" = server ] || [ "$role" = agent ]; then
      yq -e '.k3s.serverTokenBase64 | length > 0' "$local_stage/bundle.yaml" >/dev/null
      yq -r '.k3s.serverTokenBase64' "$local_stage/bundle.yaml" \
        | base64 --decode > "$local_stage/tree/k3s-token"
      chmod 0600 "$local_stage/tree/k3s-token"
    fi
    while IFS=$'\t' read -r interface key; do
      printf '%s\n' "$key" > "$local_stage/tree/$interface-private"
      chmod 0600 "$local_stage/tree/$interface-private"
    done < <(yq -r '.wireguard.privateKeys | to_entries[] | [.key,.value] | @tsv' "$local_stage/bundle.yaml")
    links=$(nix eval --json "$root#topology.requiredLinks")
    while IFS=$'\t' read -r link psk; do
      interface=${link%%-*}
      peer=$(jq -er --arg link "$link" --arg id "$id" '
        .[] | select(.linkId == $link)
        | if .aNodeId == $id then .bName elif .bNodeId == $id then .aName else empty end
      ' <<<"$links")
      case "$peer" in *[!A-Za-z0-9._-]*|'') echo "invalid peer credential name for $link" >&2; exit 1 ;; esac
      credential_peer=${peer//./-}
      printf '%s\n' "$psk" > "$local_stage/tree/$interface-psk-$credential_peer"
      chmod 0600 "$local_stage/tree/$interface-psk-$credential_peer"
    done < <(yq -r '.wireguard.psks | to_entries[] | [.key,.value] | @tsv' "$local_stage/bundle.yaml")
    target=$(nix eval --raw "$root#topology.nodes.$host.sshTarget")
    tar -C "$local_stage/tree" -cf - . | ssh -o BatchMode=yes "$target" "sudo -n sh -ceu '
      umask 077
      base=/var/lib/homelab-secrets
      generation_path=\"\$base/generations/$generation\"
      new_target=\"generations/$generation\"
      staging=\$(mktemp -d /run/homelab-secret-stage.XXXXXX)
      generation_created=
      generation_committed=
      cleanup_stage() {
        rm -rf -- \"\$staging\"
        if test \"\$generation_created\" = yes && test \"\$generation_committed\" != yes; then
          rm -rf -- \"\$generation_path\"
        fi
      }
      trap cleanup_stage EXIT HUP INT TERM
      tar -C \"\$staging\" -xf -
      install -d -m 0700 \"\$base\" \"\$base/generations\"
      test ! -e \"\$generation_path\"
      install -d -m 0700 \"\$generation_path\"
      generation_created=yes
      systemd-creds setup >/dev/null
      count=0
      for plaintext in \"\$staging\"/*; do
        test -f \"\$plaintext\"
        credential=\${plaintext##*/}
        case \"\$credential\" in \"\"|*[!A-Za-z0-9_.-]*) exit 1 ;; esac
        test -s \"\$plaintext\"
        encrypted=\"\$generation_path/\$credential.cred\"
        systemd-creds encrypt --with-key=host --name=\"\$credential\" \"\$plaintext\" \"\$encrypted\" >/dev/null
        chmod 0600 \"\$encrypted\"
        systemd-creds decrypt --name=\"\$credential\" \"\$encrypted\" - | cmp - \"\$plaintext\"
        count=\$((count + 1))
      done
      test \"\$count\" -gt 0
      read_target() { test -L \"\$1\" && readlink \"\$1\" || true; }
      active_target=\$(read_target \"\$base/active\")
      previous_target=\$(read_target \"\$base/previous\")
      test -z \"\$active_target\" || test -d \"\$base/\$active_target\"
      test -z \"\$previous_target\" || test -d \"\$base/\$previous_target\"
      if test -n \"\$previous_target\" && test \"\$previous_target\" != \"\$active_target\"; then
        rm -rf -- \"\$base/\$previous_target\"
      fi
      rm -f \"\$base/previous\" \"\$base/previous.new\" \"\$base/active.new\"
      if test -n \"\$active_target\"; then
        ln -s \"\$active_target\" \"\$base/previous.new\"
        mv -Tf \"\$base/previous.new\" \"\$base/previous\"
      fi
      ln -s \"\$new_target\" \"\$base/active.new\"
      mv -Tf \"\$base/active.new\" \"\$base/active\"
      for candidate in \"\$base\"/generations/*; do
        test -d \"\$candidate\" || continue
        relative=\"generations/\${candidate##*/}\"
        test \"\$relative\" = \"\$new_target\" || test \"\$relative\" = \"\$active_target\" \
          || rm -rf -- \"\$candidate\"
      done
      generation_committed=yes
    '"
    printf '%s %s\n' "$host" "$generation"
    ;;
  rotate-psk)
    shift; test "${1:-}" = --link; link=${2:?link required}
    data=$(link_json "$link")
    managed=$(jq -r .managed <<<"$data")
    test "$managed" = true || { echo "unmanaged link requires an explicit delivery channel and applied ACK; unchanged" >&2; exit 1; }
    "$0" gen-psk --link "$link" --write
    printf 'PSK ciphertext updated; coordinated endpoint stage/switch/handshake ACK is required before receipt commit\n'
    ;;
  *) usage; exit 2 ;;
esac
