      "credentials": {
        "httpHeaderAuth": {
          "id": "iaBridgeOps00001",
          "name": "issue-agent-bridge-ops"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body ?? {}) }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      },
      "id": "6670bd83-ff5a-5660-b3a0-6780c2c9a351",
      "name": "Respond with bridge result",
