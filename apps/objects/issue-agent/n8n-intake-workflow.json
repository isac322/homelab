            {
              "name": "X-GitHub-Delivery",
              "value": "={{ $json.headers['x-github-delivery'] ?? '' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "0ca39290-b8da-5191-985f-4e7299cb86f8",
