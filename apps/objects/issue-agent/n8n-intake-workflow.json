      "id": "d13f01f8-2c3a-50e3-84af-79fe83fc5c65",
      "name": "Respond bridge unavailable",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
