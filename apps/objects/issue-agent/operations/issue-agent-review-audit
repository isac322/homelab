def is_important(severity, blocking):
    return severity in IMPORTANT_SEVERITIES or (severity in IMPORTANT_IF_BLOCKING and blocking is True)


def severity_gap(bot_severity, adjudicated):
    """adjudicated rank - bot rank (positive: the bot rated it more severe)."""
    if bot_severity not in IMPORTANT_SEVERITIES | {"P2", "P3"} or adjudicated not in KAPPA_SEVERITY_SCALE:
        return None
    return SEVERITY_RANK[adjudicated] - SEVERITY_RANK[bot_severity]


def severity_inflated(bot_severity, label):
    """Derived SEVERITY_INFLATED (D4); raters never assign it."""
    if label.get("validity") != "valid":
        return False
    gap = severity_gap(bot_severity, label.get("adjudicated_severity"))
    if gap is None:
        return False
    return gap >= INFLATION_MIN_LEVELS or (label.get("adjudicated_severity") == "nit"
                                           and bot_severity in INFLATED_IF_NIT_FROM)


def finding_codes(bot_severity, label):
    """Rater codes plus derived INVALID / SEVERITY_INFLATED, without DUPLICATE."""
    codes = {c for c in (label.get("noise_codes") or []) if c != DUPLICATE_CODE}
    if label.get("validity") == "invalid":
        codes.add(INVALID_CODE)
    if severity_inflated(bot_severity, label):
        codes.add(INFLATED_CODE)
    return codes


def is_noise(bot_severity, label):
    return bool(finding_codes(bot_severity, label) & NOISE_CODES)


def load_jsonl(path, bad, label):
    rows = []
    with open(path, encoding="utf-8") as handle:
        for number, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except ValueError as exc:
                bad.append({"file": label, "line": number, "id": None, "reason": "invalid JSON: %s" % exc})
                continue
            if not isinstance(row, dict):
                bad.append({"file": label, "line": number, "id": None, "reason": "not an object"})
                continue
            row["_line"] = number
            rows.append(row)
    return rows


def _check_enum(row, name, required, errors, vocab=None):
    value = row.get(name)
    if value is None:
        if required:
            errors.append("missing %s" % name)
        return
    if value not in (vocab or VOCAB[name]):
        errors.append("%s=%r not in vocabulary" % (name, value))


def _check_bool(row, name, errors, required=False):
    if name not in row or row[name] is None:
        if required:
            errors.append("missing %s" % name)
        return
    if not isinstance(row[name], bool):
        errors.append("%s must be a boolean" % name)


def _check_rater(row, errors):
    if not isinstance(row.get("rater"), str) or not row["rater"].strip():
        errors.append("missing rater")


def validate_finding_label(row, units):
    errors = []
    if not isinstance(row.get("id"), str) or row["id"] not in units["findings"]:
        errors.append("unknown finding id")
    _check_rater(row, errors)
    partial = row.get("rater") in PARTIAL_RATERS
    _check_enum(row, "validity", True, errors)
    _check_enum(row, "adjudicated_severity", not partial, errors)
    for name in ("value", "author_action", "defect_type", "file_type"):
        _check_enum(row, name, False, errors)
    for name in (BLOCKING_FIELD, "irr_sample"):
        _check_bool(row, name, errors)
    codes = row.get("noise_codes") or []
    if not isinstance(codes, list):
        errors.append("noise_codes must be a list")
    else:
        for code in codes:
            if code in DERIVED_CODES:
                errors.append("%s is derived by metrics and must not be labelled" % code)
            elif code not in VOCAB["noise_codes"]:
                errors.append("noise code %r not in vocabulary" % (code,))
    if row.get("adjudicated_severity") == "none" and row.get("validity") == "valid":
        errors.append("adjudicated_severity none requires validity != valid")
    if row.get(BLOCKING_FIELD) is True and row.get("adjudicated_severity") not in IMPORTANT_IF_BLOCKING:
        errors.append("%s applies only to adjudicated P2" % BLOCKING_FIELD)
    key = row.get("dedup_key")
    if key is not None and not isinstance(key, str):
        errors.append("dedup_key must be a string")
    if (row.get("rater") == FINAL_RATER and row.get("validity") == "valid" and not key
            and is_important(row.get("adjudicated_severity"), row.get(BLOCKING_FIELD))):
        errors.append("dedup_key required on a final valid important finding (bot_finding hit row)")
    return errors


def miss_base_id(item_id):
    """Miss-row id without its `@<head12>` suffix (`<candidate-id>[.<k>]@<head12>`)."""
    match = HEAD_SUFFIX_RE.match(item_id or "")
    return match.group("base") if match else item_id


def candidate_of(item_id, units):
    """Candidate for a miss-row id `<candidate-id>[.<k>][@<head12>]`."""
    base = miss_base_id(item_id)
    cand = units["candidates"].get(base)
    if cand is None and base:
        match = SPLIT_ID_RE.match(base)
        if match:
            cand = units["candidates"].get(match.group("base"))
    return cand


def miss_pr_id(item_id, units):
    cand = candidate_of(item_id, units)
    return cand["pr_id"] if cand else pr_id_of(item_id)


def validate_miss_label(row, units):
    errors = []
    pr = None
    if not isinstance(row.get("id"), str):
        errors.append("missing id")
    else:
        pr = miss_pr_id(row["id"], units)
        if pr not in units["prs"]:
            errors.append("id does not resolve to a collected PR")
    _check_rater(row, errors)
    _check_bool(row, "out_of_horizon", errors)
    _check_bool(row, "coverage_only", errors)
    coverage_only = row.get("coverage_only") is True  # fixed before any published bot review
    if row.get("out_of_horizon") is True:  # past the evidence horizon: kept for audit, excluded from figures
        return errors
    partial = row.get("rater") in PARTIAL_RATERS
    if row.get("channel") == GENERATED_CHANNEL:
        errors.append("channel %s is generated by metrics, never labelled" % GENERATED_CHANNEL)
    else:
        _check_enum(row, "channel", not partial, errors)
    _check_enum(row, "verdict", not partial, errors)
    _check_bool(row, "is_defect", errors, required=not partial)
    for name in (BLOCKING_FIELD, "irr_sample", "exposed_by_pr", "repo_rule"):
        _check_bool(row, name, errors)
    defect = row.get("is_defect") is True and not partial
    _check_enum(row, "present_at_reviewed_head", defect, errors)
    _check_enum(row, "adjudicated_severity", defect, errors)
    _check_enum(row, "bot_match", partial, errors)
    _check_enum(row, "defect_type", False, errors)
    _check_enum(row, "file_type", False, errors)
    if row.get("exposed_by_pr") is True and row.get("verdict") != IMPORTANT_MISS_VERDICT:
        errors.append("exposed_by_pr requires verdict %s" % IMPORTANT_MISS_VERDICT)
    heads = units.get("_heads", {}).get(pr, {})
    for name, required in (("reviewed_head_sha", defect and not coverage_only),
                           ("latest_present_head", defect and not coverage_only)):
        value = row.get(name)
        if value is None:
            if required:
                errors.append("missing %s" % name)
        elif value not in heads:
            errors.append("%s is not a bot-reviewed head of the PR" % name)
    suffix = HEAD_SUFFIX_RE.match(row.get("id") or "")
    if suffix and row.get("reviewed_head_sha") and not row["reviewed_head_sha"].startswith(suffix.group("head")):
        errors.append("id @<head12> suffix does not match reviewed_head_sha")
    if (defect and not coverage_only and row.get("verdict") == IMPORTANT_MISS_VERDICT
            and row.get("present_at_reviewed_head") == IMPORTANT_MISS_PRESENT
            and is_important(row.get("adjudicated_severity"), row.get(BLOCKING_FIELD))
            and row.get("bot_match") is None):
        errors.append("bot_match required for an important defect present at the reviewed head")
    matched = row.get("matched_finding_id")
    if matched is not None and matched not in units["findings"]:
        errors.append("matched_finding_id not in findings.jsonl")
    if row.get("review_id") is not None and row["review_id"] not in units["reviews"]:
        errors.append("review_id not in reviews.jsonl")
    if row.get("bot_match") == "hit" and matched is None:
        errors.append("bot_match hit requires matched_finding_id")
    if row.get("bot_match") == "partial" and matched is None and row.get("review_id") is None:
        errors.append("bot_match partial requires matched_finding_id or review_id")
    _check_bool(row, "match_sample", errors)
    sources = row.get("sources")
    if sources is not None and (not isinstance(sources, list) or any(s not in VOCAB["channel"] for s in sources)):
        errors.append("sources must be a list of channels")
    if row.get("dedup_key") is not None and not isinstance(row["dedup_key"], str):
        errors.append("dedup_key must be a string")
    return errors


def split_raters(rows, validator, units, bad, label):
    """Validate rows; return (final rows by id, {rater: {id: row}} for every rater)."""
    by_rater, seen = defaultdict(dict), set()
    for row in rows:
        errors = validator(row, units)
        key = (row.get("id"), row.get("rater"))
        if not errors and key in seen:
            errors = ["duplicate (id, rater)"]
        if errors:
            bad.append({"file": label, "line": row.get("_line"), "id": row.get("id"), "reason": "; ".join(errors)})
            continue
        seen.add(key)
        by_rater[row["rater"]][row["id"]] = row
    return dict(by_rater.get(FINAL_RATER, {})), dict(by_rater)


