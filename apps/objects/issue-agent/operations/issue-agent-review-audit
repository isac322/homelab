def finding_addressed(finding, label=None):
    """D12 (Turzo & Bosu): an auditor author_action overrides the heuristics; otherwise
    changed_in_vicinity_1 OR an explicit ack. The bot's own "Closed" status is never used."""
    action = (label or {}).get("author_action")
    if action == "addressed":
        return True
    if action in ("rejected", "ignored"):
        return False
    return finding.get("changed_in_vicinity_1") is True or finding.get("author_reply_kind") == "ack"


def finding_rejected(finding, label=None):
    action = (label or {}).get("author_action")
    if action in ("addressed", "rejected", "ignored"):
        return action == "rejected"
    return finding.get("author_reply_kind") == "reject"


