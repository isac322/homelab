def _figure_at(figures, path):
    node = figures
    for part in path:
        if not isinstance(node, dict) or part not in node:
            return None
        node = node[part]
    return node


def compare_results(baseline, after):
    """D13: primary endpoints (Newcombe + Fisher for proportions, conditional binomial for
    per-PR counts) and Newcombe for every other top-level proportion (descriptive)."""
    fb, fa = baseline.get("figures", {}), after.get("figures", {})
    out = {"comparison": {}, "descriptive": {}, "warnings": []}
    if baseline.get("evidence_days") != after.get("evidence_days"):
        out["warnings"].append("evidence_days differ: baseline %s, after %s"
                               % (baseline.get("evidence_days"), after.get("evidence_days")))
    primary = set()
    for name, path, test in PRIMARY_ENDPOINTS:
        primary.add(path[0])
        b, a = _figure_at(fb, path), _figure_at(fa, path)
        if not (b and a and "overall" in b and "overall" in a):
            out["comparison"][name] = {"status": "missing"}
            continue
        bo, ao = b["overall"], a["overall"]
        entry = {"test": test, "baseline": {k: bo.get(k) for k in ("k", "n", "rate")},
                 "after": {k: ao.get(k) for k in ("k", "n", "rate")}}
        if test == "proportion":
            entry["newcombe"] = newcombe_diff(bo["k"], bo["n"], ao["k"], ao["n"])
            entry["fisher_p"] = fisher_exact(ao["k"], ao["n"] - ao["k"], bo["k"], bo["n"] - bo["k"])
        else:
            entry["conditional_binomial"] = conditional_binomial(bo["k"], bo["n"], ao["k"], ao["n"])
        out["comparison"][name] = entry
    for name in sorted(set(fa) & set(fb)):
        b, a = fb[name], fa[name]
        if name in primary or not (isinstance(a, dict) and isinstance(b, dict)):
            continue
        bo, ao = b.get("overall"), a.get("overall")
        if not (isinstance(bo, dict) and isinstance(ao, dict) and "ci95" in ao and "ci95" in bo):
            continue
        out["descriptive"][name] = {"baseline": {k: bo.get(k) for k in ("k", "n", "rate")},
                                    "after": {k: ao.get(k) for k in ("k", "n", "rate")},
                                    "newcombe": newcombe_diff(bo["k"], bo["n"], ao["k"], ao["n"])}
    return out


def panel_target_head(coverage_row, pr_reviews):
    """D8: latest bot-reviewed head before the first non-PR-author fix commit; else the first
    GREEN head (body verdict); else the final bot-reviewed head. Returns (sha, rule)."""
    commits = (coverage_row or {}).get("heads") or []
    foreign = (coverage_row or {}).get("first_foreign_commit_after_review")
    if foreign and foreign in commits:
        cut = commits.index(foreign)
        before = [h for h in coverage_row.get("bot_reviewed_heads") or [] if h in commits and commits.index(h) < cut]
        if before:
            return before[-1], "pre_foreign_fix"
    ordered = sorted(pr_reviews, key=lambda r: (r.get("submitted_at") or "", r["id"]))
    for review in ordered:
        if (review.get("verdict") or review_verdict(review.get("body"), review.get("event"))) == APPROVE_VERDICT:
            return review.get("reviewed_head_sha"), "first_green"
    return (ordered[-1].get("reviewed_head_sha"), "final_reviewed") if ordered else (None, "none")


def draw_panel(units, seed, n):
    """D8 seeded stratified draw over repo x verdict (last in-window bot verdict), excluding
    automation PRs; proportional allocation by largest remainder."""
    reviews = [r for r in units["reviews"].values()
               if r.get("is_bot") and not r.get("is_reply_container")]
    by_pr = defaultdict(list)
    for r in reviews:
        by_pr[r["pr_id"]].append(r)
    strata = defaultdict(list)
    for pr_id, pr_reviews in sorted(by_pr.items()):
        window = sorted((r for r in pr_reviews if r.get("in_window", True)), key=lambda r: r.get("submitted_at") or "")
        pr = units["prs"].get(pr_id, {})
        if not window or pr.get("author_type") == "automation":
            continue
        last = window[-1]
        strata["%s|%s" % (pr.get("repo"), last.get("verdict") or review_verdict(last.get("body"), last.get("event")))
               ].append(pr_id)
    total = sum(len(v) for v in strata.values())
    take = min(n, total)
    alloc = {}
    if total:
        quotas = {s: take * len(v) / total for s, v in strata.items()}
        alloc = {s: int(math.floor(q)) for s, q in quotas.items()}
        remainder = take - sum(alloc.values())
        for s in sorted(quotas, key=lambda s: (-(quotas[s] - alloc[s]), s))[:remainder]:
            alloc[s] += 1
    rng = random.Random(seed)
    chosen, strata_out = [], []
    for stratum in sorted(strata):
        members = sorted(strata[stratum])
        picked = sorted(rng.sample(members, min(alloc.get(stratum, 0), len(members))))
        strata_out.append({"stratum": stratum, "eligible": len(members), "drawn": len(picked)})
        for pr_id in picked:
            head, rule = panel_target_head((units.get("coverage") or {}).get(pr_id), by_pr[pr_id])
            chosen.append({"pr_id": pr_id, "target_head_sha": head, "target_rule": rule, "stratum": stratum})
    return {"seed": seed, "n": n, "strata": strata_out, "prs": chosen}


