def load_units(directory):
    units = {}
    for name, fname, required in (("prs", "prs.jsonl", True), ("reviews", "reviews.jsonl", True),
                                  ("findings", "findings.jsonl", True), ("candidates", "candidates.jsonl", True),
                                  ("coverage", "coverage.jsonl", False)):
        path = os.path.join(directory, fname)
        rows = {}
        if not os.path.exists(path):
            if required:
                sys.exit("issue-agent-review-audit: %s is missing" % path)
        else:
            with open(path, encoding="utf-8") as handle:
                for line in handle:
                    if line.strip():
                        row = json.loads(line)
                        rows[row["id"]] = row
        units[name] = rows
    for name, fname in (("panel", "panel.json"), ("manifest", "manifest.json")):
        path = os.path.join(directory, fname)
        units[name] = json.load(open(path, encoding="utf-8")) if os.path.exists(path) else None
    return units


def _fmt_summary(summary):
    if summary is None:
        return "n/a"
    if "count" in summary:
        return "%d" % summary["count"]
    if "kappa" in summary:
        if summary["kappa"] is None:
            return "n=%d kappa n/a" % summary["n"]
        return "n=%d kappa=%.3f [%.3f, %.3f] raw=%.3f pabak=%.3f" % (
            summary["n"], summary["kappa"], summary["ci95"][0], summary["ci95"][1], summary["raw"], summary["pabak"])
    if summary.get("rate") is None:
        return "%s/%s (n/a)" % (summary.get("k"), summary.get("n"))
    text = "%s/%s = %.3f" % (summary["k"], summary["n"], summary["rate"])
    ci = summary.get("ci95")
    if ci and ci[0] is not None:
        text += " [%.3f, %.3f]" % (ci[0], ci[1])
    if summary.get("status"):
        text += " (%s)" % summary["status"]
    return text


def _render(lines, name, node):
    if isinstance(node, dict) and "overall" in node:
        lines.append("## %s" % name)
        lines.append("Overall: " + _fmt_summary(node["overall"]))
        nested = []
        for key, value in node.items():
            if key in ("overall", "breakdown"):
                continue
            if isinstance(value, dict) and ("overall" in value or "k" in value or "count" in value):
                nested.append((key, value))
            else:
                lines.append("%s: %s" % (key, json.dumps(value, sort_keys=True)))
        if node.get("breakdown"):
            lines += ["", "| dimension | value | figure |", "|---|---|---|"]
            for dim, values in node["breakdown"].items():
                for value, summary in values.items():
                    lines.append("| %s | %s | %s |" % (dim, value, _fmt_summary(summary)))
        lines.append("")
        for key, value in nested:
            if "overall" in value:
                _render(lines, "%s.%s" % (name, key), value)
            else:
                lines += ["## %s.%s" % (name, key), _fmt_summary(value), ""]
    elif isinstance(node, dict) and ("kappa" in node or "k" in node or "count" in node):
        lines += ["## %s" % name, _fmt_summary(node), ""]
    elif isinstance(node, dict) and node:
        scalars = {k: v for k, v in node.items() if not isinstance(v, dict)}
        if scalars:
            lines += ["## %s" % name] + ["%s: %s" % (k, json.dumps(v, sort_keys=True)) for k, v in scalars.items()]
            lines.append("")
        for key, value in node.items():
            if isinstance(value, dict):
                _render(lines, "%s.%s" % (name, key), value)
    else:
        lines += ["## %s" % name, json.dumps(node, sort_keys=True), ""]


def render_md(result):
    lines = ["# haechibot review audit metrics", ""]
    lines.append("Evidence horizon: %s days" % result.get("evidence_days"))
    lines.append("Coverage: " + ", ".join("%s=%s" % kv for kv in result["coverage"].items()))
    lines.append("")
    for name, _ in METRIC_KEYS:
        _render(lines, name, result["figures"].get(name))
    if result["bad_rows"]:
        lines.append("## bad rows (excluded)")
        for row in result["bad_rows"]:
            lines.append("- %s line %s id=%s: %s" % (row["file"], row["line"], row["id"], row["reason"]))
    return "\n".join(lines) + "\n"


def cmd_metrics(args):
    units = load_units(args.dir)
    bad = []
    paths = {
        "labels_findings": args.labels_findings or os.path.join(args.dir, "labels-findings.jsonl"),
        "labels_misses": args.labels_misses or os.path.join(args.dir, "labels-misses.jsonl"),
        "labels_judge": args.labels_judge or os.path.join(args.dir, "labels-judge.jsonl"),
        "labels_matcher": args.labels_matcher or os.path.join(args.dir, "labels-matcher.jsonl"),
    }
    rows = {name: load_jsonl(path, bad, name.replace("_", "-")) if os.path.exists(path) else []
            for name, path in paths.items()}
    exclude = [pr if "/" in pr else "%s/%s" % (OWNER, pr) for pr in args.exclude_pr or []]
    for pr in exclude:
        if not PR_ID_RE.fullmatch(pr):
            sys.exit("issue-agent-review-audit: invalid --exclude-pr %r (want [OWNER/]REPO#N)" % pr)
    evidence_days = (((units.get("manifest") or {}).get("args") or {}).get("evidence_days"))
    result = compute_metrics(units, rows["labels_findings"], rows["labels_misses"], evidence_days,
                             judge_rows=rows["labels_judge"], matcher_rows=rows["labels_matcher"],
                             exclude_prs=exclude)
    result["bad_rows"] = bad + result["bad_rows"]
    result["inputs"] = {"dir": args.dir, "panel": bool(units.get("panel")),
                        **{name: path if rows[name] else None for name, path in paths.items()}}
    if args.format == "json":
        print(json.dumps(result, indent=1, sort_keys=True))
    else:
        sys.stdout.write(render_md(result))


def cmd_compare(args):
    with open(args.before, encoding="utf-8") as handle:
        baseline = json.load(handle)
    with open(args.after, encoding="utf-8") as handle:
        after = json.load(handle)
    result = compare_results(baseline, after)
    if args.format == "json":
        print(json.dumps(result, indent=1, sort_keys=True))
        return
    lines = ["# before/after comparison (after - baseline)", ""]
    lines += ["warning: %s" % w for w in result["warnings"]]
    for section in ("comparison", "descriptive"):
        lines += ["", "## %s" % section]
        for name, entry in result[section].items():
            lines.append("- %s: %s" % (name, json.dumps(entry, sort_keys=True)))
    sys.stdout.write("\n".join(lines) + "\n")


def _rows_for_rater(rows, rater, bad, label):
    """{id: row} for one rater; without --rater, the `final` row or the only row per id."""
    by_id = defaultdict(list)
    for row in rows:
        if isinstance(row.get("id"), str):
            by_id[row["id"]].append(row)
    out = {}
    for item_id, group in by_id.items():
        picked = [r for r in group if r.get("rater") == rater] if rater else (
            [r for r in group if r.get("rater") == FINAL_RATER] or group)
        if len(picked) == 1:
            out[item_id] = picked[0]
        elif len(picked) > 1:
            bad.append({"file": label, "line": picked[1].get("_line"), "id": item_id,
                        "reason": "several rows for one rater; pass --rater-a/--rater-b"})
    return out


def cmd_kappa(args):
    bad = []
    rows_a = _rows_for_rater(load_jsonl(args.a, bad, "a"), args.rater_a, bad, "a")
    rows_b = _rows_for_rater(load_jsonl(args.b, bad, "b"), args.rater_b, bad, "b")
    fields = set(args.field or [f[0] for f in KAPPA_FIELDS])
    result = {"agreement": {k: v for k, v in agreement(rows_a, rows_b, irr_only=not args.all_items).items()
                            if v["n"] and k in fields},
              "irr_sample_only": not args.all_items, "bad_rows": bad}
    if args.format == "json":
        print(json.dumps(result, indent=1, sort_keys=True))
        return
    lines = ["# agreement (%s)" % ("irr_sample items" if not args.all_items else "all shared items"), ""]
    for name, stats in result["agreement"].items():
        lines.append("- %s: %s pos=%s neg=%s" % (name, _fmt_summary(stats), stats["pos"], stats["neg"]))
    for row in bad:
        lines.append("- bad row %s line %s id=%s: %s" % (row["file"], row["line"], row["id"], row["reason"]))
    sys.stdout.write("\n".join(lines) + "\n")


def cmd_panel_draw(args):
    units = load_units(args.dir)
    panel = draw_panel(units, args.seed, args.n)
    path = os.path.join(args.dir, "panel.json")
    try:
        write_private(path, json.dumps(panel, indent=1, sort_keys=True) + "\n")
    except FileExistsError:
        sys.exit("issue-agent-review-audit: %s already exists; refusing to overwrite" % path)
    print("panel prs=%d strata=%d -> %s" % (len(panel["prs"]), len(panel["strata"]), path))


def build_parser():
    parser = argparse.ArgumentParser(
        prog="issue-agent-review-audit",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)
    collect = sub.add_parser("collect", help="collect read-only GitHub evidence into unit files",
                             description="Collect read-only GitHub evidence. See the top-level --help for "
                                         "output files and heuristics.")
    collect.add_argument("--since", required=True, help="window start, inclusive (ISO-8601)")
    collect.add_argument("--until", required=True, help="window end, exclusive (ISO-8601)")
    collect.add_argument("--out", required=True, help="new output directory (0700); refused if it exists")
    collect.add_argument("--repo", action="append", help="OWNER/NAME, repeatable (default: the six bot repos)")
    collect.add_argument("--reviewer", default=DEFAULT_REVIEWER, help="bot reviewer login (default %(default)s)")
    collect.add_argument("--evidence-days", type=float, default=DEFAULT_EVIDENCE_DAYS,
                         help="evidence horizon H in days: candidates count only if event <= anchor + H "
                              "(default %(default)s; also the post-merge window)")
    collect.set_defaults(func=cmd_collect)
    metrics = sub.add_parser("metrics", help="compute report figures from label files",
                             description="Join label files with unit files and print the METRIC_KEYS figures "
                                         "with Wilson 95% intervals. See the top-level --help for definitions.")
    metrics.add_argument("--dir", required=True, help="directory written by collect")
    metrics.add_argument("--labels-findings", help="labels-findings.jsonl (default DIR/labels-findings.jsonl)")
    metrics.add_argument("--labels-misses", help="labels-misses.jsonl (default DIR/labels-misses.jsonl)")
    metrics.add_argument("--labels-judge", help="labels-judge.jsonl, judge_bias only (default DIR/labels-judge.jsonl)")
    metrics.add_argument("--labels-matcher",
                         help="labels-matcher.jsonl, match_kappa only (default DIR/labels-matcher.jsonl)")
    metrics.add_argument("--exclude-pr", action="append", metavar="[OWNER/]REPO#N",
                         help="drop a PR and its label rows (repeatable; e.g. the kwin-mcp gold-set PRs)")
    metrics.add_argument("--format", choices=("md", "json"), default="md", help="output format (default md)")
    metrics.set_defaults(func=cmd_metrics)
    compare = sub.add_parser("compare", help="before/after tests on two `metrics --format json` outputs",
                             description="Newcombe difference CIs, Fisher exact and conditional binomial tests "
                                         "for the D13 primary endpoints (after - baseline).")
    compare.add_argument("--before", required=True, help="metrics JSON of the baseline window")
    compare.add_argument("--after", required=True, help="metrics JSON of the after window")
    compare.add_argument("--format", choices=("md", "json"), default="md", help="output format (default md)")
    compare.set_defaults(func=cmd_compare)
    kappa = sub.add_parser("kappa", help="inter-rater agreement between two label files",
                           description="Cohen kappa with CI, linear weighted kappa (severity), raw agreement, "
                                       "PABAK and positive/negative agreement per label field.")
    kappa.add_argument("--a", required=True, help="first label file (labels-findings or labels-misses)")
    kappa.add_argument("--b", required=True, help="second label file")
    kappa.add_argument("--rater-a", help="rater id to take from --a (default: final, else the only row)")
    kappa.add_argument("--rater-b", help="rater id to take from --b (default: final, else the only row)")
    kappa.add_argument("--all-items", action="store_true", help="use every shared id, not only irr_sample rows")
    kappa.add_argument("--field", action="append", choices=[f[0] for f in KAPPA_FIELDS],
                       help="restrict to a field (repeatable; default: every field present in both files); "
                            "p2_blocking compares only items both raters rated P2")
    kappa.add_argument("--format", choices=("md", "json"), default="md", help="output format (default md)")
    kappa.set_defaults(func=cmd_kappa)
    panel = sub.add_parser("panel-draw", help="seeded stratified panel draw; writes DIR/panel.json",
                           description="Draw N PRs over repo x verdict strata (automation PRs excluded) with "
                                       "the D8 target head. Refuses to overwrite DIR/panel.json.")
    panel.add_argument("--dir", required=True, help="directory written by collect")
    panel.add_argument("--seed", type=int, required=True, help="random seed (record it in versions.json)")
    panel.add_argument("--n", type=int, default=10, help="PRs to draw (default %(default)s)")
    panel.set_defaults(func=cmd_panel_draw)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
