THREADS_QUERY = """
query($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      reviewThreads(first: 50, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id isResolved isOutdated path line originalLine startLine originalStartLine diffSide
          comments(first: %d) {
            totalCount
            nodes { databaseId author { login } body createdAt }
          }
        }
      }
    }
  }
}
""" % GRAPHQL_COMMENTS_PAGE


class Gh:
    def __init__(self, errors, runner=subprocess.run, sleep=time.sleep):
        self.errors = errors
        self.runner = runner
        self.sleep = sleep

    def _run(self, args, what):
        message, status = "", None
        for attempt in range(GH_RETRIES + 1):
            proc = self.runner(args, capture_output=True, text=True)
            if proc.returncode == 0:
                try:
                    return parse_json_stream(proc.stdout)
                except ValueError as exc:
                    message, status = "invalid JSON: %s" % exc, None
                    break
            message = (proc.stderr or "").strip()
            found = re.search(r"HTTP (\d{3})", message)
            status = int(found.group(1)) if found else None
            lower = message.lower()
            secondary = "secondary rate limit" in lower or status == 429
            if attempt < GH_RETRIES and (secondary or (status is not None and status >= 500)):
                self.sleep(60 * (attempt + 1) if secondary else 2 ** (attempt + 1))
                continue
            break
        self.errors.append({"call": what, "status": status, "message": message[:300]})
        return None

    def rest(self, endpoint, paginate=False):
        args = ["gh", "api", "--method", "GET", "-H", "Accept: application/vnd.github+json", endpoint]
        if paginate:
            args.append("--paginate")
        return self._run(args, endpoint)

    def rest_list(self, endpoint, paginate=True):
        values = self.rest(endpoint, paginate)
        if values is None:
            return None
        out = []
        for value in values:
            out.extend(value if isinstance(value, list) else [value])
        return out

    def rest_obj(self, endpoint, paginate=False):
        values = self.rest(endpoint, paginate)
        if not values:
            return None
        obj = values[0]
        for extra in values[1:]:  # paginated commit objects: merge their files
            if isinstance(obj, dict) and isinstance(extra, dict) and "files" in extra:
                obj.setdefault("files", []).extend(extra["files"])
        return obj

    def review_threads(self, owner, name, number):
        assert THREADS_QUERY.lstrip().startswith("query")
        threads, cursor = [], None
        while True:
            args = [
                "gh", "api", "graphql",
                "-f", "query=" + THREADS_QUERY,
                "-f", "owner=" + owner,
                "-f", "name=" + name,
                "-F", "number=%d" % number,
            ]
            if cursor:
                args += ["-f", "cursor=" + cursor]
            values = self._run(args, "graphql reviewThreads %s/%s#%d" % (owner, name, number))
            if not values:
                return None
            data = values[0]
            if data.get("errors"):
                self.errors.append({"call": "graphql reviewThreads %s/%s#%d" % (owner, name, number),
                                    "status": None, "message": json.dumps(data["errors"])[:300]})
            pr = (((data.get("data") or {}).get("repository") or {}).get("pullRequest")) or {}
            conn = pr.get("reviewThreads") or {}
            threads.extend(conn.get("nodes") or [])
            info = conn.get("pageInfo") or {}
            if not info.get("hasNextPage"):
                return threads
            cursor = info.get("endCursor")


