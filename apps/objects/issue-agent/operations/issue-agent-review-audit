SEVERITY_TOKEN = r"(?:\*\*)?\s*\[?(?P<sev>P[0-3])\]?(?=[:\]\s*]|$)"
BODY_FINDING_RE = re.compile(
    r"^\s*(?:[-*+]|\d+[.)])\s+" + SEVERITY_TOKEN
    + r"(?:[^*`\n]*\*\*)?[:\s]*"
    r"(?:`(?P<path>[^`\s:]+)(?::(?P<line>\d+)(?:[-\u2013](?P<end>\d+))?)?`)?"
)
PATHLIKE_RE = re.compile(r"[\w.-]*/[\w./-]+|[\w-][\w.-]*\.\w+")
INLINE_SEVERITY_RE = re.compile(r"^\s*" + SEVERITY_TOKEN)
HEADING_RE = re.compile(r"^\s{0,3}#{1,6}\s+(.*?)\s*#*\s*$")
PREVIOUS_ITEM_RE = re.compile(r"^\s*[-*]\s*(?:\*\*)?\s*(Closed|Open)\b")
PREVIOUS_HEADINGS = ("previous finding", "prior finding")
BULLET_START_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+")
ANY_SEVERITY_RE = re.compile(r"\b(P[0-3])\b")
MATCH_STOPWORDS = frozenset(
    "with that this from when then than into does have been were which while after before only also "
    "still more should could would there their them they what where must make keep ensure closed open "
    "previous finding findings fixed remains remain unchanged now".split()
)


def review_verdict(body, github_state):
    match = VERDICT_RE.search(body or "")
    if match:
        return VERDICT_EVENT[match.group(1).upper()]
    return github_state


def inline_severity(body):
    match = INLINE_SEVERITY_RE.match(body or "")
    return match.group("sev") if match else None


def _is_previous_heading(heading_text):
    return heading_text.strip().strip("*").strip().lower().startswith(PREVIOUS_HEADINGS)


def first_line(text):
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()
    return ""


def extract_body_findings(body, inline_anchors, window=TWIN_WINDOW):
    """Severity-led bullets in a review body that have no inline twin.

    Only bullets whose first token (after optional bold/brackets) is P0-P3 count; the
    "Previous findings" section is skipped. inline_anchors: iterable of
    (path, start_line|None, line|None). A bullet is a twin when it names the same path and
    the inline range is within [start - window, end + window].
    Returns dicts: severity, path, line, start_line, title, body.
    """
    anchors = [(p, s if s is not None else l, l) for p, s, l in inline_anchors if p and l is not None]
    lines = (body or "").splitlines()
    out = []
    inside_previous = False
    i = 0
    while i < len(lines):
        heading = HEADING_RE.match(lines[i])
        if heading:
            inside_previous = _is_previous_heading(heading.group(1))
            i += 1
            continue
        match = None if inside_previous else BODY_FINDING_RE.match(lines[i])
        if not match:
            i += 1
            continue
        block = [lines[i]]
        j = i + 1
        while j < len(lines):
            nxt = lines[j]
            if not nxt.strip() or BULLET_START_RE.match(nxt) or HEADING_RE.match(nxt):
                break
            if not nxt.startswith((" ", "\t")):
                break
            block.append(nxt)
            j += 1
        path = match.group("path")
        line = start = None
        if path and match.group("line"):
            first = int(match.group("line"))
            last = int(match.group("end")) if match.group("end") else None
            if last is not None and last >= first:
                start, line = first, last
            else:
                line = first
        elif path and not PATHLIKE_RE.fullmatch(path):
            path = None
        twin = False
        if path and line is not None:
            lo = start if start is not None else line
            for a_path, a_lo, a_hi in anchors:
                if a_path == path and interval_distance(lo, line, a_lo, a_hi) <= window:
                    twin = True
                    break
        if not twin:
            out.append(
                {
                    "severity": match.group("sev"),
                    "path": path,
                    "line": line,
                    "start_line": start,
                    "title": BULLET_START_RE.sub("", lines[i], count=1).strip(),
                    "body": "\n".join(block).strip(),
                }
            )
        i = j
    return out


def previous_findings(body):
    """(status, severity|None, text) items of the "Previous findings" section."""
    items = []
    inside = False
    for line in (body or "").splitlines():
        heading = HEADING_RE.match(line)
        if heading:
            inside = _is_previous_heading(heading.group(1))
            continue
        if inside:
            match = PREVIOUS_ITEM_RE.match(line)
            if match:
                sev = ANY_SEVERITY_RE.search(line[match.end():])
                items.append((match.group(1), sev.group(1) if sev else None, line.strip()))
    return items


def _tokens(text):
    words = re.findall(r"[a-z][a-z0-9_]{3,}", (text or "").lower())
    return {w for w in words if w not in MATCH_STOPWORDS}


def match_previous_status(finding, items):
    """Best "Previous findings" item for a finding: (status, text) or (None, None).

    An item qualifies when its severity equals the finding's severity AND either the path
    basename appears in it or at least 2 non-stopword title tokens (length >= 4) do. The
    highest-scoring item wins; ties keep the earliest. Informational only.
    """
    severity = finding.get("severity")
    path = finding.get("path")
    base = path.rsplit("/", 1)[-1].lower() if path else None
    title_tokens = _tokens(finding.get("title"))
    best = (0, None, None)
    for status, item_sev, text in items:
        if item_sev != severity:
            continue
        shared = len(title_tokens & _tokens(text))
        has_base = bool(base) and base in text.lower()
        if not has_base and shared < 2:
            continue
        score = shared + (1 if has_base else 0)
        if score > best[0]:
            best = (score, status, text)
    return best[1], best[2]


REPLY_REJECT_RE = re.compile(
    r"won'?t fix|wontfix|not a bug|not an issue|by design|\bintended\b|intentional|false positive|"
    r"disagree|not applicable|\binvalid\b|out of scope|no change needed|not needed|\bdeclin|"
    r"의도|불필요|해당 없",
    re.I,
)
REPLY_ACK_RE = re.compile(
    r"\bfix(?:ed|es)?\b|\baddressed\b|\bdone\b|\bapplied\b|good catch|will fix|\bupdated\b|"
    r"\bresolved\b|\bchanged\b|\bthanks?\b|thank you|반영|수정",
    re.I,
)
REPLY_QUESTION_RE = re.compile(r"\?|\b(why|could you|can you|what do you mean|clarify)\b", re.I)


def classify_reply(text):
    if REPLY_REJECT_RE.search(text or ""):
        return "reject"
    if REPLY_ACK_RE.search(text or ""):
        return "ack"
    if REPLY_QUESTION_RE.search(text or ""):
        return "question"
    return None


def author_reply_kind(replies, authors):
    for reply in reversed(replies):
        if reply.get("author") in authors:
            kind = classify_reply(reply.get("body"))
            if kind:
                return kind
    return "none"


KEYWORD_FLAGS = {
    "fix": re.compile(r"\bfix", re.I),
    "bug": re.compile(r"\bbug", re.I),
    "revert": re.compile(r"\brevert", re.I),
    "regress": re.compile(r"\bregress", re.I),
    "hotfix": re.compile(r"\bhot-?fix", re.I),
}


def keyword_flags(message, pr_number):
    flags = {name: bool(rx.search(message or "")) for name, rx in KEYWORD_FLAGS.items()}
    flags["pr_ref"] = bool(re.search(r"#%d(?!\d)" % pr_number, message or ""))
    return flags


