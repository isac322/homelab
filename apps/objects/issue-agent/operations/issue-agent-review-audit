def parse_time(value):
    if value is None:
        return None
    text = value.strip()
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
        text += "T00:00:00+00:00"
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    parsed = dt.datetime.fromisoformat(text)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def fmt_time(value):
    return value.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def login_of(obj):
    user = (obj or {}).get("user") or (obj or {}).get("author") or {}
    return user.get("login")


def is_bot_login(login, user_type=None):
    return bool(login) and (login.endswith("[bot]") or user_type == "Bot")


def author_type(login, user_type=None):
    if login == OWNER:
        return "owner"
    if login == IMPLEMENTER_BOT:
        return "implementer_bot"
    if is_bot_login(login, user_type):
        return "automation"
    return "external"


def file_type(path):
    """code | test | build_config | docs from the path alone (labels may override)."""
    if not path:
        return None
    lower = path.lower()
    base = lower.rsplit("/", 1)[-1]
    if TEST_PATH_RE.search(lower) or TEST_FILE_RE.match(base):
        return "test"
    if (base in BUILD_BASENAMES or base.startswith(("dockerfile", "containerfile")) or lower.startswith(".github/")
            or base.endswith(BUILD_EXTENSIONS)):
        return "build_config"
    if base.endswith(DOC_EXTENSIONS) or lower.startswith("docs/") or "/docs/" in lower or base in ("license", "notice"):
        return "docs"
    return "code"


def pr_id_of(item_id):
    match = PR_ID_RE.match(item_id or "")
    return match.group(1) if match else None


def hunk_range(hunk):
    return "-%d,%d+%d,%d" % (hunk.old_start, hunk.old_count, hunk.new_start, hunk.new_count)


def hunk_candidate_id(pr_id, step_sha, path, hunk):
    """Content-addressed id: commit (or compare) + path + hunk header range."""
    if step_sha.startswith("compare:"):
        base, head = step_sha[len("compare:"):].split("...", 1)
        step = "cmp-%s-%s" % (base[:12], head[:12])
    else:
        step = step_sha[:12]
    return "%s/hunk/%s/%s@%s" % (pr_id, step, path, hunk_range(hunk) if hunk else "nopatch")


def comment_candidate_id(pr_id, source, source_id):
    return "%s/comment/%s/%s" % (pr_id, source, source_id)


def postmerge_candidate_id(pr_id, sha):
    return "%s/postmerge/%s" % (pr_id, sha[:12])


def xref_candidate_id(pr_id, source_repo, source_number):
    return "%s/xref/%s#%s" % (pr_id, source_repo or "unknown", source_number)


def size_bucket(additions, deletions, changed_files):
    lines = (additions or 0) + (deletions or 0)
    if lines >= 400 or (changed_files or 0) >= 20:
        return "L"
    if lines < 50:
        return "S"
    return "M"


def write_private(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)


def write_jsonl(path, rows):
    write_private(path, "".join(json.dumps(r, sort_keys=True, ensure_ascii=False) + "\n" for r in rows))


def parse_json_stream(text):
    """Parse one or more concatenated JSON documents (gh --paginate emits one per page)."""
    decoder = json.JSONDecoder()
    values, pos, size = [], 0, len(text)
    while True:
        while pos < size and text[pos].isspace():
            pos += 1
        if pos >= size:
            return values
        value, pos = decoder.raw_decode(text, pos)
        values.append(value)


# ---------------------------------------------------------------------------
# Unified diff parsing and anchor mapping (pure)
# ---------------------------------------------------------------------------
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


@dataclass
class Hunk:
    old_start: int
    old_count: int
    new_start: int
    new_count: int
    header: str
    text: str = ""
    deleted: list = field(default_factory=list)  # old line numbers removed
    inserted_after: list = field(default_factory=list)  # x: insertion between old x and x+1
    added_new: list = field(default_factory=list)  # new line numbers added
    context: dict = field(default_factory=dict)  # old line -> new line

    def old_span(self):
        """Old-side interval the hunk touches; an insertion-only hunk spans x..x+1."""
        if self.old_count == 0:
            return self.old_start, self.old_start + 1
        return self.old_start, self.old_start + self.old_count - 1


def parse_patch(patch):
    """Parse unified-diff text (one file; extra non-hunk lines are ignored) into Hunks."""
    hunks = []
    cur = None
    old_no = new_no = old_left = new_left = 0
    body = []
    for raw in (patch or "").split("\n"):
        match = HUNK_RE.match(raw)
        if match:
            if cur is not None:
                cur.text = "\n".join(body)
            os_, oc, ns, nc = match.groups()
            oc = 1 if oc is None else int(oc)
            nc = 1 if nc is None else int(nc)
            cur = Hunk(int(os_), oc, int(ns), nc, raw)
            hunks.append(cur)
            body = [raw]
            old_no = cur.old_start if oc else cur.old_start + 1
            new_no = cur.new_start if nc else cur.new_start + 1
            old_left, new_left = oc, nc
            continue
        if cur is None:
            continue
        if raw.startswith("\\"):
            body.append(raw)
            continue
        if old_left <= 0 and new_left <= 0:
            continue
        body.append(raw)
        tag = raw[:1]
        if tag == "+":
            if not cur.inserted_after or cur.inserted_after[-1] != old_no - 1:
                cur.inserted_after.append(old_no - 1)
            cur.added_new.append(new_no)
            new_no += 1
            new_left -= 1
        elif tag == "-":
            cur.deleted.append(old_no)
            old_no += 1
            old_left -= 1
        else:  # context (" " or an empty line whose space was stripped)
            cur.context[old_no] = new_no
            old_no += 1
            new_no += 1
            old_left -= 1
            new_left -= 1
    if cur is not None:
        cur.text = "\n".join(body)
    return hunks


def map_line(line, hunks):
    """Map an old-side line through one file diff. None when the line is deleted/modified."""
    delta = 0
    for hunk in sorted(hunks, key=lambda h: h.old_start):
        lo, hi = hunk.old_span()
        if hunk.old_count == 0:
            if line <= hunk.old_start:
                break
            delta += hunk.new_count
            continue
        if line < lo:
            break
        if line <= hi:
            if line in hunk.context:
                return hunk.context[line]
            return None
        delta += hunk.new_count - hunk.old_count
    return line + delta


def map_interval(start, end, hunks):
    """Map [start, end]; survivors define the new interval; None when all lines are gone."""
    if end - start > RANGE_MAP_LIMIT:
        points = (start, end)
    else:
        points = range(start, end + 1)
    mapped = [m for m in (map_line(p, hunks) for p in points) if m is not None]
    if not mapped:
        return None
    return min(mapped), max(mapped)


def interval_distance(a_lo, a_hi, b_lo, b_hi):
    if a_hi < b_lo:
        return b_lo - a_hi
    if b_hi < a_lo:
        return a_lo - b_hi
    return 0


def change_distance(start, end, hunks):
    """Smallest distance from [start, end] to a changed old-side line; None if no change."""
    best = None
    for hunk in hunks:
        for x in hunk.deleted:
            d = interval_distance(start, end, x, x)
            best = d if best is None else min(best, d)
        for x in hunk.inserted_after:
            d = interval_distance(start, end, x, x + 1)
            best = d if best is None else min(best, d)
    return best


def _find_file(files, path):
    if path in files:
        return files[path]
    for entry in files.values():
        if entry.get("previous_filename") == path:
            return entry
    return None


def track_anchor(path, start, end, commits, ks=VICINITY_KS):
    """Carry a finding anchor through later commits.

    commits: ordered list of {"sha", "is_merge", "files": {filename: file-entry} | None}.
    A file entry has filename, status, optional previous_filename and patch.
    Returns changed {k: bool|None}, file_changed_later (bool|None), positions
    {sha: (path, start, end) in that commit's old-side coordinates}, note.
    """
    if start is None:  # single-line anchors (GitHub start_line null) use start = end = line
        start = end
    elif end is None:
        end = start
    has_line = start is not None
    changed = {k: (False if has_line else None) for k in ks}
    file_changed = False
    positions = {}
    note = None
    cur_path = path
    for commit in commits:
        files = commit.get("files")
        if files is None:
            note = "diff unavailable for %s" % commit.get("sha")
            break
        if cur_path is None:
            break
        if has_line and start is not None:
            positions[commit["sha"]] = (cur_path, start, end)
        entry = _find_file(files, cur_path)
        if entry is None:
            continue
        merge = commit.get("is_merge", False)
        if not merge:
            file_changed = True
        status = entry.get("status")
        patch = entry.get("patch")
        if status == "removed":
            if has_line and start is not None and not merge:
                for k in ks:
                    changed[k] = True
            start = end = None
            cur_path = None
            break
        if patch is None:
            if status == "renamed" and not entry.get("changes"):
                cur_path = entry.get("filename", cur_path)
                continue
            note = "patch missing for %s in %s" % (cur_path, commit.get("sha"))
            break
        hunks = parse_patch(patch)
        if has_line and start is not None:
            if not merge:
                dist = change_distance(start, end, hunks)
                if dist is not None:
                    for k in ks:
                        if dist <= k:
                            changed[k] = True
            mapped = map_interval(start, end, hunks)
            if mapped is None:
                start = end = None
                note = note or "anchor deleted at %s" % commit.get("sha")
            else:
                start, end = mapped
        cur_path = entry.get("filename", cur_path)
    if note and note.startswith(("diff unavailable", "patch missing")):
        changed = {k: (True if v is True else None) for k, v in changed.items()}
        file_changed = True if file_changed else None
    return {"changed": changed, "file_changed_later": file_changed, "positions": positions, "note": note}


