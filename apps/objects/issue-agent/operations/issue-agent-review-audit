# aggregation (pure)
# ---------------------------------------------------------------------------


def summarize(k, n, proportion):
    out = {"k": k, "n": n, "rate": (k / n) if n else None}
    if proportion:
        out["ci95"] = list(wilson(k, n))
    return out


def aggregate(items, proportion=True, count_only=False, dims=STRATA):
    """items: list of (dims_dict, numerator, denominator)."""
    def build(subset):
        k = sum(i[1] for i in subset)
        if count_only:
            return {"count": k}
        return summarize(k, sum(i[2] for i in subset), proportion)

    result = {"overall": build(items), "breakdown": {}}
    for dim in dims:
        groups = defaultdict(list)
        for item in items:
            groups[str(item[0].get(dim))].append(item)
        result["breakdown"][dim] = {value: build(group) for value, group in sorted(groups.items())}
    return result


def not_useful_summary(k, n):
    out = summarize(k, n, True)
    if n and out["ci95"][0] > NOT_USEFUL_ALARM:
        out["status"] = "suppress"
    elif n < NOT_USEFUL_MIN_N:
        out["status"] = "insufficient"
    elif out["rate"] >= NOT_USEFUL_ALARM:
        out["status"] = "probation"
    else:
        out["status"] = "ok"
    return out


def pool_families(cells):
    """cells: {(coarse, sev): [k, n]} -> {"coarse.sev" | "coarse.*" | "*.*": summary},
    pooling cells with n < NOT_USEFUL_MIN_N first by coarse type, then into *.*."""
    out, by_coarse, rest = {}, defaultdict(lambda: [0, 0]), [0, 0]
    for (coarse, sev), (k, n) in sorted(cells.items()):
        if n >= NOT_USEFUL_MIN_N:
            out["%s.%s" % (coarse, sev)] = not_useful_summary(k, n)
        else:
            by_coarse[coarse][0] += k
            by_coarse[coarse][1] += n
    for coarse, (k, n) in sorted(by_coarse.items()):
        if n >= NOT_USEFUL_MIN_N:
            out["%s.*" % coarse] = not_useful_summary(k, n)
        else:
            rest[0] += k
            rest[1] += n
    if rest[1]:
        out["*.*"] = not_useful_summary(*rest)
    return out


KAPPA_FIELDS = (
    # (output name, label field, categories, weights, positive category, label file)
    ("validity", "validity", VOCAB["validity"], None, "valid", "findings"),
    ("severity", "adjudicated_severity", KAPPA_SEVERITY_SCALE, "linear", None, "findings"),
    ("bot_match", "bot_match", VOCAB["bot_match"], None, "hit", "misses"),
    ("is_defect", "is_defect", (True, False), None, True, "misses"),
    ("verdict", "verdict", VOCAB["verdict"], None, IMPORTANT_MISS_VERDICT, "misses"),
    # Only items both raters adjudicated P2; an unset p2_blocking counts as false.
    ("p2_blocking", BLOCKING_FIELD, (True, False), None, True, "findings"),
)


def agreement(rows_a, rows_b, kinds=("findings", "misses"), irr_only=True):
    """Per-field agreement between two {id: row} maps (KAPPA_FIELDS). With irr_only, only
    items whose row in either map sets irr_sample: true are used."""
    ids = sorted(set(rows_a) & set(rows_b))
    if irr_only:
        ids = [i for i in ids if rows_a[i].get("irr_sample") is True or rows_b[i].get("irr_sample") is True]
    out = {}
    for name, fld, categories, weights, positive, kind in KAPPA_FIELDS:
        if kind not in kinds:
            continue
        if fld == BLOCKING_FIELD:
            pairs = [(rows_a[i].get(fld) is True, rows_b[i].get(fld) is True) for i in ids
                     if rows_a[i].get("adjudicated_severity") == "P2" and rows_b[i].get("adjudicated_severity") == "P2"]
        else:
            pairs = [(rows_a[i].get(fld), rows_b[i].get(fld)) for i in ids
                     if rows_a[i].get(fld) is not None and rows_b[i].get(fld) is not None]
        stats = kappa_stats(pairs, categories, weights, positive)
        if weights == "linear":
            stats["kappa_quadratic"] = kappa_stats(pairs, categories, "quadratic")["kappa"]
        out[name] = stats
    return out


def exclude_units(units, exclude_prs):
    """Drop every unit of the given PR ids (`metrics --exclude-pr`)."""
    if not exclude_prs:
        return units
    excluded = set(exclude_prs)
    out = dict(units)
    for name in ("prs", "reviews", "findings", "candidates", "coverage"):
        rows = units.get(name) or {}
        out[name] = {k: v for k, v in rows.items() if (v.get("pr_id") or v.get("id")) not in excluded
                     and pr_id_of(k) not in excluded}
    if units.get("panel"):
        out["panel"] = dict(units["panel"], prs=[p for p in units["panel"].get("prs", [])
                                                 if p["pr_id"] not in excluded])
    return out


def compute_metrics(units, finding_label_rows, miss_label_rows, evidence_days=None, judge_rows=(),
                    matcher_rows=(), exclude_prs=()):
    """Pure aggregation over unit dicts and raw label rows. Returns a JSON-able dict whose
    `figures` keys follow METRIC_KEYS. judge_rows / matcher_rows come from labels-judge.jsonl
    and labels-matcher.jsonl and feed only judge_bias and match_kappa."""
    bad = []
    excluded = set(exclude_prs)
    keep = lambda row: pr_id_of(row.get("id")) not in excluded
    excluded_label_rows = sum(1 for rows in (finding_label_rows, miss_label_rows, judge_rows, matcher_rows)
                              for row in rows if not keep(row))
    finding_label_rows, miss_label_rows = [r for r in finding_label_rows if keep(r)], [r for r in miss_label_rows
                                                                                         if keep(r)]
    judge_rows = [dict(r, rater=r.get("rater") or JUDGE_RATER) for r in judge_rows if keep(r)]
    matcher_rows = [dict(r, rater=r.get("rater") or ("matcher-%s" % r.get("order"))) for r in matcher_rows if keep(r)]
    for row in [r for r in matcher_rows if r["rater"] not in MATCHER_RATERS]:
        bad.append({"file": "labels-matcher", "line": row.get("_line"), "id": row.get("id"),
                    "reason": "rater must be one of %s (or set order)" % ", ".join(MATCHER_RATERS)})
    matcher_rows = [r for r in matcher_rows if r["rater"] in MATCHER_RATERS]
    units = exclude_units(units, excluded)
    prs, reviews, findings, candidates = units["prs"], units["reviews"], units["findings"], units["candidates"]
    coverage_rows = units.get("coverage") or {}
    panel = units.get("panel")
    panel_prs = {p["pr_id"] for p in panel.get("prs", [])} if panel else None
    panel_targets = {p["pr_id"]: p.get("target_head_sha") for p in panel.get("prs", [])} if panel else {}

    bot_reviews = [r for r in reviews.values() if r.get("is_bot") and not r.get("is_reply_container")]
    heads = defaultdict(dict)  # pr -> head -> first review time
    for r in sorted(bot_reviews, key=lambda r: r.get("submitted_at") or ""):
        heads[r["pr_id"]].setdefault(r.get("reviewed_head_sha"), r.get("submitted_at") or "")
    units = dict(units, _heads=heads)
    lf_final, lf_by_rater = split_raters(finding_label_rows, validate_finding_label, units, bad, "labels-findings")
    lm_final, lm_by_rater = split_raters(miss_label_rows, validate_miss_label, units, bad, "labels-misses")
    out_of_horizon_rows = sum(1 for r in lm_final.values() if r.get("out_of_horizon") is True)
    coverage_only_rows = [r for i, r in sorted(lm_final.items())
                          if r.get("coverage_only") is True and r.get("out_of_horizon") is not True]
    in_figures = lambda r: r.get("out_of_horizon") is not True and r.get("coverage_only") is not True
    lm_final = {i: r for i, r in lm_final.items() if in_figures(r)}
    lm_by_rater = {rater: {i: r for i, r in rows.items() if in_figures(r)} for rater, rows in lm_by_rater.items()}
    _, judge_by_rater = split_raters(judge_rows, validate_finding_label, units, bad, "labels-judge")
    _, matcher_by_rater = split_raters(matcher_rows, validate_miss_label, units, bad, "labels-matcher")

    verdict_of = lambda r: r.get("verdict") or review_verdict(r.get("body"), r.get("event"))

    def pr_dims(pr_id):
        pr = prs.get(pr_id, {})
        return {"repo": pr.get("repo"), "size_bucket": pr.get("size_bucket"),
                "author_type": pr.get("author_type") or author_type(pr.get("author"))}

    # (pr, head) units: verdict of the latest review on the head; in window if any review is.
    head_units = {}
    for r in sorted(bot_reviews, key=lambda r: (r.get("submitted_at") or "", r["id"])):
        key = (r["pr_id"], r.get("reviewed_head_sha"))
        unit = head_units.setdefault(key, {"pr_id": r["pr_id"], "head": key[1], "finding_ids": [],
                                           "in_window": False, "verdict": None})
        unit["finding_ids"] += r.get("finding_ids") or []
        if r.get("in_window", True):
            unit["in_window"] = True
            unit["verdict"] = verdict_of(r)
        elif unit["verdict"] is None:
            unit["verdict"] = verdict_of(r)
    unit_dims = lambda key: {**pr_dims(key[0]), "verdict": head_units[key]["verdict"] if key in head_units else None}

    def review_dims(review):
        return {**pr_dims(review["pr_id"]), "verdict": verdict_of(review)}

    def finding_dims(finding, label=None):
        review = reviews.get(finding["review_id"]) or {"pr_id": finding["pr_id"], "event": finding.get("review_event"),
                                                     "verdict": finding.get("review_verdict")}
        return {**review_dims(review), "file_type": (label or {}).get("file_type") or finding.get("file_type"),
                "defect_type": (label or {}).get("defect_type"), "bot_severity": finding.get("severity") or "untagged"}

    window_reviews = [r for r in bot_reviews if r.get("in_window", True)]
    reviewed_prs = sorted({r["pr_id"] for r in window_reviews})
    last_unit = {}
    for r in sorted(window_reviews, key=lambda r: r.get("submitted_at") or ""):
        last_unit[r["pr_id"]] = (r["pr_id"], r.get("reviewed_head_sha"))
    window_findings = {fid: f for fid, f in findings.items() if f.get("in_window", True)}
    order = lambda fid: (findings[fid].get("submitted_at") or reviews.get(findings[fid]["review_id"], {})
                         .get("submitted_at") or "", fid)

    # D3 first occurrence: DUPLICATE code, or an earlier final label with the same (pr, dedup_key).
    duplicates, first_seen = set(), {}
    for fid in sorted(lf_final, key=order):
        row = lf_final[fid]
        if DUPLICATE_CODE in (row.get("noise_codes") or []):
            duplicates.add(fid)
            continue
        if row.get("dedup_key"):
            group = (findings[fid]["pr_id"], row["dedup_key"])
            if group in first_seen:
                duplicates.add(fid)
            else:
                first_seen[group] = fid

    figures = {}
    labelled = [(window_findings[fid], row) for fid, row in sorted(lf_final.items()) if fid in window_findings]
    first_occ = [(f, r) for f, r in labelled if f["id"] not in duplicates]
    decided = [(f, r) for f, r in first_occ if r["validity"] != "unverifiable"]
    valid = [(f, r) for f, r in decided if r["validity"] == "valid"]
    fdims = lambda f, r: finding_dims(f, r)

    figures["validity_precision"] = aggregate([(fdims(f, r), int(r["validity"] == "valid"), 1) for f, r in decided],
                                              dims=FINDING_STRATA)
    figures["validity_precision"]["unverifiable"] = len(first_occ) - len(decided)
    figures["validity_precision_worst"] = aggregate(
        [(fdims(f, r), int(r["validity"] == "valid"), 1) for f, r in first_occ], dims=FINDING_STRATA)
    figures["noise_rate"] = aggregate([(fdims(f, r), int(is_noise(f.get("severity"), r)), 1) for f, r in decided],
                                      dims=FINDING_STRATA)
    figures["code_rate"] = {
        code: aggregate([(fdims(f, r), int(code in finding_codes(f.get("severity"), r)), 1) for f, r in decided],
                        dims=FINDING_STRATA)
        for code in DERIVED_CODES + tuple(c for c in VOCAB["noise_codes"] if c != DUPLICATE_CODE)
    }
    figures["duplicate_rate"] = aggregate([(fdims(f, r), int(f["id"] in duplicates), 1) for f, r in labelled],
                                          dims=FINDING_STRATA)
    with_gap = [(f, r, severity_gap(f.get("severity"), r.get("adjudicated_severity"))) for f, r in valid]
    with_gap = [(f, r, g) for f, r, g in with_gap if g is not None]
    figures["over_severity_rate"] = aggregate(
        [(fdims(f, r), int(g == OVER_SEVERITY_LEVELS), 1) for f, r, g in with_gap], dims=FINDING_STRATA)
    figures["severity_inflated_rate"] = aggregate(
        [(fdims(f, r), int(severity_inflated(f.get("severity"), r)), 1) for f, r, g in with_gap], dims=FINDING_STRATA)
    figures["blocking_precision"] = aggregate(
        [(fdims(f, r), int(r["validity"] == "valid"), 1) for f, r in decided if f.get("severity") in P0P1],
        dims=FINDING_STRATA)

    # Addressed (D12): F_closed = first occurrences on merged/closed PRs with a non-null vicinity
    # (or an auditor author_action); implementer_bot PRs reported separately.
    closed = lambda pr_id: prs.get(pr_id, {}).get("state") == "closed"
    addressed_items, implementer_items, null_vicinity = [], [], 0
    not_useful_cells, axis_type, axis_sev = defaultdict(lambda: [0, 0]), defaultdict(lambda: [0, 0]), \
        defaultdict(lambda: [0, 0])
    for fid, f in sorted(window_findings.items()):
        if fid in duplicates or not closed(f["pr_id"]):
            continue
        label = lf_final.get(fid)
        action = (label or {}).get("author_action")
        addressed, rejected = finding_addressed(f, label), finding_rejected(f, label)
        if rejected or addressed:
            coarse = ((label or {}).get("defect_type") or "unknown").split("/")[0]
            sev = f.get("severity") or "untagged"
            for cell in (not_useful_cells[(coarse, sev)], axis_type[coarse], axis_sev[sev]):
                cell[0] += int(rejected)
                cell[1] += 1
        if f.get("changed_in_vicinity_1") is None and action not in ("addressed", "rejected", "ignored"):
            null_vicinity += 1
            continue
        item = (fdims(f, label), int(addressed), 1)
        (implementer_items if pr_dims(f["pr_id"])["author_type"] == "implementer_bot" else addressed_items).append(item)
    figures["addressed_rate"] = aggregate(addressed_items, dims=FINDING_STRATA)
    figures["addressed_rate"]["implementer_bot"] = aggregate(implementer_items, dims=())["overall"]
    figures["addressed_rate"]["null_vicinity_excluded"] = null_vicinity
    figures["effective_fp_rate"] = aggregate([(d, n - k, n) for d, k, n in addressed_items], dims=FINDING_STRATA)
    figures["effective_fp_rate"]["note"] = "record only; compare with human_addressed_rate"
    figures["explicit_not_useful_rate"] = pool_families(not_useful_cells)
    figures["explicit_not_useful_rate"]["by_axis"] = {
        "defect_type": {k: not_useful_summary(*v) for k, v in sorted(axis_type.items())},
        "bot_severity": {k: not_useful_summary(*v) for k, v in sorted(axis_sev.items())},
    }

    human_items, human_impl, human_null = [], [], 0
    for cand in sorted(candidates.values(), key=lambda c: c["id"]):
        if (cand.get("kind") != "human_comment" or not cand.get("is_root_inline")
                or cand.get("commenter_kind") != "human" or cand["pr_id"] not in reviewed_prs or not closed(cand["pr_id"])):
            continue
        if cand.get("changed_in_vicinity_1") is None:
            human_null += 1
            continue
        item = ({**pr_dims(cand["pr_id"]), "file_type": cand.get("file_type")},
                int(cand["changed_in_vicinity_1"] is True or cand.get("author_reply_kind") == "ack"), 1)
        (human_impl if item[0]["author_type"] == "implementer_bot" else human_items).append(item)
    human_dims = ("repo", "size_bucket", "author_type", "file_type")
    figures["human_addressed_rate"] = aggregate(human_items, dims=human_dims)
    figures["human_addressed_rate"]["implementer_bot"] = aggregate(human_impl, dims=())["overall"]
    figures["human_addressed_rate"]["null_vicinity_excluded"] = human_null

    # Misses (D3/D6/D7): defect unit (pr, dedup_key); generated bot_finding hit rows.
    groups = defaultdict(list)
    for rid, row in lm_final.items():
        groups[(miss_pr_id(rid, units), row.get("dedup_key") or miss_base_id(rid))].append(row)
    for fid, label in lf_final.items():
        if (label["validity"] == "valid" and label.get("dedup_key")
                and is_important(label.get("adjudicated_severity"), label.get(BLOCKING_FIELD))):
            f = findings[fid]
            groups[(f["pr_id"], label["dedup_key"])].append({
                "id": fid, "channel": GENERATED_CHANNEL, "verdict": IMPORTANT_MISS_VERDICT, "is_defect": True,
                "present_at_reviewed_head": IMPORTANT_MISS_PRESENT,
                "adjudicated_severity": label["adjudicated_severity"], BLOCKING_FIELD: label.get(BLOCKING_FIELD),
                "bot_match": "hit", "matched_finding_id": fid, "reviewed_head_sha": f.get("reviewed_head_sha"),
                "latest_present_head": None, "defect_type": label.get("defect_type"),
                "file_type": label.get("file_type") or f.get("file_type")})
    defects, out_of_window = [], 0
    for (pr_id, key), rows in sorted(groups.items(), key=lambda kv: (str(kv[0][0]), str(kv[0][1]))):
        eligible = [r for r in rows if r.get("is_defect") is True and r.get("verdict") == IMPORTANT_MISS_VERDICT
                    and r.get("present_at_reviewed_head") == IMPORTANT_MISS_PRESENT
                    and is_important(r.get("adjudicated_severity"), r.get(BLOCKING_FIELD)) and r.get("bot_match")]
        if not eligible:
            continue
        order_of = heads.get(pr_id, {})
        status_at = {}
        for r in eligible:
            head = r.get("reviewed_head_sha")
            if head not in status_at or BOT_MATCH_ORDER[r["bot_match"]] < BOT_MATCH_ORDER[status_at[head]]:
                status_at[head] = r["bot_match"]
        best = min(status_at.values(), key=BOT_MATCH_ORDER.get)
        first_head = min(status_at, key=lambda h: (order_of.get(h, ""), str(h)))
        latest = [r.get("latest_present_head") for r in eligible if r.get("latest_present_head")]
        anchor = max(latest or list(status_at), key=lambda h: (order_of.get(h, ""), str(h)))
        unit = head_units.get((pr_id, anchor))
        if unit is not None and not unit["in_window"]:  # straddling PRs: count each defect in one window
            out_of_window += 1
            continue
        labelled_rows = [r for r in eligible if r.get("channel") != GENERATED_CHANNEL] or eligible
        severity = min((r["adjudicated_severity"] for r in eligible), key=SEVERITY_RANK.get)
        hit_gap = [SEVERITY_RANK[severity] - SEVERITY_RANK[findings[r["matched_finding_id"]]["severity"]]
                   for r in eligible if r["bot_match"] == "hit" and r.get("matched_finding_id") in findings
                   and findings[r["matched_finding_id"]].get("severity") in SEVERITY_RANK]
        channels = set()
        for r in eligible:
            channels.add(r.get("channel"))
            channels.update(r.get("sources") or [])
        target = panel_targets.get(pr_id)
        commit_order = (coverage_rows.get(pr_id) or {}).get("heads") or []
        position = lambda sha: commit_order.index(sha) if sha in commit_order else None

        def blind_before_target(row):
            cand = candidate_of(row["id"], units) or {}
            if not (cand.get("commenter_kind") == "human" and cand.get("blind_to_bot") is True):
                return False
            at, limit = position(cand.get("head_at_comment")), position(target)
            return at is None or limit is None or at <= limit

        human_blind = any(r.get("channel") == "human_comment" and blind_before_target(r) for r in eligible)
        defects.append({
            "pr_id": pr_id, "key": key, "best": best, "escaped": best != "hit", "status_at": status_at,
            "first_exposure": status_at[first_head], "severity": severity,
            "severity_miss": any(g <= -INFLATION_MIN_LEVELS for g in hit_gap),
            "repo_rule": any(r.get("repo_rule") is True for r in eligible),
            "non_panel": any(r.get("channel") != "panel" for r in eligible),
            "channels": channels, "human_blind": human_blind,
            "dims": {**unit_dims((pr_id, anchor)), "file_type": labelled_rows[0].get("file_type"),
                     "defect_type": labelled_rows[0].get("defect_type")},
        })
    reference = [d for d in defects if d["non_panel"]]
    escape_note = {"evidence_days": evidence_days}
    figures["important_escaped"] = aggregate([(d["dims"], int(d["escaped"]), 1) for d in reference], count_only=True)
    figures["important_escaped"].update(escape_note)
    figures["important_escaped"]["excluded_out_of_window"] = out_of_window
    figures["important_escaped"]["severity_miss"] = sum(1 for d in reference if d["best"] == "hit" and d["severity_miss"])
    figures["important_escaped"]["repo_rule"] = {
        "escaped": sum(1 for d in reference if d["escaped"] and d["repo_rule"]),
        "final_rows": sum(1 for r in lm_final.values() if r.get("repo_rule") is True),
    }
    # Panel-only defects (found by no other channel) count only for panel-sampled PRs.
    panel_only = [d for d in defects if not d["non_panel"]]
    in_panel = [d for d in panel_only if panel_prs is not None and d["pr_id"] in panel_prs]
    figures["important_escaped"]["panel_only"] = {
        "escaped": sum(1 for d in in_panel if d["escaped"]),
        "defects": len(in_panel),
        "panel_prs": len(panel_prs) if panel_prs is not None else 0,
        "outside_panel_prs": len(panel_only) - len(in_panel),
        "note": "panel-sampled PRs only; excluded from all-PR figures",
    }
    escaped_by_pr = Counter(d["pr_id"] for d in reference if d["escaped"])
    figures["important_escaped_per_pr"] = aggregate(
        [(unit_dims(last_unit[p]), escaped_by_pr.get(p, 0), 1) for p in reviewed_prs], proportion=False,
        dims=REVIEW_STRATA)
    per_pr_overall = figures["important_escaped_per_pr"]["overall"]
    lo, hi = garwood(per_pr_overall["k"])
    per_pr_overall["ci95"] = [lo / per_pr_overall["n"], hi / per_pr_overall["n"]] if per_pr_overall["n"] else [None, None]
    per_pr_overall["ci_method"] = "Garwood exact Poisson on the count / n PRs"
    figures["important_escaped_per_pr"].update(escape_note)
    panel_defects = [d for d in defects if panel_prs is not None and d["pr_id"] in panel_prs]
    figures["important_miss_rate_rel"] = {
        "all_prs": aggregate([(d["dims"], int(d["escaped"]), 1) for d in reference]),
        "panel_prs": aggregate([(d["dims"], int(d["escaped"]), 1) for d in panel_defects]) if panel_prs else None,
        **escape_note,
    }
    figures["important_partial"] = aggregate([(d["dims"], int(d["best"] == "partial"), 1) for d in reference],
                                             count_only=True)
    figures["important_partial"].update(escape_note)
    figures["subtotal_p0p1"] = aggregate(
        [(d["dims"], int(d["escaped"]), 1) for d in reference if d["severity"] in P0P1])
    figures["subtotal_p0p1"].update(escape_note)
    figures["first_exposure_miss"] = aggregate([(d["dims"], int(d["first_exposure"] != "hit"), 1) for d in reference])
    figures["first_exposure_miss"].update(escape_note)

    # Verdict metrics over distinct (pr, head) units (D3).
    statuses = defaultdict(list)
    for d in reference:
        for head, status in d["status_at"].items():
            statuses[(d["pr_id"], head)].append(status)
    window_units = [key for key, unit in sorted(head_units.items(), key=lambda kv: (kv[0][0], str(kv[0][1])))
                    if unit["in_window"]]
    approve_units = [key for key in window_units if head_units[key]["verdict"] == APPROVE_VERDICT]
    is_final = lambda key: prs.get(key[0], {}).get("merged") and prs[key[0]].get("final_head_sha") == key[1]
    approve_item = lambda key, wanted: (unit_dims(key), int(any(s in wanted for s in statuses.get(key, []))), 1)
    fig = aggregate([approve_item(k, ("miss", "partial")) for k in approve_units], dims=REVIEW_STRATA)
    fig["merged_final"] = aggregate([approve_item(k, ("miss", "partial")) for k in approve_units if is_final(k)],
                                    dims=REVIEW_STRATA)
    fig["superseded"] = aggregate([approve_item(k, ("miss", "partial")) for k in approve_units if not is_final(k)],
                                  dims=REVIEW_STRATA)
    fig["miss_only"] = aggregate([approve_item(k, ("miss",)) for k in approve_units], dims=())["overall"]
    approve_by_pr = {}
    for key in approve_units:  # PR-level: any APPROVE unit with an important miss or partial
        dims, hit, _ = approve_item(key, ("miss", "partial"))
        prev = approve_by_pr.get(key[0])
        approve_by_pr[key[0]] = (dims, max(hit, prev[1] if prev else 0), 1)
    fig["per_pr"] = aggregate([approve_by_pr[p] for p in sorted(approve_by_pr)], dims=REVIEW_STRATA)
    fig.update(escape_note)
    figures["approve_with_important_miss"] = fig

    rc_items, rc_unlabelled, rc_no_findings, prove_or_fix = [], 0, [], []
    for key in window_units:
        if head_units[key]["verdict"] != BLOCKING_VERDICT:
            continue
        ids = sorted(set(head_units[key]["finding_ids"]))
        if not ids:  # blocks on carried-over prior findings or untagged prose: adjudicate by hand
            rc_no_findings.append("%s@%s" % key)
            continue
        if any(i not in lf_final for i in ids):
            rc_unlabelled += 1
            continue
        valid_blocking = any(lf_final[i]["validity"] == "valid"
                             and is_important(lf_final[i].get("adjudicated_severity"), lf_final[i].get(BLOCKING_FIELD))
                             for i in ids)
        stated = [i for i in ids if findings[i].get("severity") in P0P1]
        if (not valid_blocking and pr_dims(key[0])["author_type"] == "implementer_bot" and stated
                and all(lf_final[i]["validity"] == "unverifiable" for i in stated)):
            prove_or_fix.append("%s@%s" % key)
        rc_items.append((unit_dims(key), int(not valid_blocking), 1))
    fig = aggregate(rc_items, dims=REVIEW_STRATA)
    fig["excluded_not_fully_labelled"] = rc_unlabelled
    fig["excluded_no_own_findings"] = rc_no_findings
    fig["prove_or_fix"] = prove_or_fix
    figures["rc_without_valid_blocking"] = fig

    per_pr = Counter(f["pr_id"] for fid, f in window_findings.items() if fid not in duplicates)
    valid_blocking_pr = Counter(f["pr_id"] for f, r in valid
                                if is_important(r.get("adjudicated_severity"), r.get(BLOCKING_FIELD)))
    addressed_pr = Counter(f["pr_id"] for fid, f in window_findings.items()
                           if fid not in duplicates and finding_addressed(f, lf_final.get(fid)))
    pr_item = lambda counts: [(unit_dims(last_unit[p]), counts.get(p, 0), 1) for p in reviewed_prs]
    fig = aggregate(pr_item(per_pr), proportion=False, dims=REVIEW_STRATA)
    fig["valid_blocking"] = aggregate(pr_item(valid_blocking_pr), proportion=False, dims=())["overall"]
    fig["addressed"] = aggregate(pr_item(addressed_pr), proportion=False, dims=())["overall"]
    figures["findings_per_pr"] = fig
    fig = aggregate([(review_dims(r), int(not r.get("finding_ids")), 1) for r in window_reviews], dims=REVIEW_STRATA)
    fig["verdict_distribution"] = dict(sorted(Counter(str(verdict_of(r)) for r in window_reviews).items()))
    figures["silent_review_share"] = fig

    escaped_units = {(d["pr_id"], h) for d in reference if d["escaped"] for h in d["status_at"]}
    fig = aggregate([(fdims(f, r), int(r.get("adjudicated_severity") == "nit"), 1) for f, r in valid],
                    dims=FINDING_STRATA)
    per_review = {"with_escaped": [0, 0], "without_escaped": [0, 0]}
    for review in window_reviews:
        bucket = per_review["with_escaped" if (review["pr_id"], review.get("reviewed_head_sha")) in escaped_units
                            else "without_escaped"]
        bucket[0] += sum(1 for i in review.get("finding_ids") or []
                         if i in lf_final and lf_final[i].get("adjudicated_severity") == "nit")
        bucket[1] += 1
    fig["per_review"] = {k: summarize(v[0], v[1], False) for k, v in per_review.items()}
    figures["nit_share"] = fig

    cov_items = [({"repo": c.get("repo"), "author_type": c.get("author_type"),
                   "size_bucket": prs.get(c["id"], {}).get("size_bucket")}, int(bool(c.get("has_gap"))), 1)
                 for c in coverage_rows.values()]
    fig = aggregate(cov_items, dims=("repo", "size_bucket", "author_type"))
    fig["unreviewed_prefix_heads"] = sum(len(c.get("unreviewed_prefix_heads") or []) for c in coverage_rows.values())
    fig["unreviewed_merged_heads"] = sum(1 for c in coverage_rows.values() if c.get("merged_head_reviewed") is False)
    fig["attention_only_prs"] = sum(1 for c in coverage_rows.values() if c.get("attention_only"))
    figures["coverage_unreviewed_heads"] = fig

    # coverage_only defects (fixed before the first bot review): never in R_imp or a miss figure.
    coverage_groups = {}
    for row in coverage_only_rows:
        if row.get("is_defect") is True:
            coverage_groups.setdefault((miss_pr_id(row["id"], units), row.get("dedup_key") or miss_base_id(row["id"])),
                                       row)
    fig = aggregate([({**pr_dims(pr_id), "adjudicated_severity": row.get("adjudicated_severity")}, 1, 1)
                     for (pr_id, _), row in sorted(coverage_groups.items(), key=lambda kv: str(kv[0]))],
                    count_only=True, dims=("repo", "author_type", "adjudicated_severity"))
    fig["important"] = sum(1 for row in coverage_groups.values()
                           if row.get("verdict") == IMPORTANT_MISS_VERDICT
                           and is_important(row.get("adjudicated_severity"), row.get(BLOCKING_FIELD)))
    figures["coverage_unreviewed_defects"] = fig

    figures["capture_recapture"] = capture_recapture(panel_defects if panel_prs else None, panel_targets)

    irr_a, irr_b = (lf_by_rater.get(IRR_RATERS[0], {}), lf_by_rater.get(IRR_RATERS[1], {}))
    irr = agreement(irr_a, irr_b, kinds=("findings",))
    irr.update(agreement(lm_by_rater.get(IRR_RATERS[0], {}), lm_by_rater.get(IRR_RATERS[1], {}), kinds=("misses",)))
    figures["irr"] = irr
    sampled = {i: r for i, r in lm_final.items() if r.get("match_sample") is True}
    figures["match_kappa"] = {}
    for order, rater in zip(MATCH_ORDERS, MATCHER_RATERS):
        match = agreement(matcher_by_rater.get(rater, {}), sampled, kinds=("misses",), irr_only=False)["bot_match"]
        kappa = match["kappa"]
        match["status"] = ("not estimable" if kappa is None else "definite" if kappa >= MATCH_KAPPA_DEFINITE
                           else "tentative" if kappa >= MATCH_KAPPA_TENTATIVE else "untrusted")
        figures["match_kappa"][order] = match
    judge = judge_by_rater.get(JUDGE_RATER, {})
    bias = agreement(judge, lf_by_rater.get(IRR_RATERS[1], {}), kinds=("findings",))["validity"]
    joined = [i for i in sorted(judge) if i in findings]
    bias["length_correlation"] = pearson([len(findings[i].get("body") or "") for i in joined],
                                         [int(judge[i].get("validity") == "valid") for i in joined])
    bias["length_n"] = len(joined)
    figures["judge_bias"] = bias

    counts = {
        "findings_in_window": len(window_findings),
        "findings_labelled_final": len(labelled),
        "findings_first_occurrence": len(first_occ),
        "findings_label_rows_out_of_window": len(lf_final) - len(labelled),
        "miss_rows_final": len(lm_final),
        "important_defects_all_prs": len(reference),
        "important_defects_panel_prs": len(panel_defects),
        "bot_reviews_in_window": len(window_reviews),
        "reviewed_heads_in_window": len(window_units),
        "reviewed_prs": len(reviewed_prs),
        "excluded_prs": sorted(excluded),
        "excluded_label_rows": excluded_label_rows,
        "miss_rows_out_of_horizon": out_of_horizon_rows,
        "miss_rows_coverage_only": len(coverage_only_rows),
    }
    return {"figures": figures, "coverage": counts, "bad_rows": bad, "evidence_days": evidence_days}


def capture_recapture(defects, targets=None):
    """D9: Chapman (2 sources) or Chao2 (>= 3) over important defects of panel PRs that are
    present at the panel target head. Sources: bot (hit on the target head's row), panel, and
    humans blind to the bot review. Indicative only; not estimable when m < 7."""
    if defects is None:
        return {"status": "no panel", "estimate": None}
    targets = targets or {}
    defects = [d for d in defects if targets.get(d["pr_id"]) in d["status_at"]]
    seen = {
        "bot": {i for i, d in enumerate(defects) if d["status_at"][targets[d["pr_id"]]] == "hit"},
        "panel": {i for i, d in enumerate(defects) if "panel" in d["channels"]},
        "human_blind": {i for i, d in enumerate(defects) if d["human_blind"]},
    }
    active = {k: v for k, v in seen.items() if v}
    out = {"sources": {k: len(v) for k, v in seen.items()}, "s_obs": len(set().union(*seen.values())),
           "defects_at_target": len(defects), "estimate": None, "note": "indicative only"}
    if len(active) < 2:
        out.update(method=None, m=0, status="not estimable")
        return out
    hits = Counter(i for v in active.values() for i in v)
    m = sum(1 for c in hits.values() if c >= 2)
    if len(active) == 2:
        (n1, n2) = (len(v) for v in active.values())
        out.update(method="chapman", m=m)
        estimate = chapman(n1, n2, m)
    else:
        q1 = sum(1 for c in hits.values() if c == 1)
        q2 = sum(1 for c in hits.values() if c == 2)
        out.update(method="chao2", m=m, q1=q1, q2=q2)
        estimate = chao2(len(hits), q1, q2, len(active))
    if m < CAPTURE_MIN_RECAPTURES:
        out["status"] = "not estimable"
    else:
        out.update(status="ok", estimate=estimate)
    return out


