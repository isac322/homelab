# statistics (pure)
# ---------------------------------------------------------------------------


def wilson(k, n, z=WILSON_Z):
    if n <= 0:
        return (None, None)
    p = k / n
    z2 = z * z
    denom = 1 + z2 / n
    center = (p + z2 / (2 * n)) / denom
    half = z * math.sqrt(p * (1 - p) / n + z2 / (4 * n * n)) / denom
    return (max(0.0, center - half), min(1.0, center + half))


def newcombe_diff(k_base, n_base, k_after, n_after, z=WILSON_Z):
    """Newcombe (1998) hybrid score interval (method 10) for p_after - p_base."""
    if n_base <= 0 or n_after <= 0:
        return None
    p0, p1 = k_base / n_base, k_after / n_after
    l0, u0 = wilson(k_base, n_base, z)
    l1, u1 = wilson(k_after, n_after, z)
    diff = p1 - p0
    lower = diff - math.sqrt((p1 - l1) ** 2 + (u0 - p0) ** 2)
    upper = diff + math.sqrt((u1 - p1) ** 2 + (p0 - l0) ** 2)
    return {"diff": diff, "ci95": [lower, upper], "changed": lower > 0 or upper < 0}


def _log_comb(n, k):
    return math.lgamma(n + 1) - math.lgamma(k + 1) - math.lgamma(n - k + 1)


def fisher_exact(a, b, c, d):
    """Two-sided Fisher exact p for [[a, b], [c, d]]: sum of tables with P <= P(observed)."""
    row1, row2, col1 = a + b, c + d, a + c
    total = row1 + row2
    if total == 0:
        return 1.0
    lo, hi = max(0, col1 - row2), min(row1, col1)
    logp = lambda x: _log_comb(row1, x) + _log_comb(row2, col1 - x) - _log_comb(total, col1)
    observed = logp(a)
    p = sum(math.exp(logp(x)) for x in range(lo, hi + 1) if logp(x) <= observed + 1e-7)
    return min(1.0, p)


def conditional_binomial(k_base, t_base, k_after, t_after):
    """Exact two-sided test of equal Poisson rates (counts k over exposures t, e.g. PRs):
    given k_base + k_after, k_after ~ Binomial(total, t_after / (t_base + t_after))."""
    if t_base <= 0 or t_after <= 0:
        return None
    total = k_base + k_after
    rate_base, rate_after = k_base / t_base, k_after / t_after
    out = {"rate_base": rate_base, "rate_after": rate_after,
           "rate_ratio": (rate_after / rate_base) if rate_base > 0 else None}
    if total == 0:
        out["p_value"] = 1.0
        return out
    p = t_after / (t_base + t_after)
    logpmf = lambda x: _log_comb(total, x) + x * math.log(p) + (total - x) * math.log(1 - p)
    observed = logpmf(k_after)
    out["p_value"] = min(1.0, sum(math.exp(logpmf(x)) for x in range(total + 1) if logpmf(x) <= observed + 1e-7))
    return out


def _poisson_cdf(k, mu):
    """P(X <= k) for X ~ Poisson(mu)."""
    if k < 0:
        return 0.0
    if mu <= 0:
        return 1.0
    return min(1.0, sum(math.exp(i * math.log(mu) - mu - math.lgamma(i + 1)) for i in range(k + 1)))


def garwood(k, alpha=0.05):
    """Exact (Garwood 1936) two-sided CI for a Poisson mean given count k:
    lower solves P(X >= k; mu) = alpha/2 (0 when k = 0), upper solves P(X <= k; mu) = alpha/2."""
    def solve(predicate, lo, hi):
        for _ in range(200):  # bisection; predicate is monotone in mu
            mid = (lo + hi) / 2
            lo, hi = (mid, hi) if predicate(mid) else (lo, mid)
        return (lo + hi) / 2

    top = max(10.0, 3.0 * k + 30.0)
    lower = 0.0 if k == 0 else solve(lambda mu: 1 - _poisson_cdf(k - 1, mu) < alpha / 2, 0.0, top)
    upper = solve(lambda mu: _poisson_cdf(k, mu) > alpha / 2, 0.0, top)
    return lower, upper


def kappa_stats(pairs, categories, weights=None, positive=None, z=WILSON_Z):
    """Cohen's kappa (weights None) or weighted kappa (weights "linear" | "quadratic").

    CI: kappa +- z * sqrt(po (1 - po)) / ((1 - pe) sqrt(n)) (Cohen 1960 large-sample form,
    with weighted po/pe for weighted kappa). Also raw agreement, PABAK = (k po_raw - 1)/(k - 1)
    over the k vocabulary categories, specific agreement per category 2 n_cc / (row_c + col_c),
    and pos/neg agreement for `positive` against everything else.
    """
    pairs = [(a, b) for a, b in pairs if a in categories and b in categories]
    n = len(pairs)
    size = len(categories)
    out = {"n": n, "weights": weights, "kappa": None, "ci95": [None, None], "raw": None, "pabak": None,
           "pos": None, "neg": None, "specific": {}}
    if n == 0 or size < 2:
        return out
    index = {c: i for i, c in enumerate(categories)}

    def weight(i, j):
        if weights == "linear":
            return 1 - abs(i - j) / (size - 1)
        if weights == "quadratic":
            return 1 - ((i - j) / (size - 1)) ** 2
        return 1.0 if i == j else 0.0

    rows = Counter(index[a] for a, _ in pairs)
    cols = Counter(index[b] for _, b in pairs)
    po = sum(weight(index[a], index[b]) for a, b in pairs) / n
    pe = sum(weight(i, j) * rows[i] * cols[j] for i in rows for j in cols) / (n * n)
    raw = sum(1 for a, b in pairs if a == b) / n
    out["raw"] = raw
    out["pabak"] = (size * raw - 1) / (size - 1)
    if pe < 1:
        kappa = (po - pe) / (1 - pe)
        se = math.sqrt(max(po * (1 - po), 0.0)) / ((1 - pe) * math.sqrt(n))
        out["kappa"] = kappa
        out["ci95"] = [max(-1.0, kappa - z * se), min(1.0, kappa + z * se)]
    for c in categories:
        both = sum(1 for a, b in pairs if a == c and b == c)
        margin = rows[index[c]] + cols[index[c]]
        if margin:
            out["specific"][str(c)] = 2 * both / margin
    if positive is not None:
        pp = sum(1 for a, b in pairs if a == positive and b == positive)
        nn = sum(1 for a, b in pairs if a != positive and b != positive)
        disagree = n - pp - nn
        out["pos"] = (2 * pp / (2 * pp + disagree)) if (2 * pp + disagree) else None
        out["neg"] = (2 * nn / (2 * nn + disagree)) if (2 * nn + disagree) else None
    return out


def chapman(n1, n2, m):
    """Chapman's bias-corrected two-source Lincoln-Petersen estimate."""
    return (n1 + 1) * (n2 + 1) / (m + 1) - 1


def chao2(s_obs, q1, q2, k):
    """Bias-corrected Chao2 for k incidence samples (sources)."""
    return s_obs + ((k - 1) / k) * q1 * (q1 - 1) / (2 * (q2 + 1))


def pearson(xs, ys):
    n = len(xs)
    if n < 2:
        return None
    mx, my = sum(xs) / n, sum(ys) / n
    sxy = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
    sxx = sum((x - mx) ** 2 for x in xs)
    syy = sum((y - my) ** 2 for y in ys)
    return None if sxx == 0 or syy == 0 else sxy / math.sqrt(sxx * syy)


