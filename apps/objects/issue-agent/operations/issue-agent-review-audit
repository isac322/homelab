class Collector:
    def __init__(self, gh, out, since, until, reviewer, evidence_days, now=None):
        self.gh = gh
        self.out = out
        self.since = since
        self.until = until
        self.reviewer = reviewer
        self.evidence_days = evidence_days
        self.horizon = dt.timedelta(days=evidence_days)
        self.now = now or dt.datetime.now(dt.timezone.utc)
        self.truncation = Counter()
        self.evidence_dropped = Counter()
        self.evidence_incomplete = []
        self.head_counts = Counter()
        self.notes = []
        self.skipped = []
        self.commit_cache = {}
        self.default_branch = {}
        self.prs, self.reviews, self.findings, self.candidates, self.coverage = [], [], [], [], []

    # -- raw storage ---------------------------------------------------------
    def raw(self, rel_dir, name, data):
        path = os.path.join(self.out, rel_dir)
        os.makedirs(path, mode=0o700, exist_ok=True)
        target = os.path.join(path, name)
        if not os.path.exists(target):
            write_private(target, json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False) + "\n")

    def commit(self, repo, sha):
        key = (repo, sha)
        if key not in self.commit_cache:
            self.commit_cache[key] = self.gh.rest_obj("repos/%s/commits/%s?per_page=100" % (repo, sha), paginate=True)
        return self.commit_cache[key]

    def in_window(self, when):
        stamp = parse_time(when)
        return stamp is not None and self.since <= stamp < self.until

    def keep_candidate(self, out, cand):
        """D1 evidence horizon: keep a candidate only if event_at <= anchor_at + H."""
        anchor, event = parse_time(cand.get("anchor_at")), parse_time(cand.get("event_at"))
        cand["evidence_deadline"] = fmt_time(anchor + self.horizon) if anchor else None
        if anchor is not None and event is not None and event > anchor + self.horizon:
            self.evidence_dropped[cand["kind"]] += 1
            return
        out.append(cand)

    # -- discovery -------------------------------------------------------------
    def discover(self, repo):
        """PRs updated since `since`: (kept, attention_only).

        kept: PRs with at least one in-window review by the reviewer.
        attention_only: PRs without one but with an in-window bot attention comment
        (failure/stop notice); they only feed coverage.jsonl.
        """
        kept, attention_only = [], []
        page = 1
        while True:
            items = self.gh.rest_list(
                "repos/%s/pulls?state=all&sort=updated&direction=desc&per_page=100&page=%d" % (repo, page),
                paginate=False,
            )
            if not items:
                break
            stop = False
            for item in items:
                if parse_time(item.get("updated_at")) < self.since:
                    stop = True
                    break
                number = item["number"]
                reviews = self.gh.rest_list("repos/%s/pulls/%d/reviews?per_page=100" % (repo, number))
                if reviews is None:
                    self.skipped.append({"pr": "%s#%d" % (repo, number), "reason": "reviews unavailable"})
                    continue
                if any(login_of(r) == self.reviewer and self.in_window(r.get("submitted_at")) for r in reviews):
                    kept.append((number, reviews))
                    continue
                comments = self.gh.rest_list("repos/%s/issues/%d/comments?per_page=100" % (repo, number)) or []
                attention = [c for c in comments if login_of(c) == self.reviewer
                             and ATTENTION_RE.search(c.get("body") or "") and self.in_window(c.get("created_at"))]
                if attention:
                    attention_only.append((item, reviews, attention))
            if stop or len(items) < 100:
                break
            page += 1
        return kept, attention_only

    def run(self, repos):
        for repo in repos:
            kept, attention_only = self.discover(repo)
            for number, reviews in kept:
                self.collect_pr(repo, number, reviews)
            for item, reviews, attention in attention_only:
                self.coverage.append(self._attention_only_row(repo, item, reviews, attention))

    def _attention_only_row(self, repo, item, reviews, attention):
        login = login_of(item)
        return {
            "id": "%s#%d" % (repo, item["number"]),
            "repo": repo,
            "number": item["number"],
            "author": login,
            "author_type": author_type(login, (item.get("user") or {}).get("type")),
            "attention_only": True,
            "attention_comments": len(attention),
            "bot_reviews": sum(1 for r in reviews if login_of(r) == self.reviewer and r.get("state") != "PENDING"),
            "heads": None,
            "bot_reviewed_heads": [],
            "reviewed_heads_outside_commits": 0,
            "foreign_fix_commits": [],
            "unreviewed_prefix_heads": [],
            "first_foreign_commit_after_review": None,
            "merged": bool(item.get("merged_at")),
            "final_head_sha": (item.get("head") or {}).get("sha"),
            "merged_head_reviewed": None,
            "has_gap": True,
        }

    # -- per PR ----------------------------------------------------------------
    def collect_pr(self, repo, number, reviews):
        gh = self.gh
        owner, name = repo.split("/", 1)
        pr_id = "%s#%d" % (repo, number)
        raw_dir = "raw/%s__%s/%d" % (owner, name, number)
        pr = gh.rest_obj("repos/%s/pulls/%d" % (repo, number))
        if pr is None:
            self.skipped.append({"pr": pr_id, "reason": "pull request unavailable"})
            return
        files = gh.rest_list("repos/%s/pulls/%d/files?per_page=100" % (repo, number)) or []
        commits = gh.rest_list("repos/%s/pulls/%d/commits?per_page=100" % (repo, number)) or []
        review_comments = gh.rest_list("repos/%s/pulls/%d/comments?per_page=100" % (repo, number)) or []
        issue_comments = gh.rest_list("repos/%s/issues/%d/comments?per_page=100" % (repo, number)) or []
        timeline = gh.rest_list("repos/%s/issues/%d/timeline?per_page=100" % (repo, number)) or []
        threads = gh.review_threads(owner, name, number)
        for fname, data in (
            ("pr.json", pr), ("files.json", files), ("commits.json", commits), ("reviews.json", reviews),
            ("review_comments.json", review_comments), ("issue_comments.json", issue_comments),
            ("threads.json", threads), ("timeline.json", timeline),
        ):
            self.raw(raw_dir, fname, data)
        if len(commits) >= PR_COMMITS_LIMIT:
            self.truncation["pr_commits_at_250_limit"] += 1
        if len(files) >= PR_FILES_LIMIT:
            self.truncation["pr_files_at_3000_limit"] += 1
        if threads is not None:
            for thread in threads:
                total = ((thread.get("comments") or {}).get("totalCount")) or 0
                if total > GRAPHQL_COMMENTS_PAGE:
                    self.truncation["thread_comments_over_page"] += 1

        final_head = (pr.get("head") or {}).get("sha")
        author = login_of(pr)
        pr_author_type = author_type(author, (pr.get("user") or {}).get("type"))
        merged = bool(pr.get("merged_at"))
        sha_index = {c["sha"]: i for i, c in enumerate(commits)}
        commit_dates = [((c.get("commit") or {}).get("committer") or {}).get("date") for c in commits]
        roots_by_review = defaultdict(list)
        rest_replies = defaultdict(list)
        for comment in review_comments:
            if comment.get("in_reply_to_id"):
                rest_replies[comment["in_reply_to_id"]].append(comment)
            elif login_of(comment) == self.reviewer:
                roots_by_review[comment.get("pull_request_review_id")].append(comment)
        # Empty-body bot reviews without root comments only carry thread replies.
        containers = {r["id"] for r in reviews if login_of(r) == self.reviewer
                      and not (r.get("body") or "").strip() and not roots_by_review.get(r["id"])}
        bot_reviews = sorted(
            (r for r in reviews if login_of(r) == self.reviewer and r.get("state") != "PENDING"
             and r["id"] not in containers),
            key=lambda r: (r.get("submitted_at") or "", r["id"]),
        )
        review_uid = lambda r: "%s@review/%d" % (pr_id, r["id"])
        human_roots = [c for c in review_comments
                       if not c.get("in_reply_to_id") and login_of(c) and login_of(c) != author
                       and not is_bot_login(login_of(c), (c.get("user") or {}).get("type"))]

        # Diffs of every commit after the earliest bot-reviewed or human-commented head.
        head_positions = [sha_index[r.get("commit_id")] for r in bot_reviews if r.get("commit_id") in sha_index]
        first_idx = min(head_positions) if head_positions else None
        starts = head_positions + [sha_index[c.get("original_commit_id")] for c in human_roots
                                   if c.get("original_commit_id") in sha_index]
        cdiffs = {}
        if starts:
            for commit in commits[min(starts) + 1:]:
                detail = self.commit(repo, commit["sha"])
                if detail is not None:
                    self.raw(raw_dir, "commit-%s.json" % commit["sha"], detail)
                cdiffs[commit["sha"]] = self._commit_diff(commit, detail)

        def later_commits(head_sha):
            idx = sha_index[head_sha]
            return [cdiffs.get(c["sha"], {"sha": c["sha"], "files": None}) for c in commits[idx + 1:]]

        compare_cache = {}

        def compare_steps(head_sha):
            """A reviewed head outside the PR commit list (rebase/force push): one synthetic
            non-merge step from compare/{head}...{final_head}. None when the commit is gone."""
            if head_sha not in compare_cache:
                result = None
                if head_sha and final_head and head_sha != final_head and self.commit(repo, head_sha) is not None:
                    cmp = gh.rest_obj("repos/%s/compare/%s...%s" % (repo, head_sha, final_head))
                    if cmp is not None:
                        self.raw(raw_dir, "compare-%s.json" % head_sha, cmp)
                        cmp_files = cmp.get("files") or []
                        if len(cmp_files) >= COMPARE_FILES_LIMIT:
                            self.truncation["compare_files_at_300_limit"] += 1
                        cmp_commits = cmp.get("commits") or []
                        event_at = (((cmp_commits[-1].get("commit") or {}).get("committer") or {}).get("date")
                                    if cmp_commits else None)
                        result = {"event_at": event_at,
                                  "step": {"sha": "compare:%s...%s" % (head_sha, final_head), "is_merge": False,
                                           "files": {f["filename"]: f for f in cmp_files}}}
                compare_cache[head_sha] = result
            return compare_cache[head_sha]

        for review in bot_reviews:
            head = review.get("commit_id")
            if head and head not in sha_index:
                key = "reviews_on_force_pushed_heads" if compare_steps(head) else "reviews_on_vanished_heads"
                self.head_counts[key] += 1

        # Threads keyed by first comment id.
        thread_by_root = {}
        for thread in threads or []:
            nodes = ((thread.get("comments") or {}).get("nodes")) or []
            if nodes and nodes[0].get("databaseId") is not None:
                thread_by_root[nodes[0]["databaseId"]] = thread

        reply_authors = {author, OWNER}
        finding_rows, tracks = [], {}
        review_findings = defaultdict(list)
        root_to_finding = {}
        for pos, review in enumerate(bot_reviews):
            ruid = review_uid(review)
            head = review.get("commit_id")
            next_review = bot_reviews[pos + 1] if pos + 1 < len(bot_reviews) else None
            prev_items = previous_findings(next_review.get("body")) if next_review else []
            roots = sorted(roots_by_review.get(review["id"], []), key=lambda c: c["id"])
            raw_findings = []
            for comment in roots:
                thread = thread_by_root.get(comment["id"])
                if thread is not None:
                    nodes = (thread.get("comments") or {}).get("nodes") or []
                    replies = [{"author": (n.get("author") or {}).get("login"), "body": n.get("body"),
                                "created_at": n.get("createdAt")} for n in nodes[1:]]
                else:
                    replies = [{"author": login_of(c), "body": c.get("body"), "created_at": c.get("created_at")}
                               for c in sorted(rest_replies.get(comment["id"], []), key=lambda c: c["id"])]
                raw_findings.append({
                    "source": "inline",
                    "severity": inline_severity(comment.get("body")),
                    "path": comment.get("path"),
                    "line": comment.get("original_line") or comment.get("line"),
                    "start_line": comment.get("original_start_line") or comment.get("start_line"),
                    "side": comment.get("side") or "RIGHT",
                    "title": first_line(comment.get("body")),
                    "body": comment.get("body"),
                    "comment_id": comment["id"],
                    "thread_id": thread.get("id") if thread else None,
                    "thread_resolved": thread.get("isResolved") if thread else None,
                    "thread_outdated": thread.get("isOutdated") if thread else None,
                    "replies": replies,
                })
            anchors = [(f["path"], f["start_line"], f["line"]) for f in raw_findings]
            for item in extract_body_findings(review.get("body"), anchors):
                item.update({"source": "body", "side": "RIGHT", "comment_id": None, "thread_id": None,
                             "thread_resolved": None, "thread_outdated": None, "replies": []})
                raw_findings.append(item)
            for k, item in enumerate(raw_findings, start=1):
                fid = "%s/f%d" % (ruid, k)
                signals = {"changed_in_vicinity_1": None, "changed_in_vicinity_5": None,
                           "file_changed_later": None, "vicinity_method": None, "signal_note": None}
                steps = method = None
                if not item["path"]:
                    signals["signal_note"] = "no path"
                elif head in sha_index:
                    steps, method = later_commits(head), "commit-walk"
                else:
                    self.truncation["findings_head_not_in_commits"] += 1
                    cmp = compare_steps(head)
                    if cmp is None:
                        signals["signal_note"] = "reviewed head not in PR commit list and not retrievable"
                    else:
                        steps, method = [cmp["step"]], "compare-fallback"
                if steps is not None:
                    use_line = item["line"] if item["side"] != "LEFT" else None
                    track = track_anchor(item["path"], (item["start_line"] or use_line) if use_line else None,
                                         use_line, steps)
                    tracks[fid] = {"method": method, "hidx": sha_index.get(head), "head": head, "track": track}
                    signals["changed_in_vicinity_1"] = track["changed"][1]
                    signals["changed_in_vicinity_5"] = track["changed"][5]
                    signals["file_changed_later"] = track["file_changed_later"]
                    signals["vicinity_method"] = method
                    signals["signal_note"] = track["note"] or ("LEFT-side comment" if item["side"] == "LEFT" else None)
                status, status_line = match_previous_status(item, prev_items) if next_review else (None, None)
                finding_rows.append({
                    "id": fid,
                    "pr_id": pr_id,
                    "review_id": ruid,
                    "review_event": review.get("state"),
                    "review_verdict": review_verdict(review.get("body"), review.get("state")),
                    "reviewed_head_sha": head,
                    "submitted_at": review.get("submitted_at"),
                    "in_window": self.in_window(review.get("submitted_at")),
                    "file_type": file_type(item["path"]),
                    **item,
                    **signals,
                    "next_bot_review_id": review_uid(next_review) if next_review else None,
                    "next_bot_review_status": status or "absent",
                    "next_bot_review_line": status_line,
                    "author_reply_kind": author_reply_kind(item["replies"], reply_authors),
                })
                review_findings[review["id"]].append(fid)
                if item["comment_id"] is not None:
                    root_to_finding[item["comment_id"]] = fid

        # Addressed signals for human root inline comments (human_addressed_rate).
        human_signals = {}
        for comment in human_roots:
            head = comment.get("original_commit_id")
            line = comment.get("original_line") or comment.get("line")
            start = comment.get("original_start_line") or comment.get("start_line")
            sig = {"is_root_inline": True, "changed_in_vicinity_1": None, "file_changed_later": None,
                   "vicinity_method": None}
            if head in sha_index and comment.get("path"):
                use_line = line if (comment.get("side") or "RIGHT") != "LEFT" else None
                track = track_anchor(comment["path"], (start or use_line) if use_line else None, use_line,
                                     later_commits(head))
                sig.update({"changed_in_vicinity_1": track["changed"][1],
                            "file_changed_later": track["file_changed_later"], "vicinity_method": "commit-walk"})
            replies = [{"author": login_of(c), "body": c.get("body"), "created_at": c.get("created_at")}
                       for c in sorted(rest_replies.get(comment["id"], []), key=lambda c: c["id"])]
            sig["author_reply_kind"] = author_reply_kind(replies, {author})
            human_signals[comment["id"]] = sig

        # Reviews (bot and human).
        review_rows = []
        for review in sorted(reviews, key=lambda r: (r.get("submitted_at") or "", r["id"])):
            if review.get("state") == "PENDING":
                continue
            head = review.get("commit_id")
            idx = sha_index.get(head)
            superseded = commits[idx + 1]["sha"] if idx is not None and idx + 1 < len(commits) else None
            reviewer = login_of(review)
            review_rows.append({
                "id": review_uid(review),
                "pr_id": pr_id,
                "review_id": review["id"],
                "reviewer": reviewer,
                "event": review.get("state"),
                "github_state": review.get("state"),
                "verdict": review_verdict(review.get("body"), review.get("state")),
                "is_reply_container": review["id"] in containers,
                "reviewed_head_sha": head,
                "submitted_at": review.get("submitted_at"),
                "body": review.get("body"),
                "is_bot": is_bot_login(reviewer, ((review.get("user") or {}).get("type"))),
                "in_window": self.in_window(review.get("submitted_at")),
                "finding_ids": review_findings.get(review["id"], []),
                "superseded_by_head": superseded,
                "head_is_final": head == final_head,
            })

        # Candidates (content-addressed ids, D1 evidence horizon).
        candidates = []
        candidates += self._post_review_hunks(pr_id, commits, sha_index, bot_reviews, cdiffs, finding_rows, tracks,
                                              first_idx, review_uid, compare_steps)
        candidates += self._human_comments(pr_id, reviews, review_comments, issue_comments, bot_reviews,
                                           root_to_finding, review_uid, human_signals, commits, commit_dates)
        if merged:
            candidates += self._post_merge(repo, pr_id, number, pr, files, commits, raw_dir)
        candidates += self._cross_refs(pr_id, timeline, bot_reviews, review_uid)
        seen = Counter()
        for cand in candidates:
            cand["pr_id"] = pr_id
            seen[cand["id"]] += 1
            if seen[cand["id"]] > 1:  # same content key twice: keep both, mark the repeat
                self.notes.append("duplicate candidate id %s" % cand["id"])
                cand["id"] = "%s~%d" % (cand["id"], seen[cand["id"]])

        # Coverage (D16).
        reviewed = {r.get("commit_id") for r in bot_reviews}
        foreign = []
        for i, commit in enumerate(commits):
            login = (commit.get("author") or {}).get("login")
            if i == 0 or not login or login in (author, self.reviewer) or len(commit.get("parents") or []) > 1:
                continue
            foreign.append(i)
        prefix_heads = []
        for i in foreign:
            prev = commits[i - 1]["sha"]
            if prev not in reviewed and prev not in prefix_heads:
                prefix_heads.append(prev)
        attention = [c for c in issue_comments
                     if login_of(c) == self.reviewer and ATTENTION_RE.search(c.get("body") or "")]
        merged_head_reviewed = (final_head in reviewed) if merged else None
        self.coverage.append({
            "id": pr_id,
            "repo": repo,
            "number": number,
            "author": author,
            "author_type": pr_author_type,
            "attention_only": False,
            "attention_comments": len(attention),
            "bot_reviews": len(bot_reviews),
            "heads": [c["sha"] for c in commits],
            "bot_reviewed_heads": [commits[i]["sha"] for i in sorted({sha_index[h] for h in reviewed if h in sha_index})],
            "reviewed_heads_outside_commits": sum(1 for h in reviewed if h and h not in sha_index),
            "foreign_fix_commits": [commits[i]["sha"] for i in foreign],
            "unreviewed_prefix_heads": prefix_heads,
            "first_foreign_commit_after_review": next(
                (commits[i]["sha"] for i in foreign if first_idx is not None and i > first_idx), None),
            "merged": merged,
            "final_head_sha": final_head,
            "merged_head_reviewed": merged_head_reviewed,
            "has_gap": bool(prefix_heads) or (merged and not merged_head_reviewed),
        })

        anchors = [parse_time(r.get("submitted_at")) for r in bot_reviews if self.in_window(r.get("submitted_at"))]
        if merged:
            anchors.append(parse_time(pr["merged_at"]))
        if any(a is not None and a + self.horizon > self.now for a in anchors):
            self.evidence_incomplete.append(pr_id)

        human_reviewers = sorted({login_of(r) for r in reviews
                                  if login_of(r) and not is_bot_login(login_of(r), (r.get("user") or {}).get("type"))})
        self.prs.append({
            "id": pr_id,
            "repo": repo,
            "number": number,
            "title": pr.get("title"),
            "author": author,
            "author_association": pr.get("author_association"),
            "author_type": pr_author_type,
            "state": pr.get("state"),
            "merged": merged,
            "merged_at": pr.get("merged_at"),
            "base_ref": (pr.get("base") or {}).get("ref"),
            "base_sha_at_merge": (pr.get("base") or {}).get("sha"),
            "final_head_sha": final_head,
            "merge_commit_sha": pr.get("merge_commit_sha"),
            "created_at": pr.get("created_at"),
            "changed_files": pr.get("changed_files"),
            "additions": pr.get("additions"),
            "deletions": pr.get("deletions"),
            "size_bucket": size_bucket(pr.get("additions"), pr.get("deletions"), pr.get("changed_files")),
            "bot_review_ids": [review_uid(r) for r in bot_reviews],
            "human_reviewers": human_reviewers,
            "raw_dir": raw_dir,
        })
        self.reviews += review_rows
        self.findings += finding_rows
        self.candidates += candidates

    def _commit_diff(self, commit, detail):
        parents = (detail or commit).get("parents") or []
        if detail is None:
            return {"sha": commit["sha"], "is_merge": len(parents) > 1, "files": None}
        file_map = {}
        for entry in detail.get("files") or []:
            if entry.get("patch") is None and entry.get("changes"):
                self.truncation["commit_file_patch_missing"] += 1
            file_map[entry["filename"]] = entry
        if len(detail.get("files") or []) >= PR_FILES_LIMIT:
            self.truncation["commit_files_at_3000_limit"] += 1
        info = detail.get("commit") or {}
        return {
            "sha": commit["sha"],
            "is_merge": len(parents) > 1,
            "files": file_map,
            "author": (detail.get("author") or {}).get("login") or (info.get("author") or {}).get("name"),
            "message": info.get("message"),
            "date": (info.get("committer") or {}).get("date"),
        }

    def _post_review_hunks(self, pr_id, commits, sha_index, bot_reviews, cdiffs, finding_rows, tracks,
                           first_idx, review_uid, compare_steps):
        """One candidate per hunk of each non-merge commit after a bot-reviewed head, plus the
        hunks of compare/{reviewed}...{final_head} for reviews on force-pushed heads."""
        by_id = {f["id"]: f for f in finding_rows}
        steps = []  # (step_sha, source, diff, latest bot review, prior finding ids)
        if first_idx is not None:
            reviewed = [(sha_index[r["commit_id"]], r.get("submitted_at") or "", r) for r in bot_reviews
                        if r.get("commit_id") in sha_index]
            for i in range(first_idx + 1, len(commits)):
                sha = commits[i]["sha"]
                diff = cdiffs.get(sha)
                if not diff or diff.get("is_merge") or diff.get("files") is None:
                    continue
                latest = max((t for t in reviewed if t[0] < i), key=lambda t: (t[0], t[1]))[2]
                prior = [fid for fid, t in tracks.items() if t["method"] == "commit-walk" and t["hidx"] < i]
                steps.append((sha, "commit", diff, latest, prior))
        vanished = {}
        for review in bot_reviews:  # latest review per force-pushed head
            if review.get("commit_id") and review["commit_id"] not in sha_index:
                vanished[review["commit_id"]] = review
        for head, review in vanished.items():
            cmp = compare_steps(head)
            if not cmp:
                continue
            diff = {"files": cmp["step"]["files"], "author": None, "message": None, "date": cmp["event_at"]}
            prior = [fid for fid, t in tracks.items() if t["head"] == head]
            steps.append((cmp["step"]["sha"], "compare", diff, review, prior))
        out = []
        for sha, source, diff, latest, prior in steps:
            for path, entry in sorted(diff["files"].items()):
                names = {path} | ({entry["previous_filename"]} if entry.get("previous_filename") else set())
                file_has_finding = any(
                    by_id[fid].get("path") in names
                    or (tracks[fid]["track"]["positions"].get(sha) or (None,))[0] in names
                    for fid in prior
                )
                hunks = parse_patch(entry.get("patch")) if entry.get("patch") is not None else None
                base = {
                    "kind": "post_review_hunk",
                    "source": source,
                    "reviewed_head_sha": latest.get("commit_id"),
                    "bot_review_id": review_uid(latest),
                    "last_bot_event_before": review_verdict(latest.get("body"), latest.get("state")),
                    "commit_sha": sha,
                    "commit_author": diff.get("author"),
                    "commit_message": diff.get("message"),
                    "commit_date": diff.get("date"),
                    "anchor_at": latest.get("submitted_at"),
                    "event_at": diff.get("date"),
                    "path": path,
                    "file_type": file_type(path),
                    "file_status": entry.get("status"),
                    "file_has_bot_finding": file_has_finding,
                }
                if hunks is None:
                    self.keep_candidate(out, {
                        **base, "id": hunk_candidate_id(pr_id, sha, path, None), "patch_missing": True,
                        "hunk": None, "hunk_header": None, "old_start": None, "old_count": None, "new_start": None,
                        "new_count": None, "distance_to_nearest_bot_finding": None, "nearest_bot_finding_id": None})
                    continue
                for hunk in hunks:
                    lo, hi = hunk.old_span()
                    best = None
                    for fid in prior:
                        position = tracks[fid]["track"]["positions"].get(sha)
                        if not position or position[0] not in names:
                            continue
                        d = interval_distance(lo, hi, position[1], position[2])
                        if best is None or d < best[0]:
                            best = (d, fid)
                    self.keep_candidate(out, {
                        **base, "id": hunk_candidate_id(pr_id, sha, path, hunk), "patch_missing": False,
                        "hunk": hunk.text, "hunk_header": hunk.header, "old_start": hunk.old_start,
                        "old_count": hunk.old_count, "new_start": hunk.new_start, "new_count": hunk.new_count,
                        "distance_to_nearest_bot_finding": best[0] if best else None,
                        "nearest_bot_finding_id": best[1] if best else None})
        return out

    @staticmethod
    def _head_at(commits, commit_dates, stamp):
        """Last PR commit whose committer date is <= stamp (push times are not visible)."""
        head = None
        for commit, date in zip(commits, commit_dates):
            when = parse_time(date)
            if when is not None and stamp is not None and when <= stamp:
                head = commit["sha"]
        return head

    def _human_comments(self, pr_id, reviews, review_comments, issue_comments, bot_reviews, root_to_finding,
                        review_uid, human_signals, commits, commit_dates):
        bot_times = [(parse_time(r.get("submitted_at")), r) for r in bot_reviews if r.get("submitted_at")]
        items = []
        for review in reviews:
            if (review.get("body") or "").strip() and review.get("state") != "PENDING":
                items.append(("review", review, review.get("submitted_at"), None, None, None, review.get("commit_id")))
        for comment in review_comments:
            items.append(("review_comment", comment, comment.get("created_at"), comment.get("path"),
                          comment.get("original_line") or comment.get("line"), comment.get("in_reply_to_id"),
                          comment.get("original_commit_id")))
        for comment in issue_comments:
            items.append(("issue_comment", comment, comment.get("created_at"), None, None, None, None))
        out = []
        for source, obj, when, path, line, reply_to, head in sorted(items, key=lambda t: (t[2] or "", t[1]["id"])):
            login = login_of(obj)
            if login == IMPLEMENTER_BOT:
                kind = "implementer_bot"
            elif is_bot_login(login, (obj.get("user") or {}).get("type")) or not login:
                continue
            else:
                kind = "human"
            stamp = parse_time(when)
            before = [(t, r) for t, r in bot_times if stamp is not None and t <= stamp]
            last = before[-1] if before else None
            head_at = head or self._head_at(commits, commit_dates, stamp)
            blind = not before  # no bot review had been submitted when the human commented
            cand = {
                "id": comment_candidate_id(pr_id, source, obj["id"]),
                "kind": "human_comment",
                "commenter_kind": kind,
                "source": source,
                "source_id": obj["id"],
                "author": login,
                "body": obj.get("body"),
                "path": path,
                "line": line,
                "file_type": file_type(path),
                "created_at": when,
                "head_at_comment": head_at,
                "blind_to_bot": blind,
                "in_reply_to_bot_finding": root_to_finding.get(reply_to) if reply_to else None,
                "bot_reviews_before": len(before),
                "after_first_bot_review": bool(before),
                "bot_review_id": review_uid(last[1]) if last else None,
                "seconds_after_last_bot_review": int((stamp - last[0]).total_seconds()) if last else None,
                "anchor_at": last[1].get("submitted_at") if last else None,
                "event_at": when,
                "is_root_inline": False,
            }
            if source == "review_comment" and obj["id"] in human_signals:
                cand.update(human_signals[obj["id"]])
            self.keep_candidate(out, cand)
        return out

    def _post_merge(self, repo, pr_id, number, pr, files, commits, raw_dir):
        if repo not in self.default_branch:
            info = self.gh.rest_obj("repos/%s" % repo)
            self.default_branch[repo] = (info or {}).get("default_branch")
        branch = self.default_branch[repo] or (pr.get("base") or {}).get("ref")
        merged_at = parse_time(pr["merged_at"])
        end = merged_at + self.horizon
        listing = self.gh.rest_list("repos/%s/commits?sha=%s&since=%s&until=%s&per_page=100"
                                    % (repo, branch, fmt_time(merged_at), fmt_time(end))) or []
        pr_shas = {c["sha"] for c in commits} | {pr.get("merge_commit_sha")}
        added = {}
        for entry in files:
            if entry.get("patch") is None:
                added[entry["filename"]] = None
                continue
            lines = set()
            for hunk in parse_patch(entry["patch"]):
                lines.update(hunk.added_new)
            added[entry["filename"]] = lines
        touched_raw, out = [], []
        for item in reversed(listing):  # oldest first
            if item["sha"] in pr_shas or len(item.get("parents") or []) > 1:
                continue
            detail = self.commit(repo, item["sha"])
            if detail is None:
                continue
            relevant = [f for f in detail.get("files") or []
                        if f.get("filename") in added or f.get("previous_filename") in added]
            if not relevant:
                continue
            touched_raw.append(detail)
            info = detail.get("commit") or {}
            message = info.get("message") or ""
            hunks_out, overall, unknown = [], False, False
            for entry in relevant:
                pr_lines = added.get(entry.get("previous_filename") or entry["filename"],
                                     added.get(entry["filename"]))
                if entry.get("patch") is None:
                    unknown = True
                    hunks_out.append({"path": entry["filename"], "hunk": None, "overlaps_pr_lines": None})
                    continue
                for hunk in parse_patch(entry["patch"]):
                    if pr_lines is None:
                        flag = None
                        unknown = True
                    else:
                        lo, hi = hunk.old_span()
                        flag = any(lo <= n <= hi for n in pr_lines)
                        overall = overall or flag
                    hunks_out.append({"path": entry["filename"], "hunk_header": hunk.header, "hunk": hunk.text,
                                      "overlaps_pr_lines": flag})
            date = (info.get("committer") or {}).get("date")
            paths = sorted({f["filename"] for f in relevant})
            self.keep_candidate(out, {
                "id": postmerge_candidate_id(pr_id, item["sha"]),
                "kind": "post_merge_commit",
                "sha": item["sha"],
                "author": (detail.get("author") or {}).get("login") or (info.get("author") or {}).get("name"),
                "message": message,
                "date": date,
                "days_after_merge": round((parse_time(date) - merged_at).total_seconds() / 86400, 2) if date else None,
                "paths": paths,
                "file_types": sorted({file_type(p) for p in paths}),
                "keyword_flags": keyword_flags(message, number),
                "hunks": hunks_out,
                "overlaps_pr_lines": True if overall else (None if unknown else False),
                "overlap_method": "approximate-no-rebase",
                "anchor_at": pr["merged_at"],
                "event_at": date,
            })
        self.raw(raw_dir, "post_merge_commits.json", touched_raw)
        return out

    def _cross_refs(self, pr_id, timeline, bot_reviews, review_uid):
        if not bot_reviews:
            return []
        bot_times = [(parse_time(r.get("submitted_at")), r) for r in bot_reviews if r.get("submitted_at")]
        out = []
        for event in timeline:
            if event.get("event") != "cross-referenced":
                continue
            stamp = parse_time(event.get("created_at"))
            before = [(t, r) for t, r in bot_times if stamp is not None and t <= stamp]
            if not before:
                continue
            last = before[-1][1]
            issue = (event.get("source") or {}).get("issue") or {}
            source_repo = (issue.get("repository") or {}).get("full_name")
            self.keep_candidate(out, {
                "id": xref_candidate_id(pr_id, source_repo, issue.get("number")),
                "kind": "cross_reference",
                "source_repo": source_repo,
                "source_number": issue.get("number"),
                "source_is_pr": bool(issue.get("pull_request")),
                "title": issue.get("title"),
                "state": issue.get("state"),
                "created_at": event.get("created_at"),
                "source_created_at": issue.get("created_at"),
                "html_url": issue.get("html_url"),
                "body_excerpt": (issue.get("body") or "")[:EXCERPT_CHARS],
                "bot_review_id": review_uid(last),
                "anchor_at": last.get("submitted_at"),
                "event_at": event.get("created_at"),
            })
        return out

    def write(self, args):
        os.makedirs(self.out, mode=0o700, exist_ok=True)
        outputs = (("prs.jsonl", self.prs), ("reviews.jsonl", self.reviews), ("findings.jsonl", self.findings),
                   ("candidates.jsonl", self.candidates), ("coverage.jsonl", self.coverage))
        for fname, rows in outputs:
            write_jsonl(os.path.join(self.out, fname), rows)
        manifest = {
            "args": args,
            "collector_version": COLLECTOR_VERSION,
            "generated_at": fmt_time(self.now),
            "counts": {fname: len(rows) for fname, rows in outputs},
            "candidate_kinds": dict(Counter(c["kind"] for c in self.candidates)),
            "evidence": {
                "evidence_days": self.evidence_days,
                "dropped_after_horizon": dict(self.evidence_dropped),
                "horizon_after_run_time": self.evidence_incomplete,
            },
            "heads": dict(self.head_counts),
            "truncation": dict(self.truncation),
            "api_errors": self.gh.errors,
            "skipped_prs": self.skipped,
            "notes": self.notes,
        }
        write_private(os.path.join(self.out, "manifest.json"), json.dumps(manifest, indent=1, sort_keys=True) + "\n")


def cmd_collect(args):
    try:
        since, until = parse_time(args.since), parse_time(args.until)
    except ValueError as exc:
        sys.exit("issue-agent-review-audit: invalid --since/--until: %s" % exc)
    if since >= until:
        sys.exit("issue-agent-review-audit: --since must be before --until")
    if args.evidence_days < 0:
        sys.exit("issue-agent-review-audit: --evidence-days must be >= 0")
    repos = args.repo or list(DEFAULT_REPOS)
    for repo in repos:
        if not REPO_RE.match(repo):
            sys.exit("issue-agent-review-audit: invalid --repo %r" % repo)
    if os.path.lexists(args.out):
        sys.exit("issue-agent-review-audit: --out %s already exists; refusing to overwrite" % args.out)
    os.umask(0o077)
    os.mkdir(args.out, 0o700)
    errors = []
    collector = Collector(Gh(errors), args.out, since, until, args.reviewer, args.evidence_days)
    collector.run(repos)
    collector.write({
        "since": fmt_time(since), "until": fmt_time(until), "repos": repos,
        "reviewer": args.reviewer, "evidence_days": args.evidence_days,
    })
    print("prs=%d reviews=%d findings=%d candidates=%d coverage=%d api_errors=%d -> %s" % (
        len(collector.prs), len(collector.reviews), len(collector.findings), len(collector.candidates),
        len(collector.coverage), len(errors), args.out))


