# syntax=docker/dockerfile:1
# HAPI hub: session store (SQLite + WAL under HAPI_HOME), REST/SSE API, web UI.
# Build context: apps/objects/issue-agent (see .dockerignore). linux/arm64 only.

# debian:trixie-slim (linux/arm64)
FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

# HAPI v0.34.0 (tiann/hapi commit 1f4518df20469c38429cf8ee103ea6320e1087ed).
# Checksum from the release checksums.txt; equals the GitHub asset digest.
ARG HAPI_VERSION=0.34.0
ARG HAPI_SHA256=4bb329b66b856c760e61d311f8bf8d0cb5cbb4c3d23c0870619ed80b599c1006

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && curl -fsSLo /tmp/hapi.tar.gz "https://github.com/tiann/hapi/releases/download/v${HAPI_VERSION}/hapi-linux-arm64.tar.gz" \
    && echo "${HAPI_SHA256}  /tmp/hapi.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/hapi.tar.gz -C /usr/local/bin hapi \
    && chmod 0755 /usr/local/bin/hapi \
    && rm /tmp/hapi.tar.gz \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 hapi \
    && useradd --uid 1000 --gid 1000 --home-dir /var/lib/hapi --no-create-home --shell /usr/sbin/nologin hapi \
    && install -d -o 1000 -g 1000 -m 0700 /var/lib/hapi

# Data directory (settings.json, hapi.db + WAL, JWT secret). Mount a PVC here.
# CLI_API_TOKEN must come from a Secret; without it the hub generates and persists one.
ENV HOME=/var/lib/hapi \
    HAPI_HOME=/var/lib/hapi \
    HAPI_LISTEN_HOST=0.0.0.0 \
    HAPI_LISTEN_PORT=3006

USER 1000:1000
WORKDIR /var/lib/hapi
EXPOSE 3006
# Unauthenticated probe: GET /health
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hapi", "hub", "--no-relay"]
