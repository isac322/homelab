--- /dev/null
+++ b/cli/src/runner/run.worktreeStartCommit.test.ts
@@ -0,0 +1,234 @@
+import { execFileSync } from 'node:child_process'
+import { EventEmitter } from 'node:events'
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { startRunnerControlServer } from './controlServer'
+import type { Machine } from '@/api/types'
+import type * as PersistenceModule from '@/persistence'
+import type * as ControlServerModule from './controlServer'
+import type { RpcHandlerManager } from '@/api/rpc/RpcHandlerManager'
+import type * as ProcessModule from '@/utils/process'
+
+const mocks = vi.hoisted(() => ({ controlServer: vi.fn(), spawn: vi.fn() }))
+vi.mock('./controlServer', () => ({ startRunnerControlServer: mocks.controlServer }))
+vi.mock('./controlClient', () => ({
+    isRunnerRunningCurrentlyInstalledHappyVersion: async () => false,
+    stopRunner: async () => {},
+}))
+vi.mock('@/persistence', async importOriginal => ({
+    ...await importOriginal<typeof PersistenceModule>(),
+    acquireRunnerLock: async () => ({}),
+}))
+vi.mock('@/ui/auth', () => ({ authAndSetupMachineIfNeeded: async () => ({ machineId: 'machine' }) }))
+vi.mock('@/ui/logger', () => ({ logger: { debug: vi.fn(), debugLargeJson: vi.fn(), warn: vi.fn() } }))
+vi.mock('@/ui/doctor', () => ({ getEnvironmentInfo: () => ({}) }))
+vi.mock('@/agent/agentAvailability', () => ({ getAgentAvailability: () => ({ available: true }) }))
+vi.mock('@/utils/spawnHappyCLI', () => ({ spawnHappyCLI: mocks.spawn }))
+vi.mock('@/utils/process', async importOriginal => ({
+    ...await importOriginal<typeof ProcessModule>(),
+    isWindows: () => false,
+    isProcessAlive: () => true,
+    getProcessStartMarker: () => 'test-generation',
+    getProcessThreadGroupId: (pid: number) => pid,
+}))
+
+import { configuration } from '@/configuration'
+import { ApiMachineClient } from '@/api/apiMachine'
+import { startRunner } from './run'
+
+type Handlers = Parameters<typeof startRunnerControlServer>[0]
+
+describe('runner exact worktree start commit', () => {
+    let handlers: Handlers
+    let stateHome: string
+    let root: string
+    let repo: string
+    let originalCommit: string
+    let originalStateFile: string
+    let movedCommit: string
+    let nextPid = 800_000
+    let childHeads: string[]
+    let childDirectories: string[]
+
+    function git(...args: string[]): string {
+        return execFileSync('git', args, { cwd: repo, encoding: 'utf8' }).trim()
+    }
+
+    beforeAll(async () => {
+        stateHome = mkdtempSync(join(tmpdir(), 'hapi-exact-runner-state-'))
+        originalStateFile = configuration.runnerStateFile
+        const captured = new Error('control handlers captured before runner networking')
+        mocks.controlServer.mockImplementation(async value => { handlers = value; throw captured })
+        vi.spyOn(process, 'on').mockReturnValue(process)
+        vi.spyOn(process, 'exit').mockImplementation(() => { throw captured })
+        vi.stubEnv('HAPI_RUNNER_HANDOFF_FROM_PID', '')
+        Object.defineProperty(configuration, 'runnerStateFile', { value: join(stateHome, 'runner.json'), configurable: true })
+        try {
+            await expect(startRunner()).rejects.toBe(captured)
+        } finally {
+            vi.restoreAllMocks()
+            vi.unstubAllEnvs()
+        }
+    })
+
+    beforeEach(() => {
+        root = mkdtempSync(join(tmpdir(), 'hapi-exact-worktree-'))
+        repo = join(root, 'repo')
+        mkdirSync(repo)
+        git('init', '-q')
+        git('config', 'user.name', 'Test')
+        git('config', 'user.email', 'test@example.com')
+        writeFileSync(join(repo, 'file'), 'original\n')
+        git('add', 'file')
+        git('commit', '-qm', 'original')
+        originalCommit = git('rev-parse', 'HEAD')
+        writeFileSync(join(repo, 'file'), 'moved\n')
+        git('commit', '-qam', 'moved base')
+        movedCommit = git('rev-parse', 'HEAD')
+        childHeads = []
+        childDirectories = []
+        mocks.spawn.mockReset()
+        mocks.spawn.mockImplementation((_args, options) => {
+            childDirectories.push(options.cwd)
+            childHeads.push(execFileSync('git', ['rev-parse', 'HEAD'], { cwd: options.cwd, encoding: 'utf8' }).trim())
+            const pid = nextPid++
+            const child = Object.assign(new EventEmitter(), { pid, stderr: null, stdout: null, unref() {} })
+            setImmediate(() => handlers.onHappySessionWebhook(`session-${pid}`, {
+                hostPid: pid, path: options.cwd, startedBy: 'runner',
+            } as never))
+            return child
+        })
+    })
+
+    afterEach(() => rmSync(root, { recursive: true, force: true }))
+    afterAll(() => {
+        Object.defineProperty(configuration, 'runnerStateFile', { value: originalStateFile, configurable: true })
+        rmSync(stateHome, { recursive: true, force: true })
+    })
+
+    it('uses the exact commit before child execution despite a moved, dirty base and keeps suffix collisions', async () => {
+        git('branch', 'hapi-review', movedCommit)
+        writeFileSync(join(repo, 'file'), 'local dirty changes\n')
+        writeFileSync(join(repo, 'untracked'), 'keep me\n')
+        const baseStatus = git('status', '--porcelain=v1')
+        const result = await handlers.spawnSession({
+            directory: repo, agent: 'codex', sessionType: 'worktree',
+            worktreeName: 'review', worktreeStartCommit: originalCommit,
+        })
+        expect(result.type).toBe('success')
+        expect(childHeads).toEqual([originalCommit])
+        expect(childDirectories[0]).toMatch(/review-[0-9a-f]{4}$/)
+        expect(readFileSync(join(childDirectories[0]!, 'file'), 'utf8')).toBe('original\n')
+        expect(git('rev-parse', 'HEAD')).toBe(movedCommit)
+        expect(git('status', '--porcelain=v1')).toBe(baseStatus)
+        expect(readFileSync(join(repo, 'file'), 'utf8')).toBe('local dirty changes\n')
+        expect(readFileSync(join(repo, 'untracked'), 'utf8')).toBe('keep me\n')
+    })
+
+    it('rejects missing and noncommit objects before launching any child', async () => {
+        for (const startCommit of ['0'.repeat(40), git('rev-parse', 'HEAD^{tree}'), git('rev-parse', 'HEAD:file')]) {
+            const result = await handlers.spawnSession({
+                directory: repo, sessionType: 'worktree', worktreeStartCommit: startCommit,
+            })
+            expect(result).toMatchObject({ type: 'error', childStarted: false })
+        }
+        expect(mocks.spawn).not.toHaveBeenCalled()
+        expect(git('worktree', 'list', '--porcelain').match(/^worktree /gm)).toHaveLength(1)
+        expect(git('rev-parse', 'HEAD')).toBe(movedCommit)
+    })
+
+    it('rejects commit selection with omitted/simple mode and malformed hashes before child execution', async () => {
+        for (const sessionType of [undefined, 'simple'] as const) {
+            expect(await handlers.spawnSession({
+                directory: repo, sessionType, worktreeStartCommit: originalCommit,
+            })).toMatchObject({ type: 'error', childStarted: false })
+        }
+        for (const startCommit of ['HEAD', originalCommit.toUpperCase()]) {
+            expect(await handlers.spawnSession({
+                directory: repo, sessionType: 'worktree', worktreeStartCommit: startCommit,
+            })).toMatchObject({ type: 'error', childStarted: false })
+        }
+        expect(mocks.spawn).not.toHaveBeenCalled()
+    })
+
+    it('keeps omitted worktree and simple sessions on the current base commit', async () => {
+        expect((await handlers.spawnSession({ directory: repo, sessionType: 'worktree' })).type).toBe('success')
+        expect((await handlers.spawnSession({ directory: repo })).type).toBe('success')
+        expect(childHeads).toEqual([movedCommit, movedCommit])
+        expect(childDirectories[0]).not.toBe(repo)
+        expect(childDirectories[1]).toBe(repo)
+    })
+
+    it('uses a HAPI-managed exact worktree for Cursor without a second native worktree', async () => {
+        expect((await handlers.spawnSession({
+            directory: repo, agent: 'cursor', sessionType: 'worktree', worktreeStartCommit: originalCommit,
+        })).type).toBe('success')
+        expect(childHeads).toEqual([originalCommit])
+        expect(mocks.spawn.mock.calls[0]?.[0]).not.toContain('--cursor-worktree')
+    })
+
+    it('carries the commit through the real machine RPC handler into runner creation', async () => {
+        const machine: Machine = {
+            id: 'machine', namespace: 'default', seq: 1, createdAt: 0, updatedAt: 0,
+            active: true, activeAt: 0, metadata: null, metadataVersion: 0,
+            runnerState: null, runnerStateVersion: 0,
+        }
+        const client = new ApiMachineClient('test-token', machine)
+        client.setRPCHandlers({ spawnSession: handlers.spawnSession, stopSession: handlers.stopSession, requestShutdown() {} })
+        // Test seam: dispatch through the same private manager the socket uses.
+        const clientWithManager = client as unknown as { rpcHandlerManager: RpcHandlerManager }
+        const manager = clientWithManager.rpcHandlerManager
+        try {
+            const result = JSON.parse(await manager.handleRequest({
+                method: 'machine:spawn-happy-session',
+                params: JSON.stringify({ directory: repo, sessionType: 'worktree', worktreeStartCommit: originalCommit }),
+            }))
+            expect(result.type).toBe('success')
+            expect(childHeads).toEqual([originalCommit])
+            const rejected = JSON.parse(await manager.handleRequest({
+                method: 'machine:spawn-happy-session',
+                params: JSON.stringify({ directory: repo, sessionType: 'worktree', worktreeStartCommit: '0'.repeat(40) }),
+            }))
+            expect(rejected).toMatchObject({ type: 'error', childStarted: false })
+            expect(mocks.spawn).toHaveBeenCalledTimes(1)
+        } finally {
+            client.shutdown()
+        }
+    })
+
+    it('carries the commit through the real control HTTP schema and handler', async () => {
+        const { startRunnerControlServer: startControlServer } = await vi.importActual<typeof ControlServerModule>('./controlServer')
+        const server = await startControlServer(handlers)
+        try {
+            const response = await fetch(`http://127.0.0.1:${server.port}/spawn-session`, {
+                method: 'POST', headers: { 'content-type': 'application/json' },
+                body: JSON.stringify({ directory: repo, sessionType: 'worktree', worktreeStartCommit: originalCommit }),
+            })
+            expect(response.status).toBe(200)
+            expect(await response.json()).toMatchObject({ success: true })
+            expect(childHeads).toEqual([originalCommit])
+            const invalid = await fetch(`http://127.0.0.1:${server.port}/spawn-session`, {
+                method: 'POST', headers: { 'content-type': 'application/json' },
+                body: JSON.stringify({ directory: repo, sessionType: 'simple', worktreeStartCommit: originalCommit }),
+            })
+            expect(invalid.status).toBe(400)
+            expect(mocks.spawn).toHaveBeenCalledTimes(1)
+        } finally {
+            await server.stop()
+        }
+    })
+
+    it('rejects and removes a worktree whose post-checkout hook changed HEAD before child execution', async () => {
+        writeFileSync(join(repo, '.git', 'hooks', 'post-checkout'),
+            `#!/bin/sh\ngit reset --hard ${movedCommit} >/dev/null\n`, { mode: 0o755 })
+        const result = await handlers.spawnSession({
+            directory: repo, sessionType: 'worktree', worktreeStartCommit: originalCommit,
+        })
+        expect(result).toMatchObject({ type: 'error', childStarted: false })
+        expect(mocks.spawn).not.toHaveBeenCalled()
+        expect(git('worktree', 'list', '--porcelain').match(/^worktree /gm)).toHaveLength(1)
+        expect(git('rev-parse', 'HEAD')).toBe(movedCommit)
+    })
+})
