--- /dev/null
+++ b/cli/src/persistence.runnerLock.test.ts
@@ -0,0 +1,57 @@
+import { afterAll, afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { readFileSync, writeFileSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+
+const state = vi.hoisted(() => {
+    const fs = require('node:fs') as typeof import('node:fs')
+    const os = require('node:os') as typeof import('node:os')
+    const path = require('node:path') as typeof import('node:path')
+    return { home: fs.mkdtempSync(path.join(os.tmpdir(), 'hapi-runner-lock-')), namespace: 'boot:100', alive: true, marker: 'current' as string | null }
+})
+vi.mock('@/configuration', () => ({ configuration: {
+    happyHomeDir: state.home,
+    runnerLockFile: join(state.home, 'runner.state.json.lock')
+} }))
+vi.mock('@/utils/process', () => ({
+    isProcessAlive: () => state.alive,
+    getProcessStartMarker: () => state.marker,
+    getPidNamespaceGeneration: () => state.namespace
+}))
+
+import { acquireRunnerLock, releaseRunnerLock } from './persistence'
+const lockPath = join(state.home, 'runner.state.json.lock')
+const foreignPid = process.pid + 100
+beforeEach(() => { state.namespace = 'boot:100'; state.alive = true; state.marker = 'current' })
+afterEach(() => rmSync(lockPath, { force: true }))
+afterAll(() => rmSync(state.home, { recursive: true, force: true }))
+
+describe('runner lock PID generation recovery', () => {
+    it.each([
+        { name: 'reused own PID', pid: process.pid, marker: 'current', namespaceGeneration: 'boot:100' },
+        { name: 'previous container', pid: foreignPid, marker: 'current', namespaceGeneration: 'boot:old' },
+        { name: 'reused foreign PID', pid: foreignPid, marker: 'old', namespaceGeneration: 'boot:100' }
+    ])('reclaims a stale lock from $name', async ({ name: _name, ...lock }) => {
+        writeFileSync(lockPath, JSON.stringify(lock))
+        const acquired = await acquireRunnerLock(2, 0)
+        expect(acquired).not.toBeNull()
+        expect(JSON.parse(readFileSync(lockPath, 'utf8'))).toEqual({ pid: process.pid, marker: 'current', namespaceGeneration: 'boot:100' })
+        await releaseRunnerLock(acquired!)
+    })
+
+    it('keeps another live PID when the marker probe is unavailable in the same namespace', async () => {
+        state.marker = null
+        const original = JSON.stringify({ pid: foreignPid, marker: 'recorded', namespaceGeneration: 'boot:100' })
+        writeFileSync(lockPath, original)
+        expect(await acquireRunnerLock(1, 0)).toBeNull()
+        expect(readFileSync(lockPath, 'utf8')).toBe(original)
+    })
+
+    it('reclaims a dead legacy numeric lock while retaining a live one', async () => {
+        writeFileSync(lockPath, String(foreignPid))
+        expect(await acquireRunnerLock(1, 0)).toBeNull()
+        state.alive = false
+        const acquired = await acquireRunnerLock(2, 0)
+        expect(acquired).not.toBeNull()
+        await releaseRunnerLock(acquired!)
+    })
+})
