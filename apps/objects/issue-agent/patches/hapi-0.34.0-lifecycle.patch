+export function getLinuxProcStartTicks(pid: number): number | null {
+  if (process.platform !== 'linux' || !Number.isSafeInteger(pid) || pid <= 0) return null;
+  try {
+    const stat = readFileSync(`/proc/${pid}/stat`, 'utf8');
+    const commEnd = stat.lastIndexOf(')');
+    if (commEnd === -1) return null;
+    const fields = stat.slice(commEnd + 1).trim().split(/\s+/);
+    const startTicks = Number(fields[19]);
+    return Number.isSafeInteger(startTicks) && startTicks >= 0 ? startTicks : null;
+  } catch {
+    return null;
+  }
+}
+
+export function getPidNamespaceGeneration(): string | null {
+  if (process.platform !== 'linux') return null;
+  const bootId = getSystemBootId();
+  const initStartTicks = getLinuxProcStartTicks(1);
+  return bootId !== null && initStartTicks !== null ? `${bootId}:${initStartTicks}` : null;
+}
 
