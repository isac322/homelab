# syntax=docker/dockerfile:1
# HAPI runner + native Codex CLI + the common Issue Agent profile.
# Build context: apps/objects/issue-agent (see .dockerignore). linux/arm64 only.
# No repository checkout, credential, or provider config is baked in; the
# publisher sidecar clones repositories at runtime into the home PVC.

# node:24.21.0-trixie-slim (linux/arm64). Node runs Codex's npm launcher.
FROM node:24.21.0-trixie-slim@sha256:7da5980a342ed134ad56bb16c918f94548cd15cf3b961aa231c286598accb536

# HAPI v0.30.7 (tiann/hapi commit 0239edf38e2da653d662f31039e24ccea04c7837);
# must match the hub image. Checksum = release checksums.txt = asset digest.
ARG HAPI_VERSION=0.30.7
ARG HAPI_SHA256=4c11ed308412e4510289ed5e5875a43f60f7ee5cee9cbfdc0e2d97f55851a193
# @openai/codex 0.159.2 (HAPI shared sessions require >= 0.154.0).
# SHA-256 of the npm tarballs whose sha512 matched the registry `integrity`.
ARG CODEX_VERSION=0.159.2
ARG CODEX_SHA256=cf1e5d7b6e317a4a1d36dbff2ebd9b3cf048ac98d06fcb6682c57248e023cad2
ARG CODEX_LINUX_ARM64_SHA256=1c4756c2f67f1310ffb03234d61d540ad85916cef5383e46e0e7851f1721c142
# GitHub CLI 2.101.0; checksum = release checksums.txt = asset digest.
ARG GH_VERSION=2.101.0
ARG GH_SHA256=b57e8063f18862647c9d22727c32e9da1b963f8bf9db648fe123a6975695640f
# rustup 1.29.1 (versioned archive). Toolchains install lazily into the home PVC.
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
# sccache 0.18.0 (static musl build); checksum = release .sha256 = asset digest.
ARG SCCACHE_VERSION=0.18.0
ARG SCCACHE_SHA256=2b3284d5da3b46a47dc4229e75bb7b88ac4aa99c8d754fb7d2f84997e5a4354a
# Go 1.27.1; checksum from https://go.dev/dl/?mode=json. A go.mod asking for a
# newer toolchain makes go download it into GOPATH (home PVC; GOTOOLCHAIN=auto).
ARG GO_VERSION=1.27.1
ARG GO_SHA256=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git less openssh-client pkg-config procps python3 tini \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLo /tmp/hapi.tar.gz "https://github.com/tiann/hapi/releases/download/v${HAPI_VERSION}/hapi-linux-arm64.tar.gz" \
    && echo "${HAPI_SHA256}  /tmp/hapi.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/hapi.tar.gz -C /usr/local/bin hapi \
    && chmod 0755 /usr/local/bin/hapi \
    && rm /tmp/hapi.tar.gz

# Same layout as `npm install -g`: bin/codex.js resolves the
# @openai/codex-linux-arm64 package from the global node_modules.
RUN curl -fsSLo /tmp/codex.tgz "https://registry.npmjs.org/@openai/codex/-/codex-${CODEX_VERSION}.tgz" \
    && curl -fsSLo /tmp/codex-arm64.tgz "https://registry.npmjs.org/@openai/codex/-/codex-${CODEX_VERSION}-linux-arm64.tgz" \
    && echo "${CODEX_SHA256}  /tmp/codex.tgz" | sha256sum -c - \
    && echo "${CODEX_LINUX_ARM64_SHA256}  /tmp/codex-arm64.tgz" | sha256sum -c - \
    && install -d /usr/local/lib/node_modules/@openai/codex /usr/local/lib/node_modules/@openai/codex-linux-arm64 \
    && tar -xzf /tmp/codex.tgz --strip-components=1 --no-same-owner -C /usr/local/lib/node_modules/@openai/codex \
    && tar -xzf /tmp/codex-arm64.tgz --strip-components=1 --no-same-owner -C /usr/local/lib/node_modules/@openai/codex-linux-arm64 \
    && ln -s ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && rm /tmp/codex.tgz /tmp/codex-arm64.tgz

RUN curl -fsSLo /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.tar.gz" \
    && echo "${GH_SHA256}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tar.gz --strip-components=2 -C /usr/local/bin "gh_${GH_VERSION}_linux_arm64/bin/gh" \
    && rm /tmp/gh.tar.gz

# Codex MCP servers/hook commands: context-mode and CodeGraph, pinned with
# integrity by runner/tools/package-lock.json. Install scripts are skipped;
# better-sqlite3 is compiled against the image's own Node headers (no prebuilt
# download). context-mode's hooks look for it under their own package
# directory and otherwise run `npm install` on every session start, so it is
# linked there, and its per-ABI copy is seeded so nothing tries to rebuild it
# inside the read-only /opt tree at runtime.
COPY runner/tools/package.json runner/tools/package-lock.json /opt/issue-agent/tools/
RUN cd /opt/issue-agent/tools \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm_config_nodedir=/usr/local npm rebuild better-sqlite3 --ignore-scripts=false --build-from-source \
    && release=node_modules/better-sqlite3/build/Release \
    && cp "$release/better_sqlite3.node" "$release/better_sqlite3.abi$(node -p process.versions.modules).node" \
    && rm -rf "$release"/obj* node_modules/better-sqlite3/deps /root/.npm \
    && install -d node_modules/context-mode/node_modules \
    && ln -s ../../better-sqlite3 node_modules/context-mode/node_modules/better-sqlite3 \
    && ln -s /opt/issue-agent/tools/node_modules/context-mode/cli.bundle.mjs /usr/local/bin/context-mode \
    && ln -s /opt/issue-agent/tools/node_modules/@colbymchenry/codegraph/npm-shim.js /usr/local/bin/codegraph \
    && codegraph --version

# Only the rustup proxies live in the image; RUSTUP_HOME/CARGO_HOME are
# redirected to the PVC at runtime so rust-toolchain.toml installs persist.
RUN curl -fsSLo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/aarch64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod 0755 /tmp/rustup-init \
    && RUSTUP_HOME=/tmp/rustup-build CARGO_HOME=/usr/local/cargo /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
    && rm -rf /tmp/rustup-init /tmp/rustup-build

# rustc goes through sccache (RUSTC_WRAPPER below); its cache lives on the home
# PVC so every worktree and session shares compiled dependencies.
RUN curl -fsSLo /tmp/sccache.tgz "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-aarch64-unknown-linux-musl.tar.gz" \
    && echo "${SCCACHE_SHA256}  /tmp/sccache.tgz" | sha256sum -c - \
    && tar -xzf /tmp/sccache.tgz --strip-components=1 --no-same-owner -C /usr/local/bin "sccache-v${SCCACHE_VERSION}-aarch64-unknown-linux-musl/sccache" \
    && chmod 0755 /usr/local/bin/sccache \
    && rm /tmp/sccache.tgz \
    && sccache --version

# Go toolchain. GOPATH (module cache, `go install` tools) and GOCACHE default to
# $HOME, i.e. the home PVC, so every worktree shares them across restarts.
RUN curl -fsSLo /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz" \
    && echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - \
    && tar -xzf /tmp/go.tgz --no-same-owner -C /usr/local \
    && rm /tmp/go.tgz \
    && /usr/local/go/bin/go version

# The base image's `node` account (uid/gid 1000) becomes `agent`.
RUN usermod --login agent --home /home/agent node \
    && groupmod --new-name agent node \
    && install -d -o 1000 -g 1000 -m 0700 /home/agent

# BuildKit's COPY --chmod also sets that mode on auto-created parent
# directories; create them 0755 first so uid 1000 can traverse them.
RUN install -d -m 0755 /etc/issue-agent /opt/issue-agent/bin /opt/issue-agent/profile /opt/issue-agent/sccache-bin /etc/codex/skills /etc/codex/hooks
# cc/gcc/c++/g++ in front of /usr/bin (see PATH) send C/C++ compiles through sccache.
COPY --chmod=0755 runner/sccache-cc /opt/issue-agent/sccache-bin/cc
RUN for name in gcc c++ g++; do ln -s cc "/opt/issue-agent/sccache-bin/$name"; done
COPY --chmod=0644 runner/gitconfig /etc/issue-agent/gitconfig
COPY --chmod=0644 runner/gitignore /etc/issue-agent/gitignore
# Codex system layer: MCP servers (config.toml) and managed, pre-trusted hooks
# (requirements.toml + scripts in its managed_dir).
COPY --chmod=0644 runner/codex/config.toml runner/codex/requirements.toml /etc/codex/
COPY --chmod=0755 runner/codex/hooks/ /etc/codex/hooks/
COPY --chmod=0755 runner/bootstrap.sh /opt/issue-agent/bin/runner-bootstrap
COPY --chmod=0755 runner/healthcheck.sh /opt/issue-agent/bin/runner-healthcheck
COPY --chmod=0755 runner/publisher.py /opt/issue-agent/bin/publisher
# Global instructions are copied into CODEX_HOME by the bootstrap. Skills use
# Codex's ADMIN scope (/etc/codex/skills), so they never live on the PVC.
COPY --chmod=0644 profile/AGENTS.md /opt/issue-agent/profile/AGENTS.md
COPY profile/skills/ /etc/codex/skills/
RUN find /etc/codex/skills -type d -exec chmod 0755 {} + && find /etc/codex/skills -type f -exec chmod 0644 {} +

ENV HOME=/home/agent \
    HAPI_HOME=/home/agent/.hapi \
    CODEX_HOME=/home/agent/.codex \
    ISSUE_AGENT_CHECKOUTS=/home/agent/checkouts \
    ISSUE_AGENT_PROVIDER_DIR=/run/issue-agent/provider \
    GH_CONFIG_DIR=/run/issue-agent/github \
    GIT_CONFIG_SYSTEM=/etc/issue-agent/gitconfig \
    GIT_TERMINAL_PROMPT=0 \
    CODEGRAPH_NO_DOWNLOAD=1 \
    GH_PROMPT_DISABLED=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    RUSTUP_HOME=/home/agent/.rustup \
    CARGO_HOME=/home/agent/.cargo \
    RUSTC_WRAPPER=/usr/local/bin/sccache \
    SCCACHE_DIR=/home/agent/.cache/sccache \
    SCCACHE_CACHE_SIZE=5G \
    CMAKE_C_COMPILER_LAUNCHER=/usr/local/bin/sccache \
    CMAKE_CXX_COMPILER_LAUNCHER=/usr/local/bin/sccache \
    PATH=/home/agent/.cargo/bin:/usr/local/cargo/bin:/home/agent/go/bin:/usr/local/go/bin:/opt/issue-agent/sccache-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HAPI_RUNNER_SUPERVISED=1 \
    HAPI_DISABLE_VERSION_HANDOFF=1

USER 1000:1000
WORKDIR /home/agent
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/issue-agent/bin/runner-bootstrap"]
